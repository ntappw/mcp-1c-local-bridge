
#Область ОписаниеПеременных

Перем ДанныеСеанса;
Перем ИдентификаторСеанса;
Перем КаталогСеанса;
Перем СвойКаталогОбмена;
Перем МоментСердцебиения;
Перем ВыполненоКоманд;
Перем ЗаписиЖурнала;
Перем СтрокиЖурнала;
Перем ОжидающийОтвет;
Перем РазрешитьЗапись;
Перем РазрешитьКодНаКлиенте;
Перем РучнаяВыдача;
Перем Приостановлен;
Перем ОшибкаМоста;
Перем Индексация;
Перем БезопасныйРежимКода;
Перем ПричинаПаузы;
Перем ОбъектКодаАгента;
Перем КлиентТестирования;
Перем АдресКлиентаТестирования;
Перем ПодключениеТеста;
Перем ИдентификаторХранилища;

#КонецОбласти

#Область ОбработчикиСобытийФормы

Процедура ПередОткрытием(Отказ, СтандартнаяОбработка)
	
	ЗаписиЖурнала = Новый Массив;
	ВыполненоКоманд = 0;
	МоментСердцебиения = 0;
	РазрешитьЗапись = Ложь;
	РазрешитьКодНаКлиенте = Ложь;
	ПричинаПаузы = "";
	// В толстом клиенте безопасный режим не устанавливается: код агента выполняется в процессе клиента
	БезопасныйРежимКода = Ложь;
	РучнаяВыдача = Ложь;
	Приостановлен = Ложь;
	ОшибкаМоста = "";
	АдресКлиентаТестирования = "";
	
	// Элементы создаются до каталога сеанса: если форма не откроется, агенту не останется пустого сеанса
	СоздатьЭлементы();
	// В макете формы назначен только ПередОткрытием, остальные обработчики назначаются кодом
	ЭтаФорма.УстановитьДействие("ПриЗакрытии", Новый Действие("ЗакрытиеФормы"));
	
	ДанныеСеанса = СведенияСеанса();
	СвойКаталогОбмена = СохраненныйКаталогОбмена();
	Попытка
		ПодготовитьКаталогСеанса();
		ЗаписатьСведенияСеанса();
	Исключение
		ОшибкаМоста = "Каталог обмена недоступен: " + ИнформацияОбОшибке().Описание;
	КонецПопытки;
	
	ОбновитьЭлементы();
	Если Не ЗначениеЗаполнено(ОшибкаМоста) Тогда
		ЗапланироватьОпрос();
	КонецЕсли;
	
КонецПроцедуры

// Обработчик закрытия формы: останавливает опрос и удаляет каталог сеанса моста.
//
Процедура ЗакрытиеФормы() Экспорт
	
	Попытка
		ЭтаФорма.ОтключитьОбработчикОжидания("ОбработатьОчередь");
	Исключение
		// Обработчик мог быть уже снят платформой
	КонецПопытки;
	
	// Клиент тестирования остаётся открытым: рвётся только соединение менеджера с ним
	ОтключитьКлиентТестирования();
	УдалитьКаталогСеанса(КаталогСеанса);
	
КонецПроцедуры

// Обработчик ожидания: выполняет команды агента или очередную порцию индекса метаданных
// и обновляет сердцебиение сеанса.
//
Процедура ОбработатьОчередь() Экспорт
	
	// Следующий опрос планируется сразу: исключение в этом опросе не остановит мост
	ЗапланироватьОпрос();
	Если Не Приостановлен И ОжидающийОтвет = Неопределено Тогда
		Попытка
			// Пока строится индекс метаданных, каждый опрос описывает его очередную порцию, а команды ждут.
			// Так же, по попытке за опрос, идёт подключение к запускаемому клиенту тестирования
			Если Индексация <> Неопределено Тогда
				ПродолжитьИндексацию();
			ИначеЕсли ПодключениеТеста <> Неопределено Тогда
				ПродолжитьПодключениеТеста();
			Иначе
				ВыполнитьВходящиеКоманды();
			КонецЕсли;
		Исключение
			ПоказатьОшибкуМоста("Ошибка опроса: " + ИнформацияОбОшибке().Описание);
		КонецПопытки;
	КонецЕсли;
	Если ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментСердцебиения >= 2000 Тогда
		ОбновитьСердцебиение();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

// Выполняет действие нажатой кнопки: пауза, каталог обмена, копирование идентификатора сеанса, очистка журнала,
// решение по результату команды.
//
// Параметры:
//  Элемент - Кнопка - нажатая кнопка формы.
//
Процедура НажатиеКнопки(Элемент) Экспорт
	
	ИмяКнопки = Элемент.Имя;
	Если ИмяКнопки = "КнопкаПауза" Тогда
		Приостановлен = Не Приостановлен;
		ПричинаПаузы = "";
	ИначеЕсли ИмяКнопки = "КнопкаКаталогСеанса" И ЗначениеЗаполнено(КаталогСеанса) Тогда
		ЗапуститьПриложение(КаталогСеанса);
	ИначеЕсли ИмяКнопки = "КнопкаИзменитьКаталог" Тогда
		ВыбратьКаталогОбмена();
	ИначеЕсли ИмяКнопки = "КнопкаКаталогПоУмолчанию" Тогда
		СменитьКаталогОбмена("");
	ИначеЕсли ИмяКнопки = "КнопкаКопироватьСеанс" Тогда
		СкопироватьИдентификаторСеанса();
	ИначеЕсли ИмяКнопки = "КнопкаОчистить" Тогда
		ЗаписиЖурнала.Очистить();
		СтрокиЖурнала.Очистить();
		ЭлементыФормы.Подробности.УстановитьТекст("");
	ИначеЕсли ИмяКнопки = "КнопкаОтдать" Тогда
		ЗавершитьОжидание(Истина);
	ИначеЕсли ИмяКнопки = "КнопкаОтказать" Тогда
		ЗавершитьОжидание(Ложь);
	КонецЕсли;
	ОбновитьСердцебиение();
	ОбновитьЭлементы();
	
КонецПроцедуры

// Применяет флажок выдачи результатов с подтверждением или разрешения агенту.
//
// Параметры:
//  Элемент - Флажок - изменённый флажок формы.
//
Процедура ИзменениеФлажка(Элемент) Экспорт
	
	ИмяФлажка = Элемент.Имя;
	Включен = Элемент.Значение = Истина;
	Если ИмяФлажка = "ФлагСПодтверждением" Тогда
		РучнаяВыдача = Включен;
	ИначеЕсли ИмяФлажка = "ФлагЗапись" Тогда
		РазрешитьЗапись = Включен;
	ИначеЕсли ИмяФлажка = "ФлагКодНаКлиенте" Тогда
		РазрешитьКодНаКлиенте = Включен;
	КонецЕсли;
	ОбновитьСердцебиение();
	ОбновитьЭлементы();
	
КонецПроцедуры

// Показывает подробности команды, выбранной в журнале.
//
// Параметры:
//  Элемент - ТабличноеПоле - журнал команд.
//
Процедура АктивизацияСтрокиЖурнала(Элемент) Экспорт
	
	ПоказатьПодробности(Элемент.ТекущаяСтрока);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЭлементыФормы

Процедура СоздатьЭлементы()
	
	// Координаты - от левого верхнего угла формы, поля по 8 пикселей, как у основной панели в макете
	Слева = 8;
	ШиринаОбласти = ЭтаФорма.Ширина - 16;
	
	НадписьСостояния = ДобавитьНадпись("НадписьСостояние", Слева, 8, ШиринаОбласти);
	НадписьСостояния.Шрифт = Новый Шрифт(,, Истина);
	ДобавитьНадпись("НадписьСведения", Слева, 29, ШиринаОбласти);
	
	ДобавитьКнопку("КнопкаПауза", "Приостановить", Слева, 54, 110);
	ДобавитьКнопку("КнопкаКаталогСеанса", "Каталог сеанса", Слева + 116, 54, 120);
	ДобавитьКнопку("КнопкаИзменитьКаталог", "Изменить каталог обмена...", Слева + 242, 54, 180);
	ДобавитьКнопку("КнопкаКаталогПоУмолчанию", "Каталог по умолчанию", Слева + 428, 54, 150);
	ДобавитьКнопку("КнопкаОчистить", "Очистить журнал", Слева + 584, 54, 130);
	ДобавитьКнопку("КнопкаКопироватьСеанс", "Копировать идентификатор", Слева + 720, 54, 160);
	ЭлементыФормы.КнопкаКопироватьСеанс.Подсказка = "Скопировать идентификатор сеанса моста в буфер обмена";
	
	ДобавитьФлажок("ФлагСПодтверждением", "Выдача результатов с подтверждением", Слева, 84, 250);
	ДобавитьФлажок("ФлагЗапись", "Запись в базу", Слева + 256, 84, 130);
	ДобавитьФлажок("ФлагКодНаКлиенте", "Выполнение кода агентом", Слева + 392, 84, 200);
	ДобавитьНадпись("НадписьРазрешения", Слева, 106, ШиринаОбласти, "Запись в базу: без неё код агента " +
		"откатывается.   Выполнение кода агентом: без него - только запросы и метаданные, с ним агент действует " +
		"с вашими правами.");
	ДобавитьНадпись("НадписьКаталог", Слева, 127, ШиринаОбласти);
	
	ДобавитьНадпись("НадписьРешение", Слева, 154, ШиринаОбласти);
	ПолеКомментария = НовыйЭлемент("ПолеВвода", "Комментарий", Слева, 175, ШиринаОбласти - 156, 46);
	ПолеКомментария.ТипЗначения = Новый ОписаниеТипов("Строка");
	ПолеКомментария.МногострочныйРежим = Истина;
	ДобавитьКнопку("КнопкаОтдать", "Отдать агенту", Слева + ШиринаОбласти - 150, 175, 150);
	ДобавитьКнопку("КнопкаОтказать", "Не отдавать", Слева + ШиринаОбласти - 150, 199, 150);
	
	СтрокиЖурнала = Новый ТаблицаЗначений;
	СтрокиЖурнала.Колонки.Добавить("Время",, "Время", 8);
	СтрокиЖурнала.Колонки.Добавить("Команда",, "Команда", 12);
	СтрокиЖурнала.Колонки.Добавить("Текст",, "Текст", 40);
	СтрокиЖурнала.Колонки.Добавить("Итог",, "Итог", 18);
	СтрокиЖурнала.Колонки.Добавить("Результат",, "Результат", 28);
	СтрокиЖурнала.Колонки.Добавить("Мс",, "мс", 7);
	СтрокиЖурнала.Колонки.Добавить("Идентификатор");
	ДобавитьНадпись("НадписьЖурнал", Слева, 229, ШиринаОбласти);
	Журнал = НовыйЭлемент("ТабличноеПоле", "Журнал", Слева, 250, ШиринаОбласти, 179);
	Журнал.ТипЗначения = Новый ОписаниеТипов("ТаблицаЗначений");
	Журнал.Значение = СтрокиЖурнала;
	Журнал.СоздатьКолонки();
	Журнал.Колонки.Найти("Идентификатор").Видимость = Ложь;
	Журнал.ТолькоПросмотр = Истина;
	Журнал.УстановитьДействие("ПриАктивизацииСтроки", Новый Действие("АктивизацияСтрокиЖурнала"));
	
	Подробности = НовыйЭлемент("ПолеТекстовогоДокумента", "Подробности", Слева, 435, ШиринаОбласти,
		ЭтаФорма.Высота - 443);
	Подробности.ТолькоПросмотр = Истина;
	
	ПривязатьКГраницамФормы();
	
КонецПроцедуры

Функция НовыйЭлемент(ВидЭлемента, ИмяЭлемента, Слева, Сверху, ШиринаЭлемента, ВысотаЭлемента)
	
	Элемент = ЭлементыФормы.Добавить(Тип(ВидЭлемента), ИмяЭлемента, Истина);
	Элемент.Лево = Слева;
	Элемент.Верх = Сверху;
	Элемент.Ширина = ШиринаЭлемента;
	Элемент.Высота = ВысотаЭлемента;
	Возврат Элемент;
	
КонецФункции

Функция ДобавитьНадпись(ИмяНадписи, Слева, Сверху, ШиринаНадписи, ТекстНадписи = "")
	
	Надпись = НовыйЭлемент("Надпись", ИмяНадписи, Слева, Сверху, ШиринаНадписи, 19);
	Надпись.Заголовок = ТекстНадписи;
	Возврат Надпись;
	
КонецФункции

Процедура ДобавитьКнопку(ИмяКнопки, ТекстКнопки, Слева, Сверху, ШиринаКнопки)
	
	Кнопка = НовыйЭлемент("Кнопка", ИмяКнопки, Слева, Сверху, ШиринаКнопки, 22);
	Кнопка.Заголовок = ТекстКнопки;
	Кнопка.УстановитьДействие("Нажатие", Новый Действие("НажатиеКнопки"));
	
КонецПроцедуры

Процедура ДобавитьФлажок(ИмяФлажка, ТекстФлажка, Слева, Сверху, ШиринаФлажка)
	
	Флажок = НовыйЭлемент("Флажок", ИмяФлажка, Слева, Сверху, ШиринаФлажка, 19);
	Флажок.ТипЗначения = Новый ОписаниеТипов("Булево");
	Флажок.Заголовок = ТекстФлажка;
	Флажок.УстановитьДействие("ПриИзменении", Новый Действие("ИзменениеФлажка"));
	
КонецПроцедуры

Процедура ПривязатьКГраницамФормы()
	
	// Надписи, журнал и подробности растягиваются вместе с окном, кнопки решения держатся правого края
	Попытка
		ПанельФормы = ЭтаФорма.Панель;
		ПравыйКрай = ГраницаЭлементаУправления.Право;
		Растягиваемые = "НадписьСостояние,НадписьСведения,НадписьРазрешения,НадписьКаталог,НадписьРешение," +
			"Комментарий,НадписьЖурнал,Журнал,Подробности";
		Для Каждого ИмяЭлемента Из ЧастиСтроки(Растягиваемые, ",") Цикл
			ЭлементыФормы.Найти(ИмяЭлемента).УстановитьПривязку(ПравыйКрай, ПанельФормы, ПравыйКрай);
		КонецЦикла;
		Для Каждого ИмяЭлемента Из ЧастиСтроки("КнопкаОтдать,КнопкаОтказать", ",") Цикл
			Кнопка = ЭлементыФормы.Найти(ИмяЭлемента);
			Кнопка.УстановитьПривязку(ГраницаЭлементаУправления.Лево, ПанельФормы, ПравыйКрай);
			Кнопка.УстановитьПривязку(ПравыйКрай, ПанельФормы, ПравыйКрай);
		КонецЦикла;
		ЭлементыФормы.Подробности.УстановитьПривязку(ГраницаЭлементаУправления.Низ, ПанельФормы,
			ГраницаЭлементаУправления.Низ);
	Исключение
		// Без привязок элементы не растягиваются вместе с окном, но мост работает
	КонецПопытки;
	
КонецПроцедуры

Процедура ОбновитьЭлементы()
	
	ЖдётРешения = ОжидающийОтвет <> Неопределено;
	ЭлементыФормы.НадписьСостояние.Заголовок = ТекстСостояния();
	ЭлементыФормы.НадписьСостояние.ЦветТекста = ЦветСостояния();
	ЭлементыФормы.НадписьСведения.Заголовок = ТекстСведений();
	ЭлементыФормы.НадписьЖурнал.Заголовок = "Журнал команд (" + ТекстКоличестваЗаписей() + ")";
	ЭлементыФормы.НадписьКаталог.Заголовок = ТекстКаталога();
	ЭлементыФормы.НадписьРешение.Заголовок = ТекстРешения();
	ЭлементыФормы.КнопкаПауза.Заголовок = ?(Приостановлен, "Продолжить", "Приостановить");
	ЭлементыФормы.КнопкаКаталогПоУмолчанию.Доступность = ЗначениеЗаполнено(СвойКаталогОбмена);
	ЭлементыФормы.ФлагСПодтверждением.Значение = РучнаяВыдача;
	ЭлементыФормы.ФлагЗапись.Значение = РазрешитьЗапись;
	ЭлементыФормы.ФлагКодНаКлиенте.Значение = РазрешитьКодНаКлиенте;
	ЭлементыФормы.Комментарий.Доступность = ЖдётРешения;
	ЭлементыФормы.КнопкаОтдать.Доступность = ЖдётРешения;
	ЭлементыФормы.КнопкаОтказать.Доступность = ЖдётРешения;
	
КонецПроцедуры

Функция ТекстСостояния()
	
	Если ЗначениеЗаполнено(ОшибкаМоста) Тогда
		Возврат "Ошибка: " + ОшибкаМоста;
	ИначеЕсли ОжидающийОтвет <> Неопределено Тогда
		Возврат "Ждёт решения: результат команды ждёт вашего решения - отдать его агенту или нет.";
	ИначеЕсли Приостановлен И ЗначениеЗаполнено(ПричинаПаузы) Тогда
		Возврат "Остановлен, обход запрета записи: " + ПричинаПаузы;
	ИначеЕсли Приостановлен Тогда
		Возврат "Приостановлен: команды агента ждут в очереди, пока вы не продолжите.";
	ИначеЕсли Индексация <> Неопределено Тогда
		Возврат "Индексация: строится индекс метаданных для агента, " + Формат(ПроцентИндексации(), "ЧН=0") +
			"%. Между порциями окно 1С отвечает, команды агента ждут.";
	ИначеЕсли ПодключениеТеста <> Неопределено Тогда
		Возврат "Запуск клиента: запущен клиент тестирования, мост ждёт подключения к нему. Команды агента ждут.";
	КонецЕсли;
	Возврат "Готов: ждёт команд агента.";
	
КонецФункции

Функция ЦветСостояния()
	
	Если ЗначениеЗаполнено(ОшибкаМоста) Или Приостановлен И ЗначениеЗаполнено(ПричинаПаузы) Тогда
		Возврат WebЦвета.Красный;
	ИначеЕсли ОжидающийОтвет <> Неопределено Или Индексация <> Неопределено
		Или ПодключениеТеста <> Неопределено Тогда
		Возврат WebЦвета.ТемноОранжевый;
	КонецЕсли;
	Возврат Новый Цвет;
	
КонецФункции

Функция ТекстСведений()
	
	Возврат ПредставлениеБазы(ДанныеСеанса.infobase) + ", " + ДанныеСеанса.userFullName + ", сеанс моста " +
		Строка(ИдентификаторСеанса) + ", выполнено команд: " + Формат(ВыполненоКоманд, "ЧН=0; ЧГ=0");
	
КонецФункции

Функция ТекстКоличестваЗаписей()
	
	// Журнал хранит последние 50 команд: если выполнено больше, показываем и общее число
	ТекстКоличества = Формат(ЗаписиЖурнала.Количество(), "ЧН=0; ЧГ=0");
	Если ВыполненоКоманд > ЗаписиЖурнала.Количество() Тогда
		ТекстКоличества = ТекстКоличества + " из " + Формат(ВыполненоКоманд, "ЧН=0; ЧГ=0");
	КонецЕсли;
	Возврат ТекстКоличества;
	
КонецФункции

Функция ТекстКаталога()
	
	ТекстНадписи = "Каталог обмена: " + КаталогОбмена();
	Если ЗначениеЗаполнено(СвойКаталогОбмена) Тогда
		ТекстНадписи = ТекстНадписи + " - не стандартный: агент увидит сеанс, только если MCP-серверу задан " +
			"тот же каталог в MCP_1C_BRIDGE_DIR";
	КонецЕсли;
	Возврат ТекстНадписи;
	
КонецФункции

Функция ТекстРешения()
	
	Если ОжидающийОтвет <> Неопределено Тогда
		Возврат "Результат выделен в журнале. Комментарий агенту - необязательно, уйдёт вместе с решением:";
	ИначеЕсли РучнаяВыдача Тогда
		Возврат "Каждый результат сначала покажется здесь и уйдёт агенту только после вашего решения.";
	КонецЕсли;
	Возврат "Результаты уходят агенту сразу. С подтверждением каждый результат сначала покажется здесь.";
	
КонецФункции

Процедура ПоказатьОшибкуМоста(Текст)
	
	Если ОшибкаМоста <> Текст Тогда
		ОшибкаМоста = Текст;
		ОбновитьЭлементы();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПоказатьНовуюЗапись(Запись)
	
	// Новую строку выделяем, если выделена была самая свежая или никакая: иначе пользователь смотрит другую
	Журнал = ЭлементыФормы.Журнал;
	ВыделитьНовую = ОжидающийОтвет <> Неопределено Или Журнал.ТекущаяСтрока = Неопределено
		Или СтрокиЖурнала.Количество() > 0 И Журнал.ТекущаяСтрока = СтрокиЖурнала[0];
	СтрокаЖурнала = СтрокиЖурнала.Вставить(0);
	ЗаполнитьСтрокуЖурнала(СтрокаЖурнала, Запись);
	Пока СтрокиЖурнала.Количество() > 50 Цикл
		СтрокиЖурнала.Удалить(СтрокиЖурнала.Количество() - 1);
	КонецЦикла;
	Если ВыделитьНовую Тогда
		Журнал.ТекущаяСтрока = СтрокаЖурнала;
		ПоказатьПодробности(СтрокаЖурнала);
	КонецЕсли;
	ОбновитьЭлементы();
	
КонецПроцедуры

Процедура ОбновитьЗаписьЖурнала(Запись)
	
	СтрокаЖурнала = СтрокиЖурнала.Найти(Запись.Идентификатор, "Идентификатор");
	Если СтрокаЖурнала = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьСтрокуЖурнала(СтрокаЖурнала, Запись);
	Если ЭлементыФормы.Журнал.ТекущаяСтрока = СтрокаЖурнала Тогда
		ПоказатьПодробности(СтрокаЖурнала);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСтрокуЖурнала(СтрокаЖурнала, Запись)
	
	СтрокаЖурнала.Идентификатор = Запись.Идентификатор;
	СтрокаЖурнала.Время = Формат(Запись.Время, "ДФ=ЧЧ:мм:сс");
	СтрокаЖурнала.Команда = ПредставлениеВида(Запись);
	СтрокаЖурнала.Текст = Запись.Текст;
	СтрокаЖурнала.Итог = ПредставлениеИтога(Запись);
	СтрокаЖурнала.Результат = Запись.Итог;
	СтрокаЖурнала.Мс = Запись.Длительность;
	
КонецПроцедуры

Процедура ПоказатьПодробности(СтрокаЖурнала)
	
	ТекстПодробностей = "";
	Если СтрокаЖурнала <> Неопределено Тогда
		Для Каждого Запись Из ЗаписиЖурнала Цикл
			Если Запись.Идентификатор = СтрокаЖурнала.Идентификатор Тогда
				ТекстПодробностей = ПодробностиЗаписи(Запись);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	ЭлементыФормы.Подробности.УстановитьТекст(ТекстПодробностей);
	
КонецПроцедуры

Функция ПодробностиЗаписи(Запись)
	
	Части = Новый Массив;
	Части.Добавить(СтрокаПоШаблону("Команда %1, %2, %3, %4 мс, %5", Запись.Идентификатор, ПредставлениеВида(Запись),
		Формат(Запись.Время, "ДФ=ЧЧ:мм:сс"), Формат(Запись.Длительность, "ЧН=0; ЧГ=0"), ПредставлениеИтога(Запись)));
	ДобавитьРаздел(Части, "Комментарий агенту", Запись.Комментарий);
	ДобавитьРаздел(Части, "Текст команды", Запись.ПолныйТекст);
	ДобавитьРаздел(Части, "Параметры", Запись.Параметры);
	ДобавитьРаздел(Части, "Результат", Запись.Результат);
	ДобавитьРаздел(Части, "Сообщения", СоединенныеСтроки(Запись.Сообщения, Символы.ПС));
	ДобавитьРаздел(Части, "Ошибка", Запись.Ошибка);
	Возврат СоединенныеСтроки(Части, Символы.ПС);
	
КонецФункции

Процедура ДобавитьРаздел(Части, ИмяРаздела, ТекстРаздела)
	
	Если ЗначениеЗаполнено(ТекстРаздела) Тогда
		Части.Добавить("");
		Части.Добавить(ИмяРаздела + ":");
		Части.Добавить(ТекстРаздела);
	КонецЕсли;
	
КонецПроцедуры

Функция ПредставлениеИтога(Запись)
	
	Если Запись.Статус = "ok" Тогда
		Итог = "выполнена";
	ИначеЕсли Запись.Статус = "error" Тогда
		Итог = "ошибка";
	ИначеЕсли Запись.Статус = "rejected" Тогда
		Итог = "отказ";
	ИначеЕсли Запись.Статус = "expired" Тогда
		Итог = "просрочена";
	Иначе
		Итог = Запись.Статус;
	КонецЕсли;
	Если Запись.Выдача = "ждёт" Тогда
		Итог = Итог + ", ждёт решения";
	ИначеЕсли Запись.Выдача = "отдано" Или Запись.Выдача = "не отдано" Тогда
		Итог = Итог + ", " + Запись.Выдача;
	КонецЕсли;
	Возврат Итог;
	
КонецФункции

Функция ПредставлениеВида(Запись)
	
	Возврат Запись.Вид + ?(Запись.Клиентская, ", клиент", "");
	
КонецФункции

Функция ПредставлениеБазы(СтрокаСоединения)
	
	Свойства = Новый Соответствие;
	Для Каждого Часть Из ЧастиСтроки(СтрокаСоединения, ";", Ложь) Цикл
		Позиция = Найти(Часть, "=");
		Если Позиция > 0 Тогда
			Свойства.Вставить(НРег(Лев(Часть, Позиция - 1)), СтрЗаменить(Сред(Часть, Позиция + 1), """", ""));
		КонецЕсли;
	КонецЦикла;
	Если Свойства.Получить("ref") <> Неопределено Тогда
		Возврат СтрокаПоШаблону("%1 на %2", Свойства.Получить("ref"), Свойства.Получить("srvr"));
	ИначеЕсли Свойства.Получить("file") <> Неопределено Тогда
		Возврат Свойства.Получить("file");
	КонецЕсли;
	Возврат СтрокаСоединения;
	
КонецФункции

Процедура Предупредить(Текст)
	
	// Модальное предупреждение недоступно, если в конфигурации модальность не используется
	Попытка
		Предупреждение(Текст);
	Исключение
		Сообщить(Текст);
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область Действия

Процедура ЗавершитьОжидание(Разрешено)
	
	Если ОжидающийОтвет = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Ответ = ОжидающийОтвет.Ответ;
	ТекстОтвета = ОжидающийОтвет.ТекстОтвета;
	Комментарий = Лев(СокрЛП(Строка(ЭлементыФормы.Комментарий.Значение)), ПределКомментария());
	Если Не Разрешено Тогда
		ОтветБезДанных = Новый Структура;
		ОтветБезДанных.Вставить("protocol", 1);
		ОтветБезДанных.Вставить("id", Ответ.id);
		ОтветБезДанных.Вставить("status", "denied");
		ОтветБезДанных.Вставить("error", "Пользователь не разрешил выдачу результата агенту.");
		ОтветБезДанных.Вставить("durationMs", Ответ.durationMs);
		ТекстОтвета = ТекстJSON(ОтветБезДанных, Ложь);
	КонецЕсли;
	Если ЗначениеЗаполнено(Комментарий) Тогда
		ТекстОтвета = ТекстОтветаСКомментарием(ТекстОтвета, Комментарий);
	КонецЕсли;
	// Файл индекса метаданных пишется только при выдаче: при отказе агент его не получит
	Если Разрешено Тогда
		ЗаписатьФайлИндекса(ОжидающийОтвет.ТекстИндекса);
	КонецЕсли;
	ОтдатьОтвет(Ответ.id, ТекстОтвета, ОжидающийОтвет.ФайлВРаботе);
	Запись = ОжидающийОтвет.Запись;
	Запись.Выдача = ?(Разрешено, "отдано", "не отдано");
	Запись.Комментарий = Комментарий;
	ОжидающийОтвет = Неопределено;
	ЭлементыФормы.Комментарий.Значение = "";
	ОбновитьЗаписьЖурнала(Запись);
	
КонецПроцедуры

Функция ТекстОтветаСКомментарием(ТекстОтвета, Комментарий)
	
	// Ответ уже записан в JSON: поле дописывается в начало объекта, без повторной записи результата
	Возврат "{""comment"":" + ТекстJSON(Комментарий, Ложь) + "," + Сред(ТекстОтвета, 2);
	
КонецФункции

Процедура СкопироватьИдентификаторСеанса()
	
	Если ПомещенВБуферОбмена(ИдентификаторСеанса) Тогда
		ПоказатьОповещениеПользователя("Идентификатор сеанса моста скопирован",, ИдентификаторСеанса);
	Иначе
		// Буфер обмена недоступен: из окна сообщений идентификатор можно скопировать вручную
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Скопировать в буфер обмена не удалось. Идентификатор сеанса моста: " + ИдентификаторСеанса;
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры

Функция ПомещенВБуферОбмена(Текст)
	
	// Средства буфера обмена есть с платформы 8.3.24, а обработка компилируется и в режимах совместимости 8.3.14
	// и 8.2: обращение к ним - через Вычислить. На платформах старее - объект htmlfile из Windows
	Попытка
		СредстваБуфера = Вычислить("СредстваБуфераОбмена");
		Если СредстваБуфера.ИспользованиеДоступно() Тогда
			ЭлементБуфера = Вычислить("Новый ЭлементБуфераОбмена(СтандартныйФорматДанныхБуфераОбмена.Текст, Текст)");
			СредстваБуфера.ПоместитьДанныеАсинх(ЭлементБуфера);
			Возврат Истина;
		КонецЕсли;
	Исключение
		// Средств буфера обмена нет: платформа старее 8.3.24 или их скрывает режим совместимости
	КонецПопытки;
	Попытка
		ДокументHTML = Новый COMОбъект("htmlfile");
		ДокументHTML.parentWindow.clipboardData.setData("Text", Текст);
		Возврат Истина;
	Исключение
		// COM недоступен: не Windows или запрет политикой
	КонецПопытки;
	Возврат Ложь;
	
КонецФункции

Процедура ВыбратьКаталогОбмена()
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = "Каталог обмена с MCP-сервером";
	Диалог.Каталог = КаталогОбмена();
	// В обычном приложении диалог модальный: пока он открыт, опрос стоит, и MCP видит сеанс молчащим
	Попытка
		Выбран = Диалог.Выбрать();
	Исключение
		Предупредить("Каталог обмена не выбран: " + ИнформацияОбОшибке().Описание);
		Возврат;
	КонецПопытки;
	Если Выбран Тогда
		СменитьКаталогОбмена(Диалог.Каталог);
	КонецЕсли;
	
КонецПроцедуры

Процедура СменитьКаталогОбмена(Каталог)
	
	// Ответ на команду, ждущую решения, пишется в каталог сеанса, где его ждёт MCP
	Если ОжидающийОтвет <> Неопределено Тогда
		Предупредить("Каталог обмена не сменён: сначала решите, отдавать ли агенту результат.");
		Возврат;
	КонецЕсли;
	Если Индексация <> Неопределено Тогда
		Предупредить("Каталог обмена не сменён: дождитесь окончания индексации метаданных.");
		Возврат;
	КонецЕсли;
	Если ПодключениеТеста <> Неопределено Тогда
		Предупредить("Каталог обмена не сменён: дождитесь подключения клиента тестирования.");
		Возврат;
	КонецЕсли;
	
	НовыйСвойКаталог = КаталогДляНастройки(Каталог);
	Если НРег(НовыйСвойКаталог) = НРег(СвойКаталогОбмена) И Не ЗначениеЗаполнено(ОшибкаМоста) Тогда
		Возврат;
	КонецЕсли;
	
	ПрежнийСвойКаталог = СвойКаталогОбмена;
	ПрежнийКаталогСеанса = КаталогСеанса;
	ПрежнийИдентификатор = ИдентификаторСеанса;
	СвойКаталогОбмена = НовыйСвойКаталог;
	Попытка
		ПодготовитьКаталогСеанса();
		ЗаписатьСведенияСеанса();
	Исключение
		Описание = ИнформацияОбОшибке().Описание;
		Если КаталогСеанса <> ПрежнийКаталогСеанса Тогда
			УдалитьКаталогСеанса(КаталогСеанса);
		КонецЕсли;
		СвойКаталогОбмена = ПрежнийСвойКаталог;
		КаталогСеанса = ПрежнийКаталогСеанса;
		ИдентификаторСеанса = ПрежнийИдентификатор;
		ДанныеСеанса.Вставить("session", ИдентификаторСеанса);
		ДанныеСеанса.Вставить("path", КаталогСеанса);
		Предупредить("Каталог обмена не сменён: " + Описание);
		Возврат;
	КонецПопытки;
	
	// Сеанс переехал под новым идентификатором; команды, не начатые в прежнем каталоге, агент пошлёт заново
	УдалитьКаталогСеанса(ПрежнийКаталогСеанса);
	ОшибкаМоста = "";
	// После неудачного открытия формы опрос не запускался, а если он идёт - второй обработчик не нужен
	ЭтаФорма.ОтключитьОбработчикОжидания("ОбработатьОчередь");
	ЗапланироватьОпрос();
	
	Попытка
		СохранитьКаталогОбмена(СвойКаталогОбмена);
	Исключение
		Предупредить("Каталог обмена сменён, но запомнить его не удалось: " + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область Опрос

Процедура ЗапланироватьОпрос()
	
	// Интервал меньше секунды допускается только для однократного обработчика: он подключается на каждом опросе
	ЭтаФорма.ПодключитьОбработчикОжидания("ОбработатьОчередь", 0.5, Истина);
	
КонецПроцедуры

Процедура ВыполнитьВходящиеКоманды()
	
	Файлы = НайтиФайлы(КаталогСеанса + "in", "*.json");
	Если Файлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Идентификаторы команд начинаются с момента создания: порядок имён - порядок поступления
	Имена = Новый СписокЗначений;
	Для Каждого ФайлКоманды Из Файлы Цикл
		Имена.Добавить(ФайлКоманды.Имя);
	КонецЦикла;
	Имена.СортироватьПоЗначению();
	
	Для Каждого ЭлементСписка Из Имена Цикл
		Если ОжидающийОтвет <> Неопределено Или Приостановлен Или Индексация <> Неопределено
			Или ПодключениеТеста <> Неопределено Тогда
			Прервать;
		КонецЕсли;
		ВыполнитьКомандуИзФайла(ЭлементСписка.Значение);
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыполнитьКомандуИзФайла(ИмяФайла)
	
	Разделитель = ПолучитьРазделительПути();
	ИдентификаторКоманды = Лев(ИмяФайла, СтрДлина(ИмяФайла) - СтрДлина(".json"));
	ФайлВРаботе = КаталогСеанса + "work" + Разделитель + ИмяФайла;
	Попытка
		ПереместитьФайл(КаталогСеанса + "in" + Разделитель + ИмяФайла, ФайлВРаботе);
	Исключение
		// Команду успел снять MCP: истёк срок, за который её нужно было начать
		Возврат;
	КонецПопытки;
	
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Команда = Неопределено;
	Попытка
		Команда = ДанныеФайлаJSON(ФайлВРаботе);
		Ответ = ОтветМоста(Команда, ИдентификаторКоманды, ФайлВРаботе);
	Исключение
		Ответ = ОтветОбОшибке(ИнформацияОбОшибке());
	КонецПопытки;
	// Индекс метаданных строится порциями в следующих опросах, клиент тестирования запускается: ответ будет,
	// когда построение или подключение закончится
	Если Ответ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗавершитьКоманду(ИдентификаторКоманды, Команда, Ответ, ФайлВРаботе, Начало);
	
КонецПроцедуры

Процедура ЗавершитьКоманду(ИдентификаторКоманды, Команда, Ответ, ФайлВРаботе, Начало)
	
	// Текст индекса метаданных уходит агенту отдельным файлом, а не в ответе
	ТекстИндекса = "";
	Если Ответ.Свойство("indexText") Тогда
		ТекстИндекса = Ответ.indexText;
		Ответ.Удалить("indexText");
	КонецЕсли;
	Ответ.Вставить("protocol", 1);
	Ответ.Вставить("id", ИдентификаторКоманды);
	Ответ.Вставить("durationMs", ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало);
	ТекстОтвета = ТекстОтветаДляФайла(Ответ);
	
	ВыполненоКоманд = ВыполненоКоманд + 1;
	ОшибкаМоста = "";
	// Команда обошла запрет записи: мост ждёт, пока пользователь не посмотрит её и не продолжит работу сам
	Если Ответ.Свойство("violation") Тогда
		Приостановлен = Истина;
		ПричинаПаузы = "Код агента завершил транзакцию моста, хотя запись в базу выключена: изменения, сделанные им "
			+ "до этого, могли сохраниться. Посмотрите последнюю команду в журнале и решите, продолжать ли работу.";
		ПоказатьОповещениеПользователя("Мост MCP остановлен",, ПричинаПаузы);
		Активизировать();
	КонецЕсли;
	Запись = НоваяЗаписьЖурнала(ИдентификаторКоманды, Команда, Ответ, ТекстОтвета);
	ЗаписиЖурнала.Вставить(0, Запись);
	Пока ЗаписиЖурнала.Количество() > 50 Цикл
		ЗаписиЖурнала.Удалить(ЗаписиЖурнала.ВГраница());
	КонецЦикла;
	
	// В ручном режиме ответ ждёт решения пользователя; не начатую вовремя команду решать нечего
	Если РучнаяВыдача И Ответ.status <> "expired" Тогда
		Запись.Выдача = "ждёт";
		ОжидающийОтвет = Новый Структура;
		ОжидающийОтвет.Вставить("Ответ", Ответ);
		ОжидающийОтвет.Вставить("ТекстОтвета", ТекстОтвета);
		ОжидающийОтвет.Вставить("ТекстИндекса", ТекстИндекса);
		ОжидающийОтвет.Вставить("Запись", Запись);
		ОжидающийОтвет.Вставить("ФайлВРаботе", ФайлВРаботе);
		ЭлементыФормы.Комментарий.Значение = "";
		ОбновитьСердцебиение();
		ПоказатьНовуюЗапись(Запись);
		ПоказатьОповещениеПользователя("Мост MCP: результат ждёт решения",, Запись.Текст);
		Активизировать();
		Возврат;
	КонецЕсли;
	
	ЗаписатьФайлИндекса(ТекстИндекса);
	ОтдатьОтвет(ИдентификаторКоманды, ТекстОтвета, ФайлВРаботе);
	Запись.Выдача = "авто";
	ОбновитьСердцебиение();
	ПоказатьНовуюЗапись(Запись);
	
КонецПроцедуры

Функция ТекстОтветаДляФайла(Ответ)
	
	Попытка
		Возврат ТекстJSON(Ответ, Ложь);
	Исключение
		// Результат не записался в JSON: агент получит ошибку вместо него
		ОтветСОшибкой = ОтветОбОшибке(ИнформацияОбОшибке());
		ОтветСОшибкой.Вставить("protocol", 1);
		ОтветСОшибкой.Вставить("id", Ответ.id);
		ОтветСОшибкой.Вставить("durationMs", Ответ.durationMs);
		Возврат ТекстJSON(ОтветСОшибкой, Ложь);
	КонецПопытки;
	
КонецФункции

Функция ОтветМоста(Команда, ИдентификаторКоманды, ФайлВРаботе)
	
	Если КомандаПросрочена(Команда, ФайлВРаботе) Тогда
		Ответ = Новый Структура;
		Ответ.Вставить("status", "expired");
		Ответ.Вставить("error", "Команда не начата в отведённый срок.");
		Возврат Ответ;
	КонецЕсли;
	
	ОбновитьСердцебиение(ИдентификаторКоманды);
	Вид = Команда.Получить("type");
	// При выдаче с подтверждением код на клиенте не выполняется: у него есть доступ к файлам компьютера, и он мог
	// бы отдать ответ агенту сам, мимо решения пользователя
	// В толстом клиенте к клиентским относится любой код агента: он весь выполняется на этом компьютере
	Клиентская = Вид = "test" Или Вид = "file" Или Вид = "eval" Или Вид = "execute"
		Или Вид = "query" И ЕстьВыраженияАгента(Команда.Получить("params"));
	Если Клиентская И РучнаяВыдача Тогда
		Ответ = Новый Структура;
		Ответ.Вставить("status", "rejected");
		Ответ.Вставить("error", "При выдаче результатов с подтверждением код на клиенте, проверка интерфейса и "
			+ "файлы не выполняются: клиентский код мог бы отдать ответ мимо решения пользователя. Пользователь "
			+ "может переключить выдачу на «Автоматически».");
		Возврат Ответ;
	КонецЕсли;
	// В толстом клиенте любой код агента, в том числе «серверный», выполняется в процессе клиента: безопасного
	// режима здесь нет, файлы и программы компьютера ему доступны. Поэтому весь код - под одним разрешением
	Если Не РазрешитьКодНаКлиенте И (Вид = "eval" Или Вид = "execute"
		Или Вид = "query" И ЕстьВыраженияАгента(Команда.Получить("params"))) Тогда
		Ответ = Новый Структура;
		Ответ.Вставить("status", "rejected");
		Ответ.Вставить("error", "Код агента не разрешён: на форме обработки выключено «Выполнение кода агентом». "
			+ "В толстом клиенте обычного приложения любой код, в том числе выражения _expr в параметрах запроса, "
			+ "выполняется на компьютере пользователя без безопасного режима. Запросы без выражений и метаданные "
			+ "доступны и так.");
		Возврат Ответ;
	КонецЕсли;
	Если Вид = "index" Тогда
		Возврат ОтветИндекса(Команда, ИдентификаторКоманды, ФайлВРаботе);
	КонецЕсли;
	Если Вид = "test" Тогда
		Возврат ОтветТестирования(Команда, ИдентификаторКоманды, ФайлВРаботе);
	КонецЕсли;
	Если Вид = "file" Тогда
		Возврат ОтветОбменаФайлами(Команда, ИдентификаторКоманды);
	КонецЕсли;
	Если Команда.Получить("side") = "client" И (Вид = "eval" Или Вид = "execute") Тогда
		Возврат ОтветКлиентскогоВыполнения(Команда);
	КонецЕсли;
	// В толстом клиенте обычного приложения модуль объекта выполняется здесь же, без вызова сервера
	// Код агента выполняет отдельный экземпляр обработки: через свой объект он достал бы эту форму
	Возврат ОбъектДляКодаАгента().ОтветНаКоманду(Команда, РазрешенияАгента());
	
КонецФункции

Функция КомандаПросрочена(Команда, ФайлВРаботе)
	
	Срок = Команда.Получить("ttlSec");
	Если ТипЗнч(Срок) <> Тип("Число") Или Срок <= 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	// Время изменения ставит Windows при записи файла MCP, перемещение его не меняет
	ФайлКоманды = Новый Файл(ФайлВРаботе);
	Возврат ТекущаяУниверсальнаяДата() - ФайлКоманды.ПолучитьУниверсальноеВремяИзменения() > Срок;
	
КонецФункции

Функция ОтветКлиентскогоВыполнения(Команда)
	
	Ответ = Новый Структура;
	Если Не РазрешитьКодНаКлиенте Тогда
		Ответ.Вставить("status", "rejected");
		Ответ.Вставить("error", "Код агента не разрешён: на форме обработки выключено «Выполнение кода агентом».");
		Возврат Ответ;
	КонецЕсли;
	
	// Код агента выполняется в модуле объекта: элементы этой формы, её разрешения и журнал ему не видны
	Попытка
		Значение = ОбъектДляКодаАгента().ЗначениеКлиентскогоКода(Команда, БезопасныйРежимКода,
			КлиентТестирования);
	Исключение
		Возврат ОтветОбОшибке(ИнформацияОбОшибке());
	КонецПопытки;
	
	Ответ.Вставить("status", "ok");
	Ответ.Вставить("result", ЗначениеДляОтвета(Значение));
	Возврат Ответ;
	
КонецФункции

Функция ОбъектДляКодаАгента()
	
	// В толстом клиенте и «серверный» код агента выполняется в процессе клиента. У объекта этой формы он получил
	// бы саму форму (ПолучитьФорму возвращает открытую), поэтому ему даётся другой экземпляр той же обработки
	Если ОбъектКодаАгента = Неопределено Тогда
		Попытка
			ОбъектКодаАгента = ВнешниеОбработки.Создать(ЭтотОбъект.ИспользуемоеИмяФайла, Ложь);
		Исключение
			// Файл обработки недоступен: код выполнит объект формы, права по-прежнему расширяет только вопрос
			ОбъектКодаАгента = ЭтотОбъект;
		КонецПопытки;
	КонецЕсли;
	Возврат ОбъектКодаАгента;
	
КонецФункции

Функция ЕстьВыраженияАгента(Значение)
	
	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Если Значение.Получить("_expr") <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
		Для Каждого КлючИЗначение Из Значение Цикл
			Если ЕстьВыраженияАгента(КлючИЗначение.Значение) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			Если ЕстьВыраженияАгента(Элемент) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Ложь;
	
КонецФункции

Функция РазрешенияАгента()
	
	Разрешения = Новый Структура;
	Разрешения.Вставить("Запись", РазрешитьЗапись);
	Разрешения.Вставить("БезопасныйРежим", БезопасныйРежимКода);
	Возврат Разрешения;
	
КонецФункции

Функция ЗначениеДляОтвета(Значение)
	
	Попытка
		Возврат ЭтотОбъект.ЗначениеДляJSON(Значение);
	Исключение
		// Значение не удалось разобрать: агент получит тип и представление
	КонецПопытки;
	
	Описание = Новый Структура;
	Описание.Вставить("_type", Строка(ТипЗнч(Значение)));
	Попытка
		Описание.Вставить("_presentation", Строка(Значение));
	Исключение
		Описание.Вставить("_presentation", "");
	КонецПопытки;
	Возврат Описание;
	
КонецФункции

Функция ОтветОбОшибке(Информация)
	
	Ответ = Новый Структура;
	Ответ.Вставить("status", "error");
	Ответ.Вставить("error", Информация.Описание);
	Ответ.Вставить("errorDetails", ПодробноеПредставлениеОшибки(Информация));
	Возврат Ответ;
	
КонецФункции

#КонецОбласти

#Область ИндексМетаданных

Функция ОтветИндекса(Команда, ИдентификаторКоманды, ФайлВРаботе)
	
	Сведения = ЭтотОбъект.СведенияИндекса(Команда.Получить("refresh") = Истина);
	Если ЗначениеЗаполнено(Сведения.Текст) Тогда
		Возврат ОтветСИндексом(Сведения, "saved", "");
	КонецЕсли;
	
	// Построение на большой конфигурации надолго занимает сеанс пользователя: без явного согласия не начинается
	Всего = ОбъектовВКоллекциях(Сведения.Коллекции);
	Если Всего > ПорогИндексаБезСогласия() И Команда.Получить("build") <> Истина Тогда
		Ответ = Новый Структура;
		Ответ.Вставить("status", "rejected");
		Ответ.Вставить("error", СтрокаПоШаблону("Индекс метаданных не построен: в конфигурации %1 объектов, "
			+ "построение займёт несколько минут и всё это время будет нагружать сеанс пользователя. Спросите "
			+ "пользователя и повторите вызов с build=true (нужен MCP-сервер версии 1.6.0 или новее) либо "
			+ "смотрите метаданные точечно инструментом metadata.", Формат(Всего, "ЧН=0; ЧГ=0")));
		Возврат Ответ;
	КонецЕсли;
	
	// Индекс строится порциями в следующих опросах, чтобы окно 1С между ними отвечало: ответа пока нет
	Индексация = Новый Структура;
	Индексация.Вставить("Команда", Команда);
	Индексация.Вставить("Идентификатор", ИдентификаторКоманды);
	Индексация.Вставить("ФайлВРаботе", ФайлВРаботе);
	Индексация.Вставить("Начало", ТекущаяУниверсальнаяДатаВМиллисекундах());
	Индексация.Вставить("Сведения", Сведения);
	Индексация.Вставить("Части", Новый Массив);
	Индексация.Вставить("НомерКоллекции", 0);
	Индексация.Вставить("Позиция", 0);
	Индексация.Вставить("Описано", 0);
	Индексация.Вставить("Всего", ОбъектовВКоллекциях(Сведения.Коллекции));
	Индексация.Вставить("Объектов", 0);
	Индексация.Вставить("Полей", 0);
	ОбновитьЭлементы();
	Возврат Неопределено;
	
КонецФункции

Процедура ПродолжитьИндексацию()
	
	Попытка
		Если Индексация.НомерКоллекции < Индексация.Сведения.Коллекции.Количество() Тогда
			ДобавитьПорциюИндекса();
			ОбновитьСердцебиение();
			ОбновитьЭлементы();
			Возврат;
		КонецЕсли;
		Ответ = ОтветПостроенногоИндекса();
	Исключение
		// Ошибка порции завершает команду ответом с ошибкой: мост не остаётся занятым
		Ответ = ОтветОбОшибке(ИнформацияОбОшибке());
	КонецПопытки;
	
	Завершенная = Индексация;
	Индексация = Неопределено;
	ЗавершитьКоманду(Завершенная.Идентификатор, Завершенная.Команда, Ответ, Завершенная.ФайлВРаботе,
		Завершенная.Начало);
	
КонецПроцедуры

Процедура ДобавитьПорциюИндекса()
	
	Коллекция = Индексация.Сведения.Коллекции[Индексация.НомерКоллекции];
	Порция = ЭтотОбъект.ПорцияИндекса(Коллекция.Имя, Индексация.Позиция, БюджетПорцииМс());
	Индексация.Части.Добавить(Порция.Текст);
	Индексация.Описано = Индексация.Описано + Порция.Описано;
	Индексация.Объектов = Индексация.Объектов + Порция.Объектов;
	Индексация.Полей = Индексация.Полей + Порция.Полей;
	Если Порция.Следующий = 0 Тогда
		Индексация.НомерКоллекции = Индексация.НомерКоллекции + 1;
		Индексация.Позиция = 0;
	Иначе
		Индексация.Позиция = Порция.Следующий;
	КонецЕсли;
	
КонецПроцедуры

Функция ОтветПостроенногоИндекса()
	
	Сведения = Индексация.Сведения;
	Сведения.Построен = ТекущаяУниверсальнаяДата();
	Сведения.Объектов = Индексация.Объектов;
	Сведения.Полей = Индексация.Полей;
	Сведения.Текст = ТекстИндекса(Сведения, Индексация.Части);
	
	Замечание = "";
	Попытка
		ЭтотОбъект.СохранитьИндекс(Сведения);
	Исключение
		// Агент получит индекс и без сохранения, но в следующий раз он будет построен заново
		Замечание = "Индекс не сохранён в настройках пользователя, в следующий раз он будет построен заново: " +
			ИнформацияОбОшибке().Описание;
	КонецПопытки;
	Возврат ОтветСИндексом(Сведения, "built", Замечание);
	
КонецФункции

Функция ТекстИндекса(Сведения, Части)
	
	// Не «Заголовок»: в модуле формы так называется заголовок самой формы
	ЗаголовокИндекса = Сведения.Заголовок;
	ЗаголовокИндекса.Вставить("built", XMLСтрока(Сведения.Построен));
	ЗаголовокИндекса.Вставить("objects", Сведения.Объектов);
	ЗаголовокИндекса.Вставить("fields", Сведения.Полей);
	ТекстЗаголовка = ТекстJSON(ЗаголовокИндекса, Ложь);
	// Порции уже записаны в JSON модулем объекта: массив порций дописывается в конец объекта заголовка
	Возврат Лев(ТекстЗаголовка, СтрДлина(ТекстЗаголовка) - 1) + ",""parts"":[" + СоединенныеСтроки(Части, ",") + "]}";
	
КонецФункции

Функция ОтветСИндексом(Сведения, Источник, Замечание)
	
	Результат = Новый Структура;
	Результат.Вставить("file", ИмяФайлаИндекса());
	Результат.Вставить("source", Источник);
	Результат.Вставить("fingerprint", Сведения.Отпечаток);
	Результат.Вставить("built", XMLСтрока(Сведения.Построен));
	Результат.Вставить("objects", Сведения.Объектов);
	Результат.Вставить("fields", Сведения.Полей);
	
	Ответ = Новый Структура;
	Ответ.Вставить("status", "ok");
	Ответ.Вставить("result", Результат);
	// Текст индекса не входит в ответ: при выдаче агенту он пишется отдельным файлом в каталог сеанса
	Ответ.Вставить("indexText", Сведения.Текст);
	Если ЗначениеЗаполнено(Замечание) Тогда
		Замечания = Новый Массив;
		Замечания.Добавить(Замечание);
		Ответ.Вставить("warnings", Замечания);
	КонецЕсли;
	Возврат Ответ;
	
КонецФункции

Процедура ЗаписатьФайлИндекса(ТекстИндекса)
	
	Если ЗначениеЗаполнено(ТекстИндекса) Тогда
		ЗаписатьТекстовыйФайл(КаталогСеанса + ИмяФайлаИндекса(), ТекстИндекса);
	КонецЕсли;
	
КонецПроцедуры

Функция ИмяФайлаИндекса()
	
	Возврат "index.json";
	
КонецФункции

Функция ПорогИндексаБезСогласия()
	
	// До стольких объектов метаданных индекс строится за минуту-две и согласия пользователя не требует
	Возврат 10000;
	
КонецФункции

Функция БюджетПорцииМс()
	
	// Сколько описываются объекты за один опрос; между порциями окно 1С отвечает пользователю
	Возврат 1000;
	
КонецФункции

Функция ОбъектовВКоллекциях(Коллекции)
	
	Всего = 0;
	Для Каждого Коллекция Из Коллекции Цикл
		Всего = Всего + Коллекция.Количество;
	КонецЦикла;
	Возврат Всего;
	
КонецФункции

Функция ПроцентИндексации()
	
	Если Индексация.Всего = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Цел(Индексация.Описано * 100 / Индексация.Всего);
	
КонецФункции

#КонецОбласти

#Область ТестированиеИнтерфейса

// Общая область двух форм: правится в модуле управляемой формы и переносится в модуль обычной формы
// скриптом scripts/sync_ordinary_form.py. Локальные переменные не называются именами свойств форм.

Функция ОтветТестирования(Команда, ИдентификаторКоманды, ФайлВРаботе)
	
	Ответ = Новый Структура;
	Если Не РазрешитьКодНаКлиенте Тогда
		Ответ.Вставить("status", "rejected");
		Ответ.Вставить("error",
			"Тестирование интерфейса не разрешено: на форме обработки выключен «Код на клиенте».");
		Возврат Ответ;
	КонецЕсли;
	
	Действие = Команда.Получить("action");
	Попытка
		Если Действие = "connect" Тогда
			Данные = ДанныеПодключенияТеста(Команда, ИдентификаторКоманды, ФайлВРаботе);
			// Клиент тестирования запускается: подключение продолжится в следующих опросах
			Если Данные = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
		ИначеЕсли Действие = "close" Тогда
			Данные = ДанныеЗакрытияТеста(Команда);
		ИначеЕсли Действие = "snapshot" Тогда
			Данные = ДанныеСнимкаТеста(Команда);
		ИначеЕсли Действие = "steps" Тогда
			Данные = ДанныеШаговТеста(Команда);
		Иначе
			Ответ.Вставить("status", "rejected");
			Ответ.Вставить("error", СтрокаПоШаблону("Неизвестное действие тестирования: %1", Действие));
			Возврат Ответ;
		КонецЕсли;
	Исключение
		Возврат ОтветОбОшибке(ИнформацияОбОшибке());
	КонецПопытки;
	
	Ответ.Вставить("status", "ok");
	Ответ.Вставить("result", Данные);
	Возврат Ответ;
	
КонецФункции

Функция ТипыТеста()
	
	// Типы механизма автоматизированного тестирования берутся по именам: модуль компилируется и там, где их нет
	Типы = Новый Структура;
	Попытка
		Типы.Вставить("Приложение", Тип("ТестируемоеПриложение"));
		Типы.Вставить("ОкноПриложения", Тип("ТестируемоеОкноКлиентскогоПриложения"));
		Типы.Вставить("Форма", Тип("ТестируемаяФорма"));
		Типы.Вставить("Поле", Тип("ТестируемоеПолеФормы"));
		Типы.Вставить("Кнопка", Тип("ТестируемаяКнопкаФормы"));
		Типы.Вставить("Таблица", Тип("ТестируемаяТаблицаФормы"));
		Типы.Вставить("Группа", Тип("ТестируемаяГруппаФормы"));
		Типы.Вставить("Декорация", Тип("ТестируемаяДекорацияФормы"));
	Исключение
		ВызватьИсключение "В этом клиенте 1С нет механизма автоматизированного тестирования: "
			+ ИнформацияОбОшибке().Описание;
	КонецПопытки;
	Возврат Типы;
	
КонецФункции

Функция ЧислоТеста(Источник, ИмяПоля, ПоУмолчанию)
	
	ЗначениеПоля = Источник.Получить(ИмяПоля);
	Возврат ?(ТипЗнч(ЗначениеПоля) = Тип("Число"), ЗначениеПоля, ПоУмолчанию);
	
КонецФункции

#Область Подключение

Функция ДанныеПодключенияТеста(Команда, ИдентификаторКоманды, ФайлВРаботе)
	
	ИмяКомпьютера = Команда.Получить("host");
	Если Не ЗначениеЗаполнено(ИмяКомпьютера) Тогда
		ИмяКомпьютера = "localhost";
	КонецЕсли;
	Порт = ЧислоТеста(Команда, "port", 48000);
	АдресКлиента = НРег(ИмяКомпьютера) + ":" + Формат(Порт, "ЧГ=0");
	
	Если КлиентТестирования <> Неопределено И АдресКлиентаТестирования = АдресКлиента
		И КлиентТестированияОтвечает() Тогда
		Возврат СведенияПодключенияТеста("already");
	КонецЕсли;
	ОтключитьКлиентТестирования();
	
	Ожидание = Новый Структура;
	Ожидание.Вставить("ИмяКомпьютера", ИмяКомпьютера);
	Ожидание.Вставить("Порт", Порт);
	Ожидание.Вставить("Приложение");
	Ошибка = ОшибкаПодключенияТеста(Ожидание);
	Если Ошибка = "" Тогда
		АдресКлиентаТестирования = АдресКлиента;
		Возврат СведенияПодключенияТеста("connected");
	КонецЕсли;
	Если Команда.Получить("launch") = Ложь Или НРег(ИмяКомпьютера) <> "localhost" Тогда
		ВызватьИсключение СтрокаПоШаблону("Клиент тестирования %1 не отвечает: %2. %3", АдресКлиента, Ошибка,
			ПодсказкаПодключенияТеста());
	КонецЕсли;
	
	Если Ожидание.Приложение <> Неопределено Тогда
		Попытка
			Ожидание.Приложение.РазорватьСоединение();
		Исключение
			// Соединения уже нет
		КонецПопытки;
	КонецЕсли;
	
	// Клиент тестирования - второй сеанс той же базы под тем же пользователем
	КлючиЗапуска = "/TESTCLIENT -TPort " + Формат(Порт, "ЧГ=0");
	Если ЗначениеЗаполнено(Команда.Получить("launchArgs")) Тогда
		КлючиЗапуска = КлючиЗапуска + " " + Команда.Получить("launchArgs");
	КонецЕсли;
	ЗапуститьСистему(КлючиЗапуска);
	
	// Клиент стартует десятки секунд: подключение повторяется в следующих опросах, окно 1С между ними отвечает
	ПодключениеТеста = Новый Структура;
	ПодключениеТеста.Вставить("Команда", Команда);
	ПодключениеТеста.Вставить("Идентификатор", ИдентификаторКоманды);
	ПодключениеТеста.Вставить("ФайлВРаботе", ФайлВРаботе);
	ПодключениеТеста.Вставить("Начало", ТекущаяУниверсальнаяДатаВМиллисекундах());
	ПодключениеТеста.Вставить("Срок",
		ТекущаяУниверсальнаяДатаВМиллисекундах() + ЧислоТеста(Команда, "waitSec", 120) * 1000);
	ПодключениеТеста.Вставить("ИмяКомпьютера", ИмяКомпьютера);
	ПодключениеТеста.Вставить("Порт", Порт);
	ПодключениеТеста.Вставить("АдресКлиента", АдресКлиента);
	// Соединение, установленное до запуска клиента, ведёт в никуда: после запуска оно устанавливается заново
	ПодключениеТеста.Вставить("Приложение");
	Возврат Неопределено;
	
КонецФункции

Процедура ПродолжитьПодключениеТеста()
	
	Ожидаемое = ПодключениеТеста;
	Ошибка = ОшибкаПодключенияТеста(Ожидаемое);
	Если Ошибка <> "" И ТекущаяУниверсальнаяДатаВМиллисекундах() < Ожидаемое.Срок Тогда
		ОбновитьСердцебиение();
		Возврат;
	КонецЕсли;
	
	ПодключениеТеста = Неопределено;
	Ответ = Новый Структура;
	Попытка
		Если Ошибка <> "" Тогда
			ВызватьИсключение СтрокаПоШаблону("Запущенный клиент тестирования %1 не ответил за %2 с: %3. %4",
				Ожидаемое.АдресКлиента, Формат(ЧислоТеста(Ожидаемое.Команда, "waitSec", 120), "ЧГ=0"), Ошибка,
				ПодсказкаПодключенияТеста());
		КонецЕсли;
		АдресКлиентаТестирования = Ожидаемое.АдресКлиента;
		Ответ.Вставить("status", "ok");
		Ответ.Вставить("result", СведенияПодключенияТеста("launched"));
	Исключение
		Ответ = ОтветОбОшибке(ИнформацияОбОшибке());
	КонецПопытки;
	ЗавершитьКоманду(Ожидаемое.Идентификатор, Ожидаемое.Команда, Ответ, Ожидаемое.ФайлВРаботе, Ожидаемое.Начало);
	
КонецПроцедуры

Функция ОшибкаПодключенияТеста(Ожидание)
	
	// Соединение устанавливается один раз и дальше ждёт окон клиента: клиент, от которого менеджер отключился,
	// пока он запускался, новых подключений не принимает («Объект не может быть найден»)
	Попытка
		Если Ожидание.Приложение = Неопределено Тогда
			ПараметрыПодключения = Новый Массив;
			ПараметрыПодключения.Добавить(Ожидание.ИмяКомпьютера);
			ПараметрыПодключения.Добавить(Ожидание.Порт);
			Приложение = Новый(Тип("ТестируемоеПриложение"), ПараметрыПодключения);
			Приложение.УстановитьСоединение();
			Ожидание.Приложение = Приложение;
		КонецЕсли;
		Окон = Ожидание.Приложение.НайтиОбъекты(Тип("ТестируемоеОкноКлиентскогоПриложения")).Количество();
	Исключение
		Ожидание.Приложение = Неопределено;
		Ошибка = ИнформацияОбОшибке().Описание;
		Возврат ?(ПустаяСтрока(Ошибка), "соединение не установлено", Ошибка);
	КонецПопытки;
	// Живой клиент тестирования показывает хотя бы основное окно; соединение без окон бывает и без клиента
	Если Окон = 0 Тогда
		Возврат "клиент тестирования не показал ни одного окна";
	КонецЕсли;
	КлиентТестирования = Ожидание.Приложение;
	Возврат "";
	
КонецФункции

Функция ПодсказкаПодключенияТеста()
	
	Возврат "Сеанс 1С с формой моста должен быть менеджером тестирования (запуск с ключом /TESTMANAGER), "
		+ "а клиент тестирования - запущен с ключами /TESTCLIENT -TPort <порт>. Если клиент запущен, а подключения "
		+ "нет, сеанс менеджера мог запомнить прежний, уже закрытый клиент на этом порту: укажите другой port";
	
КонецФункции

Функция СведенияПодключенияТеста(Способ)
	
	Типы = ТипыТеста();
	Сведения = Новый Структура;
	Сведения.Вставить("connection", Способ);
	Сведения.Вставить("address", АдресКлиентаТестирования);
	Сведения.Вставить("windows", ОписанияОконТеста(КлиентТестирования, Типы));
	Возврат Сведения;
	
КонецФункции

Функция КлиентТестированияОтвечает()
	
	Попытка
		Окон = КлиентТестирования.НайтиОбъекты(Тип("ТестируемоеОкноКлиентскогоПриложения")).Количество();
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Возврат Окон > 0;
	
КонецФункции

Функция ПодключенныйКлиентТестирования()
	
	Если КлиентТестирования = Неопределено Тогда
		ВызватьИсключение "Клиент тестирования не подключён: сначала вызовите test_connect.";
	КонецЕсли;
	Если Не КлиентТестированияОтвечает() Тогда
		Попытка
			КлиентТестирования.УстановитьСоединение();
		Исключение
			ВызватьИсключение "Клиент тестирования не отвечает (закрыт или завис): "
				+ ИнформацияОбОшибке().Описание + ". Подключитесь заново: test_connect.";
		КонецПопытки;
	КонецЕсли;
	Возврат КлиентТестирования;
	
КонецФункции

Процедура ОтключитьКлиентТестирования()
	
	Если КлиентТестирования = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		КлиентТестирования.РазорватьСоединение();
	Исключение
		// Клиент тестирования уже закрыт: соединения нет
	КонецПопытки;
	КлиентТестирования = Неопределено;
	АдресКлиентаТестирования = "";
	
КонецПроцедуры

Функция ДанныеЗакрытияТеста(Команда)
	
	Сведения = Новый Структура;
	Если КлиентТестирования = Неопределено Или Не КлиентТестированияОтвечает() Тогда
		ОтключитьКлиентТестирования();
		Сведения.Вставить("closed", Ложь);
		Сведения.Вставить("note", "Клиент тестирования не был подключён.");
		Возврат Сведения;
	КонецЕсли;
	Если Команда.Получить("exit") = Ложь Тогда
		ОтключитьКлиентТестирования();
		Сведения.Вставить("closed", Ложь);
		Сведения.Вставить("note", "Соединение разорвано, клиент тестирования оставлен открытым.");
		Возврат Сведения;
	КонецЕсли;
	
	Приложение = КлиентТестирования;
	Типы = ТипыТеста();
	// На вопрос о сохранении изменённой формы отвечать вслепую нельзя: такие окна закрывает агент шагами
	Измененные = Новый Массив;
	ОсновноеОкно = Неопределено;
	Для Каждого ОкноКлиента Из Приложение.НайтиОбъекты(Типы.ОкноПриложения) Цикл
		Если ОкноКлиента.Основное Тогда
			ОсновноеОкно = ОкноКлиента;
		КонецЕсли;
		Попытка
			ФормаОкна = ОкноКлиента.НайтиОбъект(Типы.Форма);
			Если ФормаОкна <> Неопределено И ФормаОкна.ТекущаяМодифицированность() Тогда
				Измененные.Добавить(ОкноКлиента.Заголовок);
			КонецЕсли;
		Исключение
			// У окна нет формы или она не отвечает на вопрос об изменении
		КонецПопытки;
	КонецЦикла;
	Если Измененные.Количество() > 0 Тогда
		ВызватьИсключение "Клиент тестирования не закрыт: в окнах есть несохранённые изменения ("
			+ СоединенныеСтроки(Измененные, "; ") + "). Закройте их шагами test_steps и повторите.";
	КонецЕсли;
	Если ОсновноеОкно = Неопределено Тогда
		// У клиента обычного приложения механизм тестирования не видит основного окна: закрыть его нечем
		ОтключитьКлиентТестирования();
		Сведения.Вставить("closed", Ложь);
		Сведения.Вставить("note", "У клиента тестирования нет основного окна, доступного механизму тестирования "
			+ "(так бывает в обычном приложении): соединение разорвано, закройте клиент вручную.");
		Возврат Сведения;
	КонецЕсли;
	
	ОсновноеОкно.Закрыть();
	// Вопрос о завершении работы появляется не сразу
	Закрыт = Ложь;
	Срок = ТекущаяУниверсальнаяДатаВМиллисекундах() + 20000;
	Пока Не Закрыт И ТекущаяУниверсальнаяДатаВМиллисекундах() < Срок Цикл
		Попытка
			// Вопрос - окно MessageBox с заголовком основного окна, «Завершить работу» - Button0
			Для Каждого ОкноКлиента Из Приложение.НайтиОбъекты(Типы.ОкноПриложения) Цикл
				ФормаОкна = ОкноКлиента.НайтиОбъект(Типы.Форма);
				Если Не ОкноКлиента.Основное И ФормаОкна <> Неопределено И ФормаОкна.ИмяФормы = "MessageBox" Тогда
					ОкноКлиента.НайтиОбъект(Типы.Кнопка,, "Button0").Нажать();
					Прервать;
				КонецЕсли;
			КонецЦикла;
		Исключение
			// Клиент мог закрыться между вызовами: проверка ниже
		КонецПопытки;
		Закрыт = Не КлиентТестированияОтвечает();
	КонецЦикла;
	ОтключитьКлиентТестирования();
	Сведения.Вставить("closed", Закрыт);
	Если Не Закрыт Тогда
		Сведения.Вставить("note", "Клиент тестирования не закрылся за 20 с: соединение разорвано, окно осталось.");
	КонецЕсли;
	Возврат Сведения;
	
КонецФункции

#КонецОбласти

#Область ОкнаИЭлементы

Функция ОписанияОконТеста(Приложение, Типы)
	
	Описания = Новый Массив;
	ЗаголовокАктивного = "";
	Попытка
		АктивноеОкно = Приложение.ПолучитьАктивноеОкно();
		Если АктивноеОкно <> Неопределено Тогда
			ЗаголовокАктивного = АктивноеОкно.Заголовок;
		КонецЕсли;
	Исключение
		// Активного окна может не быть
	КонецПопытки;
	Для Каждого ОкноКлиента Из Приложение.НайтиОбъекты(Типы.ОкноПриложения) Цикл
		Описание = Новый Структура;
		Описание.Вставить("title", ОкноКлиента.Заголовок);
		Если ОкноКлиента.Основное Тогда
			Описание.Вставить("main", Истина);
		КонецЕсли;
		Если ОкноКлиента.Заголовок = ЗаголовокАктивного Тогда
			Описание.Вставить("active", Истина);
		КонецЕсли;
		Описания.Добавить(Описание);
	КонецЦикла;
	Возврат Описания;
	
КонецФункции

Функция НайденноеОкноТеста(Приложение, Типы, Образец)
	
	Если Не ЗначениеЗаполнено(Образец) Или Образец = "@active" Тогда
		АктивноеОкно = Приложение.ПолучитьАктивноеОкно();
		Если АктивноеОкно <> Неопределено Тогда
			Возврат АктивноеОкно;
		КонецЕсли;
		// Активного окна нет (например, у клиента обычного приложения): берётся первое открытое
		Окна = Приложение.НайтиОбъекты(Типы.ОкноПриложения);
		Возврат ?(Окна.Количество() > 0, Окна[0], Неопределено);
	КонецЕсли;
	// Объекты одного окна, полученные разными вызовами, не равны: окна различаются только по заголовку
	Начало = Строка(Образец);
	Если Прав(Начало, 1) = "*" Тогда
		Начало = Лев(Начало, СтрДлина(Начало) - 1);
	КонецЕсли;
	ПоНачалу = Неопределено;
	Для Каждого ОкноКлиента Из Приложение.НайтиОбъекты(Типы.ОкноПриложения) Цикл
		Если Образец = "@main" Тогда
			Если ОкноКлиента.Основное Тогда
				Возврат ОкноКлиента;
			КонецЕсли;
		ИначеЕсли ОкноКлиента.Заголовок = Образец Или ОкноКлиента.Заголовок = Начало Тогда
			Возврат ОкноКлиента;
		ИначеЕсли ПоНачалу = Неопределено И НРег(Лев(ОкноКлиента.Заголовок, СтрДлина(Начало))) = НРег(Начало) Тогда
			ПоНачалу = ОкноКлиента;
		КонецЕсли;
	КонецЦикла;
	Возврат ПоНачалу;
	
КонецФункции

Функция ОкноТестаПоОбразцу(Приложение, Типы, Образец)
	
	Найденное = НайденноеОкноТеста(Приложение, Типы, Образец);
	Если Найденное = Неопределено Тогда
		ВызватьИсключение СтрокаПоШаблону("Окно «%1» не найдено. Открыты: %2", Образец,
			ЗаголовкиОконТеста(Приложение, Типы));
	КонецЕсли;
	Возврат Найденное;
	
КонецФункции

Функция ЗаголовкиОконТеста(Приложение, Типы)
	
	Заголовки = Новый Массив;
	Для Каждого ОкноКлиента Из Приложение.НайтиОбъекты(Типы.ОкноПриложения) Цикл
		Заголовки.Добавить("«" + ОкноКлиента.Заголовок + "»");
	КонецЦикла;
	Возврат СоединенныеСтроки(Заголовки, ", ");
	
КонецФункции

Функция ЗаголовокАктивногоОкнаТеста(Приложение)
	
	Попытка
		АктивноеОкно = Приложение.ПолучитьАктивноеОкно();
		Возврат ?(АктивноеОкно = Неопределено, "", АктивноеОкно.Заголовок);
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

Функция ПорядокТиповТеста(Типы, Действие)
	
	// Сначала тип, которого ждёт действие: меньше обращений к клиенту тестирования
	Порядок = Новый Массив;
	Если Действие = "click" Тогда
		Порядок.Добавить(Типы.Кнопка);
		Порядок.Добавить(Типы.Декорация);
		Порядок.Добавить(Типы.Поле);
		Порядок.Добавить(Типы.Группа);
	ИначеЕсли Найти(Действие, "row") > 0 Тогда
		Порядок.Добавить(Типы.Таблица);
	ИначеЕсли Действие = "activate" Тогда
		Порядок.Добавить(Типы.Группа);
		Порядок.Добавить(Типы.Поле);
		Порядок.Добавить(Типы.Таблица);
		Порядок.Добавить(Типы.Кнопка);
	Иначе
		Порядок.Добавить(Типы.Поле);
		Порядок.Добавить(Типы.Таблица);
		Порядок.Добавить(Типы.Декорация);
		Порядок.Добавить(Типы.Кнопка);
		Порядок.Добавить(Типы.Группа);
	КонецЕсли;
	Возврат Порядок;
	
КонецФункции

Функция ЭлементТестаПоИмени(ОкноШага, Типы, ИмяЭлемента, Действие)
	
	Если Не ЗначениеЗаполнено(ИмяЭлемента) Тогда
		ВызватьИсключение СтрокаПоШаблону("Действию «%1» нужен элемент формы: поле target.", Действие);
	КонецЕсли;
	// Поиск отсутствующего элемента по имени ждёт около секунды на каждый тип, а список элементов типа
	// приходит сразу: имя и заголовок сверяются по спискам
	Искомое = НРег(СокрЛП(ИмяЭлемента));
	ПоЗаголовку = Неопределено;
	Для Каждого ТипЭлемента Из ПорядокТиповТеста(Типы, Действие) Цикл
		Для Каждого Кандидат Из ОкноШага.НайтиОбъекты(ТипЭлемента) Цикл
			Если НРег(Кандидат.Имя) = Искомое Тогда
				Возврат Кандидат;
			ИначеЕсли ПоЗаголовку = Неопределено И НРег(СокрЛП(Кандидат.ТекстЗаголовка)) = Искомое Тогда
				ПоЗаголовку = Кандидат;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если ПоЗаголовку <> Неопределено Тогда
		Возврат ПоЗаголовку;
	КонецЕсли;
	ВызватьИсключение СтрокаПоШаблону("Элемент «%1» не найден в окне «%2» ни по имени, ни по заголовку.",
		ИмяЭлемента, ОкноШага.Заголовок);
	
КонецФункции

Функция ПредставлениеЭлементаТеста(ЭлементШага)
	
	Попытка
		Возврат ЭлементШага.ПолучитьПредставлениеДанных();
	Исключение
		// У элемента нет данных или форма после действия закрылась
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Процедура АктивизироватьЭлементТеста(ЭлементШага)
	
	Попытка
		ЭлементШага.Активизировать();
	Исключение
		// Элемент не активизируется (например, недоступен): действие само сообщит об ошибке
	КонецПопытки;
	
КонецПроцедуры

Функция СообщенияОконТеста(Приложение, Типы, ЗакрыватьПанель)
	
	Сообщения = Новый Массив;
	Для Каждого ОкноКлиента Из Приложение.НайтиОбъекты(Типы.ОкноПриложения) Цикл
		// У окна без сообщений и у окна списка метод бросает исключение
		Попытка
			Тексты = ОкноКлиента.ПолучитьТекстыСообщенийПользователю();
			Для Каждого ТекстСообщения Из Тексты Цикл
				Сообщения.Добавить(Строка(ТекстСообщения));
			КонецЦикла;
			Если ЗакрыватьПанель И Тексты.Количество() > 0 Тогда
				ОкноКлиента.ЗакрытьПанельСообщенийПользователю();
			КонецЕсли;
		Исключение
			Продолжить;
		КонецПопытки;
	КонецЦикла;
	Возврат Сообщения;
	
КонецФункции

Функция ОшибкаКлиентаТеста(Приложение)
	
	Попытка
		Сведения = Приложение.ПолучитьТекущуюИнформациюОбОшибке();
		Если Сведения = Неопределено Или ПустаяСтрока(Сведения.Описание) Тогда
			Возврат "";
		КонецЕсли;
		Место = "";
		Если ЗначениеЗаполнено(Сведения.ИмяМодуля) Тогда
			Место = СтрокаПоШаблону(" (%1, строка %2)", Сведения.ИмяМодуля, Формат(Сведения.НомерСтроки, "ЧГ=0"));
		КонецЕсли;
		Возврат Сведения.Описание + Место;
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

#КонецОбласти

#Область Снимок

Функция ДанныеСнимкаТеста(Команда)
	
	Приложение = ПодключенныйКлиентТестирования();
	Типы = ТипыТеста();
	
	Настройки = Новый Структура;
	Настройки.Вставить("Типы", Типы);
	Настройки.Вставить("Скрытые", Команда.Получить("hidden") = Истина);
	Настройки.Вставить("Подробно", Команда.Получить("details") = Истина);
	Настройки.Вставить("Интерфейс", Команда.Получить("interface") = Истина);
	Настройки.Вставить("Срок",
		ТекущаяУниверсальнаяДатаВМиллисекундах() + ЧислоТеста(Команда, "budgetSec", 40) * 1000);
	Настройки.Вставить("Обрезано", Ложь);
	Настройки.Вставить("Объектов", 0);
	
	Снимок = Новый Структура;
	Снимок.Вставить("windows", ОписанияОконТеста(Приложение, Типы));
	ОкноСнимка = ОкноТестаПоОбразцу(Приложение, Типы, Команда.Получить("window"));
	Снимок.Вставить("window", ОкноСнимка.Заголовок);
	
	ИмяТаблицы = Команда.Получить("table");
	Если ЗначениеЗаполнено(ИмяТаблицы) Тогда
		// Строки одной таблицы вместо дерева формы
		ТаблицаСнимка = ОкноСнимка.НайтиОбъект(Типы.Таблица,, ИмяТаблицы);
		Если ТаблицаСнимка = Неопределено Тогда
			ВызватьИсключение СтрокаПоШаблону("Таблица «%1» не найдена в окне «%2».", ИмяТаблицы,
				ОкноСнимка.Заголовок);
		КонецЕсли;
		Снимок.Вставить("table", СтрокиТаблицыТеста(ТаблицаСнимка, Настройки, ЧислоТеста(Команда, "rows", 20)));
	Иначе
		Узлы = Новый Массив;
		Для Каждого Подчиненный Из ОкноСнимка.ПолучитьПодчиненныеОбъекты() Цикл
			Узел = УзелСнимкаТеста(Подчиненный, Настройки, Неопределено);
			Если Узел <> Неопределено Тогда
				Узлы.Добавить(Узел);
			КонецЕсли;
		КонецЦикла;
		Снимок.Вставить("items", Узлы);
	КонецЕсли;
	
	Снимок.Вставить("messages", СообщенияОконТеста(Приложение, Типы, Ложь));
	Снимок.Вставить("clientError", ОшибкаКлиентаТеста(Приложение));
	Снимок.Вставить("objects", Настройки.Объектов);
	Если Настройки.Обрезано Тогда
		Снимок.Вставить("truncated", Истина);
	КонецЕсли;
	Возврат Снимок;
	
КонецФункции

Функция УзелСнимкаТеста(ОбъектТеста, Настройки, КолонкиТаблицы)
	
	// Каждое обращение к объекту - вызов клиента тестирования: на большой форме снимок ограничен по времени
	Если ТекущаяУниверсальнаяДатаВМиллисекундах() > Настройки.Срок Тогда
		Настройки.Обрезано = Истина;
		Возврат Неопределено;
	КонецЕсли;
	Настройки.Объектов = Настройки.Объектов + 1;
	
	Типы = Настройки.Типы;
	ТипОбъекта = ТипЗнч(ОбъектТеста);
	Узел = Новый Структура;
	ЕстьПодчиненные = Истина;
	Если ТипОбъекта = Типы.Форма Тогда
		Узел.Вставить("t", "form");
		Узел.Вставить("name", ОбъектТеста.ИмяФормы);
		Узел.Вставить("title", ОбъектТеста.ТекстЗаголовка);
		Попытка
			Если ОбъектТеста.ТекущаяМодифицированность() Тогда
				Узел.Вставить("modified", Истина);
			КонецЕсли;
			Если ОбъектТеста.ТекущееТолькоПросмотр() Тогда
				Узел.Вставить("readOnly", Истина);
			КонецЕсли;
		Исключение
			// Служебная форма платформы на эти вопросы не отвечает
		КонецПопытки;
	Иначе
		Если ТипОбъекта = Типы.Поле Тогда
			Узел.Вставить("t", "field");
			ЕстьПодчиненные = Ложь;
		ИначеЕсли ТипОбъекта = Типы.Кнопка Тогда
			Узел.Вставить("t", "button");
			ЕстьПодчиненные = Ложь;
		ИначеЕсли ТипОбъекта = Типы.Декорация Тогда
			Узел.Вставить("t", "decoration");
			ЕстьПодчиненные = Ложь;
		ИначеЕсли ТипОбъекта = Типы.Таблица Тогда
			Узел.Вставить("t", "table");
		ИначеЕсли ТипОбъекта = Типы.Группа Тогда
			Узел.Вставить("t", "group");
		Иначе
			// Командный интерфейс окна и прочие объекты вне форм: по умолчанию одной строкой
			Узел.Вставить("t", Строка(ТипОбъекта));
			ЕстьПодчиненные = Настройки.Интерфейс;
		КонецЕсли;
		Попытка
			Узел.Вставить("name", ОбъектТеста.Имя);
			Узел.Вставить("title", ОбъектТеста.ТекстЗаголовка);
		Исключение
			// У объекта нет имени или заголовка
		КонецПопытки;
		Если Не ДополненУзелЭлементаТеста(Узел, ОбъектТеста, Настройки, КолонкиТаблицы) Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	// Контекстные меню повторяют кнопки командных панелей: в снимке они только с hidden
	Если ЕстьПодчиненные И Узел.t = "group" И Не Настройки.Скрытые И Узел.Свойство("name")
		И Прав(Узел.name, СтрДлина("КонтекстноеМеню")) = "КонтекстноеМеню" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ЕстьПодчиненные Тогда
		Колонки = КолонкиТаблицы;
		Если ТипОбъекта = Типы.Таблица Тогда
			Колонки = Новый Массив;
		КонецЕсли;
		Узлы = Новый Массив;
		Попытка
			Подчиненные = ОбъектТеста.ПолучитьПодчиненныеОбъекты();
		Исключение
			Подчиненные = Новый Массив;
		КонецПопытки;
		Для Каждого Подчиненный Из Подчиненные Цикл
			Дочерний = УзелСнимкаТеста(Подчиненный, Настройки, Колонки);
			Если Дочерний <> Неопределено Тогда
				Узлы.Добавить(Дочерний);
			КонецЕсли;
		КонецЦикла;
		Если Узлы.Количество() > 0 Тогда
			Узел.Вставить("items", Узлы);
		КонецЕсли;
		Если ТипОбъекта = Типы.Таблица И Не Узел.Свойство("hidden") Тогда
			ТекущаяСтрока = ЯчейкиСтрокиТеста(ОбъектТеста, Колонки);
			Если ТекущаяСтрока <> Неопределено Тогда
				Узел.Вставить("row", ТекущаяСтрока);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Узел;
	
КонецФункции

Функция ДополненУзелЭлементаТеста(Узел, ОбъектТеста, Настройки, КолонкиТаблицы)
	
	Видим = Истина;
	Попытка
		Видим = ОбъектТеста.ТекущаяВидимость();
	Исключение
		// Объект не сообщает о видимости: считается видимым
	КонецПопытки;
	Если Не Видим Тогда
		Если Не Настройки.Скрытые Тогда
			Возврат Ложь;
		КонецЕсли;
		Узел.Вставить("hidden", Истина);
	КонецЕсли;
	
	Если Узел.t = "field" Тогда
		Попытка
			Узел.Вставить("kind", Строка(ОбъектТеста.Вид));
		Исключение
			// Вид поля неизвестен
		КонецПопытки;
		Если КолонкиТаблицы <> Неопределено Тогда
			// Колонка таблицы: значение читается ячейкой текущей строки
			Если Видим И Узел.Свойство("name") Тогда
				КолонкиТаблицы.Добавить(Узел.name);
			КонецЕсли;
		ИначеЕсли Видим Тогда
			Значение = ПредставлениеЭлементаТеста(ОбъектТеста);
			Если Значение <> Неопределено Тогда
				Узел.Вставить("value", Значение);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Настройки.Подробно И Видим Тогда
		Попытка
			Если Не ОбъектТеста.ТекущаяДоступность() Тогда
				Узел.Вставить("disabled", Истина);
			КонецЕсли;
			Если Узел.t = "field" И ОбъектТеста.ТекущееТолькоПросмотр() Тогда
				Узел.Вставить("readOnly", Истина);
			КонецЕсли;
		Исключение
			// Объект не сообщает о доступности
		КонецПопытки;
	КонецЕсли;
	Возврат Истина;
	
КонецФункции

Функция ЯчейкиСтрокиТеста(ТаблицаТеста, Колонки)
	
	// Неопределено - текущей строки нет: таблица пуста или строка не выбрана
	Ячейки = Новый Массив;
	Прочитано = 0;
	Для Каждого ИмяКолонки Из Колонки Цикл
		Попытка
			Ячейки.Добавить(ТаблицаТеста.ПолучитьТекстЯчейки(ИмяКолонки));
			Прочитано = Прочитано + 1;
		Исключение
			Ячейки.Добавить(Неопределено);
			// Первые колонки не прочитались - остальные не прочитаются тоже: строки нет
			Если Прочитано = 0 И Ячейки.Количество() >= 3 Тогда
				Возврат Неопределено;
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;
	Возврат ?(Прочитано = 0, Неопределено, Ячейки);
	
КонецФункции

Функция СтрокиТаблицыТеста(ТаблицаТеста, Настройки, Предел)
	
	Колонки = Новый Массив;
	Заголовки = Новый Массив;
	Очередь = Новый Массив;
	Очередь.Добавить(ТаблицаТеста);
	Пока Очередь.Количество() > 0 Цикл
		Родитель = Очередь[0];
		Очередь.Удалить(0);
		Для Каждого Подчиненный Из Родитель.ПолучитьПодчиненныеОбъекты() Цикл
			ТипПодчиненного = ТипЗнч(Подчиненный);
			Если ТипПодчиненного = Настройки.Типы.Группа Тогда
				Очередь.Добавить(Подчиненный);
			ИначеЕсли ТипПодчиненного = Настройки.Типы.Поле И Подчиненный.ТекущаяВидимость() Тогда
				Колонки.Добавить(Подчиненный.Имя);
				Заголовки.Добавить(Подчиненный.ТекстЗаголовка);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Данные = Новый Структура;
	Данные.Вставить("name", ТаблицаТеста.Имя);
	Данные.Вставить("columns", Колонки);
	Данные.Вставить("titles", Заголовки);
	Строки = Новый Массив;
	Данные.Вставить("rows", Строки);
	
	// На пустой редактируемой таблице переход к первой строке начал бы добавление строки
	Если ЯчейкиСтрокиТеста(ТаблицаТеста, Колонки) = Неопределено Тогда
		Данные.Вставить("note", "Текущей строки нет: таблица пуста или строка не выбрана. Строки не читались.");
		Возврат Данные;
	КонецЕсли;
	АктивизироватьЭлементТеста(ТаблицаТеста);
	ТаблицаТеста.ПерейтиКПервойСтроке();
	Пока Истина Цикл
		Ячейки = ЯчейкиСтрокиТеста(ТаблицаТеста, Колонки);
		Если Ячейки <> Неопределено Тогда
			Строки.Добавить(Ячейки);
		КонецЕсли;
		Попытка
			ТаблицаТеста.ПерейтиКСледующейСтроке();
		Исключение
			// Строки кончились
			Прервать;
		КонецПопытки;
		Если Строки.Количество() >= Предел Или ТекущаяУниверсальнаяДатаВМиллисекундах() > Настройки.Срок Тогда
			Данные.Вставить("truncated", Истина);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Данные.Вставить("note", "Чтение строк сдвинуло текущую строку таблицы.");
	Возврат Данные;
	
КонецФункции

#КонецОбласти

#Область Шаги

Функция ДанныеШаговТеста(Команда)
	
	Приложение = ПодключенныйКлиентТестирования();
	Типы = ТипыТеста();
	Шаги = Команда.Получить("steps");
	Если ТипЗнч(Шаги) <> Тип("Массив") Или Шаги.Количество() = 0 Тогда
		ВызватьИсключение "Не переданы шаги: steps - непустой массив.";
	КонецЕсли;
	ДоПервойОшибки = Команда.Получить("stopOnError") <> Ложь;
	
	// Сообщения и ошибка, оставшиеся до шагов, отделяются от того, что вызовут сами шаги
	Прежние = СообщенияОконТеста(Приложение, Типы, Истина);
	ПрежняяОшибка = ОшибкаКлиентаТеста(Приложение);
	
	Записи = Новый Массив;
	Ошибок = 0;
	Для Каждого Шаг Из Шаги Цикл
		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Запись = Новый Структура;
		Запись.Вставить("action", Строка(Шаг.Получить("action")));
		Если ЗначениеЗаполнено(Шаг.Получить("target")) Тогда
			Запись.Вставить("target", Строка(Шаг.Получить("target")));
		КонецЕсли;
		Попытка
			Значение = ЗначениеШагаТеста(Приложение, Типы, Шаг);
			Запись.Вставить("ok", Истина);
			Если Значение <> Неопределено Тогда
				Запись.Вставить("value", Значение);
			КонецЕсли;
		Исключение
			Запись.Вставить("ok", Ложь);
			Запись.Вставить("error", ИнформацияОбОшибке().Описание);
			Ошибок = Ошибок + 1;
		КонецПопытки;
		
		// Состояние клиента после шага: активное окно, новые сообщения пользователю, ошибка
		Попытка
			Запись.Вставить("window", ЗаголовокАктивногоОкнаТеста(Приложение));
			Сообщения = СообщенияОконТеста(Приложение, Типы, Истина);
			Если Сообщения.Количество() > 0 Тогда
				Запись.Вставить("messages", Сообщения);
			КонецЕсли;
			ОшибкаКлиента = ОшибкаКлиентаТеста(Приложение);
			Если ОшибкаКлиента <> "" И ОшибкаКлиента <> ПрежняяОшибка Тогда
				Запись.Вставить("clientError", ОшибкаКлиента);
			КонецЕсли;
			ПрежняяОшибка = ОшибкаКлиента;
		Исключение
			Запись.Вставить("clientError", "Клиент тестирования не отвечает: "
				+ ИнформацияОбОшибке().Описание);
			Если Запись.ok Тогда
				Запись.ok = Ложь;
				Ошибок = Ошибок + 1;
			КонецЕсли;
		КонецПопытки;
		Запись.Вставить("ms", ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало);
		Записи.Добавить(Запись);
		Если Не Запись.ok И ДоПервойОшибки Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Итог = Новый Структура;
	Итог.Вставить("total", Шаги.Количество());
	Итог.Вставить("failed", Ошибок);
	Итог.Вставить("steps", Записи);
	Если Прежние.Количество() > 0 Тогда
		Итог.Вставить("earlierMessages", Прежние);
	КонецЕсли;
	Возврат Итог;
	
КонецФункции

Функция ЗначениеШагаТеста(Приложение, Типы, Шаг)
	
	Действие = НРег(Строка(Шаг.Получить("action")));
	Значение = Шаг.Получить("value");
	Образец = Шаг.Получить("window");
	
	Если Действие = "open" Тогда
		ОкноТестаПоОбразцу(Приложение, Типы, "@main").ВыполнитьКоманду(Строка(Значение));
		Возврат Неопределено;
	ИначеЕсли Действие = "wait_window" Тогда
		Таймаут = ЧислоТеста(Шаг, "timeout", 10);
		Найденное = Приложение.НайтиОбъект(Типы.ОкноПриложения, Строка(Значение),, Таймаут);
		Если Найденное = Неопределено Тогда
			ВызватьИсключение СтрокаПоШаблону("Окно «%1» не появилось за %2 с. Открыты: %3", Значение,
				Формат(Таймаут, "ЧГ=0"), ЗаголовкиОконТеста(Приложение, Типы));
		КонецЕсли;
		Возврат Найденное.Заголовок;
	ИначеЕсли Действие = "close" Тогда
		ОкноТестаПоОбразцу(Приложение, Типы, ?(ЗначениеЗаполнено(Образец), Образец, Значение)).Закрыть();
		Возврат Неопределено;
	КонецЕсли;
	
	ОкноШага = ОкноТестаПоОбразцу(Приложение, Типы, Образец);
	ЭлементШага = ЭлементТестаПоИмени(ОкноШага, Типы, Шаг.Получить("target"), Действие);
	
	Если Действие = "click" Тогда
		ЭлементШага.Нажать();
	ИначеЕсли Действие = "activate" Тогда
		ЭлементШага.Активизировать();
	ИначеЕсли Действие = "input" Тогда
		АктивизироватьЭлементТеста(ЭлементШага);
		// Значение поле примет, когда потеряет фокус: прочитать его можно следующим шагом read
		ЭлементШага.ВвестиТекст(Строка(Значение));
	ИначеЕсли Действие = "select" Тогда
		ВыбратьИзСпискаТеста(ЭлементШага, Строка(Значение));
		Возврат ПредставлениеЭлементаТеста(ЭлементШага);
	ИначеЕсли Действие = "choose" Тогда
		АктивизироватьЭлементТеста(ЭлементШага);
		ЭлементШага.Выбрать();
	ИначеЕсли Действие = "clear" Тогда
		АктивизироватьЭлементТеста(ЭлементШага);
		ЭлементШага.Очистить();
	ИначеЕсли Действие = "check" Тогда
		// УстановитьОтметку переключает флажок: вызывается, только если значение другое
		Отмечен = ФлажокТестаОтмечен(ЭлементШага);
		Если Отмечен <> (Значение <> Ложь) Тогда
			ЭлементШага.УстановитьОтметку();
		КонецЕсли;
		Возврат ПредставлениеЭлементаТеста(ЭлементШага);
	ИначеЕсли Действие = "read" Или Действие = "expect" Тогда
		Возврат ПрочитанноеЗначениеТеста(ЭлементШага, Типы, Шаг, Действие = "expect");
	ИначеЕсли Действие = "add_row" Тогда
		ЭлементШага.ДобавитьСтроку();
	ИначеЕсли Действие = "edit_row" Тогда
		ЭлементШага.ИзменитьСтроку();
	ИначеЕсли Действие = "end_row" Тогда
		// value = true - отменить редактирование строки
		ЭлементШага.ЗакончитьРедактированиеСтроки(Значение = Истина);
	ИначеЕсли Действие = "delete_row" Тогда
		ЭлементШага.УдалитьСтроку();
	ИначеЕсли Действие = "choose_row" Тогда
		ЭлементШага.Выбрать();
	ИначеЕсли Действие = "goto_row" Тогда
		ПерейтиКСтрокеТеста(ЭлементШага, Значение);
	Иначе
		ВызватьИсключение СтрокаПоШаблону("Неизвестное действие шага: %1. Действия: %2", Действие,
			"open, wait_window, close, click, activate, input, select, choose, clear, check, read, expect, "
			+ "add_row, edit_row, end_row, delete_row, choose_row, goto_row");
	КонецЕсли;
	Возврат Неопределено;
	
КонецФункции

Функция ФлажокТестаОтмечен(ЭлементШага)
	
	Представление = НРег(СокрЛП(Строка(ЭлементШага.ПолучитьПредставлениеДанных())));
	Возврат Представление = "да" Или Представление = "yes" Или Представление = "истина" Или Представление = "true";
	
КонецФункции

Функция ПрочитанноеЗначениеТеста(ЭлементШага, Типы, Шаг, Сверить)
	
	ИмяКолонки = Шаг.Получить("column");
	Если ТипЗнч(ЭлементШага) = Типы.Таблица Тогда
		Если Не ЗначениеЗаполнено(ИмяКолонки) Тогда
			ВызватьИсключение "Для таблицы укажите колонку: поле column с именем колонки.";
		КонецЕсли;
		Фактическое = ЭлементШага.ПолучитьТекстЯчейки(ИмяКолонки);
	ИначеЕсли ТипЗнч(ЭлементШага) = Типы.Поле Тогда
		Фактическое = ЭлементШага.ПолучитьПредставлениеДанных();
	Иначе
		Фактическое = ЭлементШага.ТекстЗаголовка;
	КонецЕсли;
	Если Не Сверить Тогда
		Возврат Фактическое;
	КонецЕсли;
	
	Ожидаемое = Строка(Шаг.Получить("value"));
	Если Шаг.Получить("contains") = Истина Тогда
		Совпало = Найти(НРег(Строка(Фактическое)), НРег(Ожидаемое)) > 0;
	Иначе
		Совпало = СокрЛП(Строка(Фактическое)) = СокрЛП(Ожидаемое);
	КонецЕсли;
	Если Не Совпало Тогда
		ВызватьИсключение СтрокаПоШаблону("Ожидалось «%1», фактически «%2».", Ожидаемое, Фактическое);
	КонецЕсли;
	Возврат Фактическое;
	
КонецФункции

Процедура ВыбратьИзСпискаТеста(ЭлементШага, Искомое)
	
	Доступные = Новый Массив;
	АктивизироватьЭлементТеста(ЭлементШага);
	
	// Поле со списком выбора: набранный текст такой список не отбирает, пункт берётся из открытого списка
	Попытка
		ЭлементШага.ОткрытьВыпадающийСписок();
		ЭлементШага.ОжидатьФормированияВыпадающегоСписка(5);
		Если ВыбранПунктСпискаТеста(ЭлементШага, Искомое, Доступные, Ложь) Тогда
			Возврат;
		КонецЕсли;
	Исключение
		// У поля нет списка выбора: остаётся ввод по строке
	КонецПопытки;
	ЗакрытьСписокТеста(ЭлементШага);
	
	// Ссылочное поле: ввод по строке; список формируется с задержкой, при сбое ввод повторяется
	ПоследняяОшибка = "";
	Для НомерПопытки = 1 По 2 Цикл
		Попытка
			ЭлементШага.ВвестиТекст(Искомое);
			ЭлементШага.ОжидатьФормированияВыпадающегоСписка(8);
			Если ВыбранПунктСпискаТеста(ЭлементШага, Искомое, Доступные, Истина) Тогда
				Возврат;
			КонецЕсли;
			Прервать;
		Исключение
			ПоследняяОшибка = ИнформацияОбОшибке().Описание;
		КонецПопытки;
	КонецЦикла;
	
	// Открытый список держит строку таблицы в редактировании, и форма потом не закрывается
	ЗакрытьСписокТеста(ЭлементШага);
	Причина = ?(Доступные.Количество() > 0, "в списке: " + СоединенныеСтроки(Доступные, "; "), "список пуст");
	Если ПоследняяОшибка <> "" Тогда
		Причина = Причина + "; " + ПоследняяОшибка;
	КонецЕсли;
	ВызватьИсключение СтрокаПоШаблону("Значение «%1» не выбрано (%2). Набранный текст остался в поле.", Искомое,
		Причина);
	
КонецПроцедуры

Процедура ЗакрытьСписокТеста(ЭлементШага)
	
	Попытка
		Если ЭлементШага.ВыпадающийСписокОткрыт() Тогда
			ЭлементШага.ЗакрытьВыпадающийСписок();
		КонецЕсли;
	Исключение
		// У поля нет выпадающего списка
	КонецПопытки;
	
КонецПроцедуры

Функция ВыбранПунктСпискаТеста(ЭлементШага, Искомое, Доступные, ЕдинственныйПодходит)
	
	Пункты = ЭлементШага.ПолучитьПредставлениеСпискаВыбора();
	Подходящий = "";
	Точный = Ложь;
	Для Каждого Пункт Из Пункты Цикл
		ТекстПункта = Строка(Пункт.ОтображаемыйТекст);
		Если Доступные.Количество() < 20 И Доступные.Найти(ТекстПункта) = Неопределено Тогда
			Доступные.Добавить(ТекстПункта);
		КонецЕсли;
		Если Точный Тогда
			Продолжить;
		КонецЕсли;
		Если НРег(ТекстПункта) = НРег(Искомое) Тогда
			Подходящий = ТекстПункта;
			Точный = Истина;
		ИначеЕсли Подходящий = "" И НРег(Лев(ТекстПункта, СтрДлина(Искомое))) = НРег(Искомое) Тогда
			// У ссылки пункт дополнен кодом: «Наименование (000000031)»
			Подходящий = ТекстПункта;
		КонецЕсли;
	КонецЦикла;
	Если Подходящий = "" И ЕдинственныйПодходит И Пункты.Количество() = 1 Тогда
		Подходящий = Строка(Пункты[0].ОтображаемыйТекст);
	КонецЕсли;
	Если Подходящий = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		ЭлементШага.ВыполнитьВыборИзСпискаВыбора(Подходящий);
	Исключение
		ЭлементШага.ВыполнитьВыборИзВыпадающегоСписка(Подходящий);
	КонецПопытки;
	Возврат Истина;
	
КонецФункции

Процедура ПерейтиКСтрокеТеста(ТаблицаТеста, Значение)
	
	// Без активизации таблица отвечает на переходы «Неподходящее состояние элемента управления»
	АктивизироватьЭлементТеста(ТаблицаТеста);
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Куда = НРег(Значение);
		Если Куда = "first" Тогда
			ТаблицаТеста.ПерейтиКПервойСтроке();
		ИначеЕсли Куда = "last" Тогда
			ТаблицаТеста.ПерейтиКПоследнейСтроке();
		ИначеЕсли Куда = "next" Тогда
			ТаблицаТеста.ПерейтиКСледующейСтроке();
		ИначеЕсли Куда = "previous" Тогда
			ТаблицаТеста.ПерейтиКПредыдущейСтроке();
		Иначе
			ВызватьИсключение "goto_row: value - first, last, next, previous или объект «имя колонки: текст ячейки».";
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Соответствие") Или Значение.Количество() = 0 Тогда
		ВызватьИсключение "goto_row: value - first, last, next, previous или объект «имя колонки: текст ячейки».";
	КонецЕсли;
	
	// На пустой редактируемой таблице переход к первой строке начал бы добавление строки
	Если Не СтрокаТестаЧитается(ТаблицаТеста, Значение) Тогда
		ВызватьИсключение "Строка не найдена: таблица пуста, строка не выбрана или колонки названы неверно "
			+ "(нужны имена колонок из снимка формы).";
	КонецЕсли;
	Если СтрокаТестаПодходит(ТаблицаТеста, Значение) Тогда
		Возврат;
	КонецЕсли;
	// Штатный переход в части форм молча не срабатывает, поэтому результат сверяется, а затем - перебор
	Попытка
		ТаблицаТеста.ПерейтиКСтроке(Значение);
	Исключение
		// Описание строки не подошло платформе: строка ищется перебором
	КонецПопытки;
	Если СтрокаТестаПодходит(ТаблицаТеста, Значение) Тогда
		Возврат;
	КонецЕсли;
	ТаблицаТеста.ПерейтиКПервойСтроке();
	Для Счетчик = 1 По 2000 Цикл
		Если СтрокаТестаПодходит(ТаблицаТеста, Значение) Тогда
			Возврат;
		КонецЕсли;
		Попытка
			ТаблицаТеста.ПерейтиКСледующейСтроке();
		Исключение
			Прервать;
		КонецПопытки;
	КонецЦикла;
	ВызватьИсключение "Строка с такими значениями колонок не найдена.";
	
КонецПроцедуры

Функция СтрокаТестаЧитается(ТаблицаТеста, ОписаниеСтроки)
	
	Для Каждого КлючИЗначение Из ОписаниеСтроки Цикл
		Попытка
			ТаблицаТеста.ПолучитьТекстЯчейки(КлючИЗначение.Ключ);
		Исключение
			Возврат Ложь;
		КонецПопытки;
	КонецЦикла;
	Возврат Истина;
	
КонецФункции

Функция СтрокаТестаПодходит(ТаблицаТеста, ОписаниеСтроки)
	
	Для Каждого КлючИЗначение Из ОписаниеСтроки Цикл
		Попытка
			ТекстЯчейки = ТаблицаТеста.ПолучитьТекстЯчейки(КлючИЗначение.Ключ);
		Исключение
			Возврат Ложь;
		КонецПопытки;
		Если СокрЛП(Строка(ТекстЯчейки)) <> СокрЛП(Строка(КлючИЗначение.Значение)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
	
КонецФункции

#КонецОбласти

#Область ЖурналТестирования

Функция ТекстКомандыТеста(Команда)
	
	Действие = Команда.Получить("action");
	Если Действие = "connect" Тогда
		Возврат "Подключить клиент тестирования, порт " + Формат(ЧислоТеста(Команда, "port", 48000), "ЧГ=0");
	ИначеЕсли Действие = "close" Тогда
		Возврат ?(Команда.Получить("exit") = Ложь, "Отключиться от клиента тестирования",
			"Закрыть клиент тестирования");
	ИначеЕсли Действие = "snapshot" Тогда
		Текст = "Снимок окна клиента тестирования";
		Если ЗначениеЗаполнено(Команда.Получить("window")) Тогда
			Текст = Текст + " «" + Команда.Получить("window") + "»";
		КонецЕсли;
		Если ЗначениеЗаполнено(Команда.Получить("table")) Тогда
			Текст = Текст + ", строки таблицы " + Команда.Получить("table");
		КонецЕсли;
		Возврат Текст;
	КонецЕсли;
	
	Шаги = Команда.Получить("steps");
	Если ТипЗнч(Шаги) <> Тип("Массив") Тогда
		Возврат "Шаги в клиенте тестирования";
	КонецЕсли;
	Строки = Новый Массив;
	Строки.Добавить("Шаги в клиенте тестирования: " + Формат(Шаги.Количество(), "ЧН=0; ЧГ=0"));
	Номер = 0;
	Для Каждого Шаг Из Шаги Цикл
		Номер = Номер + 1;
		Части = Новый Массив;
		Части.Добавить(Формат(Номер, "ЧГ=0") + ".");
		Для Каждого ИмяПоля Из ЧастиСтроки("action,target,column,value,window", ",") Цикл
			ЗначениеПоля = Шаг.Получить(ИмяПоля);
			Если ТипЗнч(ЗначениеПоля) = Тип("Соответствие") Тогда
				Части.Добавить("{...}");
			ИначеЕсли ЗначениеПоля <> Неопределено И Строка(ЗначениеПоля) <> "" Тогда
				Части.Добавить(Строка(ЗначениеПоля));
			КонецЕсли;
		КонецЦикла;
		Строки.Добавить(СоединенныеСтроки(Части, " "));
	КонецЦикла;
	Возврат СоединенныеСтроки(Строки, Символы.ПС);
	
КонецФункции

Функция ИтогКомандыТеста(Команда, Результат)
	
	Действие = Команда.Получить("action");
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат "";
	ИначеЕсли Действие = "connect" Тогда
		Возврат "подключён, окон: " + Формат(Результат.windows.Количество(), "ЧН=0; ЧГ=0");
	ИначеЕсли Действие = "close" Тогда
		Возврат ?(Результат.closed, "клиент тестирования закрыт", Результат.note);
	ИначеЕсли Действие = "snapshot" И Результат.Свойство("table") Тогда
		Возврат СтрокаПоШаблону("окно «%1», строк таблицы: %2", Результат.window,
			Формат(Результат.table.rows.Количество(), "ЧН=0; ЧГ=0"));
	ИначеЕсли Действие = "snapshot" Тогда
		Возврат СтрокаПоШаблону("окно «%1», элементов: %2", Результат.window, Формат(Результат.objects, "ЧН=0; ЧГ=0"));
	ИначеЕсли Действие = "steps" Тогда
		Возврат СтрокаПоШаблону("шагов: %1 из %2, ошибок: %3", Формат(Результат.steps.Количество(), "ЧН=0; ЧГ=0"),
			Формат(Результат.total, "ЧН=0; ЧГ=0"), Формат(Результат.failed, "ЧН=0; ЧГ=0"));
	КонецЕсли;
	Возврат "";
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ОбменФайлами

// Общая область двух форм, как и ТестированиеИнтерфейса: переносится в модуль обычной формы скриптом.

Функция ОтветОбменаФайлами(Команда, ИдентификаторКоманды)
	
	Ответ = Новый Структура;
	Если Не РазрешитьКодНаКлиенте Тогда
		Ответ.Вставить("status", "rejected");
		Ответ.Вставить("error",
			"Работа с файлами компьютера не разрешена: на форме обработки выключен «Код на клиенте».");
		Возврат Ответ;
	КонецЕсли;
	
	Действие = Команда.Получить("action");
	Попытка
		Если Действие = "save" Тогда
			Данные = ДанныеСохраненияФайла(Команда, ИдентификаторКоманды, Ответ);
		ИначеЕсли Действие = "load" Тогда
			Данные = ДанныеЗагрузкиФайла(Команда);
		Иначе
			Ответ.Вставить("status", "rejected");
			Ответ.Вставить("error", СтрокаПоШаблону("Неизвестное действие с файлом: %1", Действие));
			Возврат Ответ;
		КонецЕсли;
	Исключение
		ОтветСОшибкой = ОтветОбОшибке(ИнформацияОбОшибке());
		Если Ответ.Свойство("messages") Тогда
			ОтветСОшибкой.Вставить("messages", Ответ.messages);
		КонецЕсли;
		Возврат ОтветСОшибкой;
	КонецПопытки;
	
	Ответ.Вставить("status", "ok");
	Ответ.Вставить("result", Данные);
	Возврат Ответ;
	
КонецФункции

Функция ДанныеСохраненияФайла(Команда, ИдентификаторКоманды, Ответ)
	
	// Значение вычисляется на сервере в транзакции с откатом и передаётся клиенту через временное хранилище
	Источник = ИсточникФайла(Команда.Получить("expression"));
	Если Источник.Сообщения.Количество() > 0 Тогда
		Ответ.Вставить("messages", Источник.Сообщения);
	КонецЕсли;
	Если ЗначениеЗаполнено(Источник.Ошибка) Тогда
		ВызватьИсключение Источник.Ошибка;
	КонецЕсли;
	
	ФорматФайла = НРег(Строка(Команда.Получить("format")));
	Путь = Строка(Команда.Получить("path"));
	Если ПустаяСтрока(Путь) Тогда
		Если ПустаяСтрока(ФорматФайла) Тогда
			ФорматФайла = ?(Источник.Вид = "spreadsheet", "pdf", ?(Источник.Вид = "text", "txt", "bin"));
		КонецЕсли;
		Путь = КаталогСеанса + "files" + ПолучитьРазделительПути() + ИдентификаторКоманды + "." + ФорматФайла;
	КонецЕсли;
	ФайлНазначения = Новый Файл(Путь);
	Если ПустаяСтрока(ФорматФайла) Тогда
		ФорматФайла = НРег(Сред(ФайлНазначения.Расширение, 2));
	КонецЕсли;
	СоздатьКаталог(ФайлНазначения.Путь);
	
	Если Источник.Вид = "text" Тогда
		ЗаписатьТекстовыйФайл(Путь, Источник.Текст);
	Иначе
		// В толстом клиенте обычного приложения значение приходит как есть, без временного хранилища.
		// Функции временного хранилища вызываются через Вычислить: в старых режимах совместимости их нет
		АдресЗначения = Источник.Адрес;
		Если ЗначениеЗаполнено(АдресЗначения) Тогда
			Содержимое = Вычислить("ПолучитьИзВременногоХранилища(АдресЗначения)");
		Иначе
			Содержимое = Источник.Значение;
		КонецЕсли;
		Если Источник.Вид = "spreadsheet" Тогда
			Содержимое.Записать(Путь, ТипФайлаТабличногоДокументаПоФормату(ФорматФайла));
		Иначе
			Содержимое.Записать(Путь);
		КонецЕсли;
		Если ЗначениеЗаполнено(АдресЗначения) Тогда
			Попытка
				Выполнить("УдалитьИзВременногоХранилища(АдресЗначения)");
			Исключение
				// Значение останется во временном хранилище до закрытия формы моста
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	ЗаписанныйФайл = Новый Файл(Путь);
	Данные = Новый Структура;
	Данные.Вставить("path", ЗаписанныйФайл.ПолноеИмя);
	Данные.Вставить("size", ЗаписанныйФайл.Размер());
	Данные.Вставить("kind", Источник.Вид);
	Данные.Вставить("valueType", Источник.ТипЗначения);
	Возврат Данные;
	
КонецФункции

Функция ТипФайлаТабличногоДокументаПоФормату(ФорматФайла)
	
	// Значения перечисления берутся по именам: часть форматов есть не на всех платформах
	Имена = Новый Соответствие;
	Имена.Вставить("pdf", "PDF");
	Имена.Вставить("mxl", "MXL");
	Имена.Вставить("xlsx", "XLSX");
	Имена.Вставить("xls", "XLS");
	Имена.Вставить("docx", "DOCX");
	Имена.Вставить("ods", "ODS");
	Имена.Вставить("html", "HTML");
	Имена.Вставить("txt", "TXT");
	ИмяТипа = Имена.Получить(ФорматФайла);
	Если ИмяТипа = Неопределено Тогда
		ВызватьИсключение СтрокаПоШаблону(
			"Табличный документ в формат «%1» не сохраняется. Форматы: pdf, mxl, xlsx, xls, docx, ods, html, txt.",
			ФорматФайла);
	КонецЕсли;
	Возврат Вычислить("ТипФайлаТабличногоДокумента." + ИмяТипа);
	
КонецФункции

Функция ДанныеЗагрузкиФайла(Команда)
	
	Путь = Строка(Команда.Получить("path"));
	ФайлИсточника = Новый Файл(Путь);
	Если Не ФайлИсточника.Существует() Или Не ФайлИсточника.ЭтоФайл() Тогда
		ВызватьИсключение СтрокаПоШаблону("Файл не найден: %1", Путь);
	КонецЕсли;
	// Значение живёт во временном хранилище, пока открыта форма моста
	Содержимое = Новый ДвоичныеДанные(Путь);
	ИдентификаторХранилища = ИдентификаторХранилищаМоста();
	Адрес = Вычислить("ПоместитьВоВременноеХранилище(Содержимое, ИдентификаторХранилища)");
	Данные = Новый Структура;
	Данные.Вставить("address", Адрес);
	Данные.Вставить("size", ФайлИсточника.Размер());
	Данные.Вставить("path", ФайлИсточника.ПолноеИмя);
	Возврат Данные;
	
КонецФункции

Функция ТекстКомандыФайла(Команда)
	
	Если Команда.Получить("action") = "load" Тогда
		Возврат "Файл во временное хранилище: " + Строка(Команда.Получить("path"));
	КонецЕсли;
	Текст = "Значение в файл";
	Если ЗначениеЗаполнено(Команда.Получить("path")) Тогда
		Текст = Текст + " " + Строка(Команда.Получить("path"));
	КонецЕсли;
	Возврат Текст + ":" + Символы.ПС + Строка(Команда.Получить("expression"));
	
КонецФункции

Функция ИтогКомандыФайла(Результат)
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтрокаПоШаблону("%1, байт: %2", Результат.path, Формат(Результат.size, "ЧН=0; ЧГ=0"));
	
КонецФункции

#КонецОбласти

#Область ЗначенияДляФайлов

Функция ИсточникФайла(Выражение)
	
	// В толстом клиенте обычного приложения модуль объекта выполняется здесь же: значение приходит как есть,
	// без временного хранилища
	Возврат ОбъектДляКодаАгента().ЗначениеДляФайла(Выражение, Неопределено, БезопасныйРежимКода);
	
КонецФункции

Функция ИдентификаторХранилищаМоста()
	
	// У обычной формы нет своего идентификатора: значения во временном хранилище живут до конца сеанса 1С
	Если ИдентификаторХранилища = Неопределено Тогда
		ИдентификаторХранилища = Новый УникальныйИдентификатор;
	КонецЕсли;
	Возврат ИдентификаторХранилища;
	
КонецФункции

#КонецОбласти

#Область Файлы

Процедура ПодготовитьКаталогСеанса()
	
	Разделитель = ПолучитьРазделительПути();
	Корень = КаталогОбмена();
	Если Прав(Корень, 1) <> Разделитель Тогда
		Корень = Корень + Разделитель;
	КонецЕсли;
	
	ИдентификаторСеанса = НРег(Лев(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""), 8));
	КаталогСеанса = Корень + ИдентификаторСеанса + Разделитель;
	СоздатьКаталог(КаталогСеанса + "in");
	СоздатьКаталог(КаталогСеанса + "work");
	СоздатьКаталог(КаталогСеанса + "out");
	
	ДанныеСеанса.Вставить("session", ИдентификаторСеанса);
	ДанныеСеанса.Вставить("path", КаталогСеанса);
	
КонецПроцедуры

Процедура УдалитьКаталогСеанса(Каталог)
	
	Если Не ЗначениеЗаполнено(Каталог) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		УдалитьФайлы(Лев(Каталог, СтрДлина(Каталог) - 1));
	Исключение
		// Каталог молчащего сеанса через сутки удалит MCP-сервер, который работает с этим каталогом обмена
	КонецПопытки;
	
КонецПроцедуры

Функция КаталогОбмена()
	
	Возврат ?(ЗначениеЗаполнено(СвойКаталогОбмена), СвойКаталогОбмена, СтандартныйКаталогОбмена());
	
КонецФункции

Функция СтандартныйКаталогОбмена()
	
	// Здесь же сеансы ищет MCP-сервер, если ему не задан MCP_1C_BRIDGE_DIR
	КаталогВременных = КаталогВременныхФайлов();
	Если Прав(КаталогВременных, 1) <> ПолучитьРазделительПути() Тогда
		КаталогВременных = КаталогВременных + ПолучитьРазделительПути();
	КонецЕсли;
	Возврат КаталогВременных + "mcp-1c-local-bridge";
	
КонецФункции

Функция КаталогДляНастройки(Каталог)
	
	// Стандартный каталог в настройке не хранится: пустое значение и означает каталог по умолчанию
	Результат = СокрЛП(Каталог);
	Если СтрДлина(Результат) > 3 И Прав(Результат, 1) = ПолучитьРазделительПути() Тогда
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЕсли;
	Если НРег(Результат) = НРег(СтандартныйКаталогОбмена()) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

Процедура ОбновитьСердцебиение(КомандаВРаботе = "")
	
	Если Не ЗначениеЗаполнено(КаталогСеанса) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ЗаписатьСведенияСеанса(КомандаВРаботе);
	Исключение
		// session.json мог быть открыт MCP на чтение: запишем при следующем опросе
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаписатьСведенияСеанса(КомандаВРаботе = "")
	
	Прогресс = "";
	Если ЗначениеЗаполнено(КомандаВРаботе) Тогда
		СостояниеСеанса = "busy";
		ТекущаяКоманда = КомандаВРаботе;
	ИначеЕсли ОжидающийОтвет <> Неопределено Тогда
		СостояниеСеанса = "awaiting";
		ТекущаяКоманда = ОжидающийОтвет.Ответ.id;
	ИначеЕсли Приостановлен Тогда
		СостояниеСеанса = "paused";
		ТекущаяКоманда = "";
	ИначеЕсли Индексация <> Неопределено Тогда
		СостояниеСеанса = "busy";
		ТекущаяКоманда = Индексация.Идентификатор;
		Прогресс = "индекс метаданных: " + Формат(ПроцентИндексации(), "ЧН=0") + "%";
	ИначеЕсли ПодключениеТеста <> Неопределено Тогда
		СостояниеСеанса = "busy";
		ТекущаяКоманда = ПодключениеТеста.Идентификатор;
		Прогресс = "запуск клиента тестирования";
	Иначе
		СостояниеСеанса = "ready";
		ТекущаяКоманда = "";
	КонецЕсли;
	
	ДанныеСеанса.Вставить("state", СостояниеСеанса);
	ДанныеСеанса.Вставить("busyCommand", ТекущаяКоманда);
	ДанныеСеанса.Вставить("progress", Прогресс);
	ДанныеСеанса.Вставить("heartbeat", XMLСтрока(ТекущаяУниверсальнаяДата()));
	ДанныеСеанса.Вставить("mode", ?(РучнаяВыдача, "manual", "auto"));
	ДанныеСеанса.Вставить("allowWrite", РазрешитьЗапись);
	ДанныеСеанса.Вставить("allowClientCode", РазрешитьКодНаКлиенте);
	ДанныеСеанса.Вставить("safeMode", БезопасныйРежимКода);
	ДанныеСеанса.Вставить("commandsDone", ВыполненоКоманд);
	ЗаписатьТекстовыйФайл(КаталогСеанса + "session.json", ТекстJSON(ДанныеСеанса, Ложь));
	МоментСердцебиения = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
КонецПроцедуры

Процедура ОтдатьОтвет(Идентификатор, ТекстОтвета, ФайлВРаботе)
	
	ИмяБезРасширения = КаталогСеанса + "out" + ПолучитьРазделительПути() + Идентификатор;
	// Ответ пишется во временный файл и переименовывается: MCP не увидит его недописанным
	ЗаписатьТекстовыйФайл(ИмяБезРасширения + ".tmp", ТекстОтвета);
	ПереместитьФайл(ИмяБезРасширения + ".tmp", ИмяБезРасширения + ".json");
	
	Попытка
		УдалитьФайлы(ФайлВРаботе);
	Исключение
		// MCP ориентируется на файл ответа, оставшийся файл команды работе не мешает
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаписатьТекстовыйФайл(ИмяФайла, Текст)
	
	Запись = Новый ЗаписьТекста(ИмяФайла, КодировкаТекста.UTF8);
	Попытка
		Запись.Записать(Текст);
	Исключение
		Запись.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Запись.Закрыть();
	
КонецПроцедуры

Функция ТекстJSON(Данные, СПереносами)
	
	Перенос = ?(СПереносами, ПереносСтрокJSON.Авто, ПереносСтрокJSON.Нет);
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(Перенос, " "));
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
	
КонецФункции

Функция ДанныеФайлаJSON(ИмяФайла)
	
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(ИмяФайла, "UTF-8");
	Попытка
		Данные = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Чтение.Закрыть();
	Возврат Данные;
	
КонецФункции

Функция СведенияСеанса()
	
	// В толстом клиенте обычного приложения код сервера выполняется в том же процессе: версия одна
	Система = Новый СистемнаяИнформация;
	Сведения = Новый Структура;
	Сведения.Вставить("protocol", 1);
	Сведения.Вставить("bridgeVersion", "1.6.0");
	Сведения.Вставить("application", "ordinary");
	Сведения.Вставить("infobase", СтрокаСоединенияИнформационнойБазы());
	Сведения.Вставить("user", ИмяПользователя());
	Сведения.Вставить("userFullName", ПолноеИмяПользователя());
	Сведения.Вставить("sessionNumber", НомерСеансаИнформационнойБазы());
	Сведения.Вставить("configuration", Метаданные.Имя);
	Сведения.Вставить("configurationSynonym", Метаданные.Синоним);
	Сведения.Вставить("configurationVersion", Метаданные.Версия);
	Сведения.Вставить("compatibilityMode", Строка(Метаданные.РежимСовместимости));
	Сведения.Вставить("platform", Система.ВерсияПриложения);
	Сведения.Вставить("serverPlatform", Система.ВерсияПриложения);
	Сведения.Вставить("started", XMLСтрока(ТекущаяУниверсальнаяДата()));
	Возврат Сведения;
	
КонецФункции

Функция СохраненныйКаталогОбмена()
	
	Каталог = ХранилищеОбщихНастроек.Загрузить("MCPLocalBridge", "КаталогОбмена");
	Возврат ?(ТипЗнч(Каталог) = Тип("Строка"), Каталог, "");
	
КонецФункции

Процедура СохранитьКаталогОбмена(Каталог)
	
	// Пустая строка - каталог по умолчанию
	ХранилищеОбщихНастроек.Сохранить("MCPLocalBridge", "КаталогОбмена", Каталог);
	
КонецПроцедуры

#КонецОбласти

#Область Журнал

Функция НоваяЗаписьЖурнала(ИдентификаторКоманды, Команда, Ответ, ТекстОтвета)
	
	Вид = "";
	Клиентская = Ложь;
	ТекстКоманды = "";
	ТекстПараметров = "";
	Если ТипЗнч(Команда) = Тип("Соответствие") Тогда
		Вид = Строка(Команда.Получить("type"));
		Клиентская = Команда.Получить("side") = "client";
		ТекстКоманды = ПолныйТекстКоманды(Команда);
		ПараметрыКоманды = Команда.Получить("params");
		Если ПараметрыКоманды <> Неопределено Тогда
			ТекстПараметров = ТекстJSON(ПараметрыКоманды, Истина);
		КонецЕсли;
	КонецЕсли;
	
	Ошибка = "";
	Если Не Ответ.Свойство("errorDetails", Ошибка) Тогда
		Ответ.Свойство("error", Ошибка);
	КонецЕсли;
	Сообщения = Новый Массив;
	Ответ.Свойство("messages", Сообщения);
	
	Запись = Новый Структура;
	Запись.Вставить("Идентификатор", ИдентификаторКоманды);
	Запись.Вставить("Время", ТекущаяДата());
	Запись.Вставить("Вид", Вид);
	Запись.Вставить("Клиентская", Клиентская);
	Запись.Вставить("Текст", ОднойСтрокой(ТекстКоманды, 300));
	Запись.Вставить("ПолныйТекст", НачалоТекста(ТекстКоманды));
	Запись.Вставить("Параметры", НачалоТекста(ТекстПараметров));
	Запись.Вставить("Статус", Ответ.status);
	Запись.Вставить("Итог", ОднойСтрокой(КраткийРезультат(Вид, Команда, Ответ), 300));
	Запись.Вставить("Длительность", Ответ.durationMs);
	Запись.Вставить("Результат", ПредставлениеРезультата(Ответ, ТекстОтвета));
	Запись.Вставить("Ошибка", НачалоТекста(Строка(Ошибка)));
	Запись.Вставить("Сообщения", ?(ТипЗнч(Сообщения) = Тип("Массив"), Сообщения, Новый Массив));
	Запись.Вставить("Выдача", "");
	Запись.Вставить("Комментарий");
	Возврат Запись;
	
КонецФункции

Функция ПолныйТекстКоманды(Команда)
	
	Если Команда.Получить("type") = "index" Тогда
		Возврат ?(Команда.Получить("refresh") = Истина, "Построить индекс метаданных заново", "Индекс метаданных");
	КонецЕсли;
	Если Команда.Получить("type") = "test" Тогда
		Возврат ТекстКомандыТеста(Команда);
	КонецЕсли;
	Если Команда.Получить("type") = "file" Тогда
		Возврат ТекстКомандыФайла(Команда);
	КонецЕсли;
	Для Каждого Ключ Из ЧастиСтроки("text,expression,code,path", ",") Цикл
		Текст = Команда.Получить(Ключ);
		Если ЗначениеЗаполнено(Текст) Тогда
			Возврат Строка(Текст);
		КонецЕсли;
	КонецЦикла;
	Отбор = Команда.Получить("filter");
	Если ЗначениеЗаполнено(Отбор) Тогда
		Возврат "Отбор: " + Отбор;
	КонецЕсли;
	Возврат "";
	
КонецФункции

Функция КраткийРезультат(Вид, Команда, Ответ)
	
	Если Ответ.status <> "ok" Тогда
		Ошибка = "";
		Ответ.Свойство("error", Ошибка);
		Возврат ПерваяСтрока(Строка(Ошибка));
	КонецЕсли;
	
	Результат = Неопределено;
	Ответ.Свойство("result", Результат);
	Если Вид = "query" Тогда
		Возврат ИтогЗапроса(Результат);
	ИначеЕсли Вид = "ping" Тогда
		Возврат "связь есть";
	ИначеЕсли Вид = "metadata" И ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("collections") Тогда
		Количество = 0;
		Для Каждого Коллекция Из Результат.collections Цикл
			Количество = Количество + Коллекция.objects.Количество();
		КонецЦикла;
		Возврат "объектов: " + Формат(Количество, "ЧН=0; ЧГ=0");
	ИначеЕсли Вид = "index" И ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("objects") Тогда
		Источник = ?(Результат.source = "saved", "из настроек пользователя", "построен заново");
		Возврат Источник + ", объектов: " + Формат(Результат.objects, "ЧН=0; ЧГ=0");
	ИначеЕсли Вид = "test" Тогда
		Возврат ИтогКомандыТеста(Команда, Результат);
	ИначеЕсли Вид = "file" Тогда
		Возврат ИтогКомандыФайла(Результат);
	КонецЕсли;
	Возврат ПредставлениеЗначения(Результат);
	
КонецФункции

Функция ИтогЗапроса(Результат)
	
	Если ТипЗнч(Результат) <> Тип("Структура") Или Не Результат.Свойство("results") Тогда
		Возврат "";
	КонецЕсли;
	Последний = Неопределено;
	Для Каждого Таблица Из Результат.results Цикл
		Если Таблица <> Неопределено Тогда
			Последний = Таблица;
		КонецЕсли;
	КонецЦикла;
	Если Последний = Неопределено Тогда
		Возврат "без результата";
	КонецЕсли;
	
	Строк = Формат(Последний.total, "ЧН=0; ЧГ=0");
	Если Результат.results.Количество() > 1 Тогда
		Возврат СтрокаПоШаблону("запросов: %1, в последнем строк: %2",
			Формат(Результат.results.Количество(), "ЧГ=0"), Строк);
	КонецЕсли;
	Возврат "строк: " + Строк;
	
КонецФункции

Функция ПредставлениеЗначения(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	Если Значение = Неопределено Тогда
		Возврат "Неопределено";
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧН=0; ЧГ=0");
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат ?(Значение, "Истина", "Ложь");
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		Возврат "массив, элементов: " + Формат(Значение.Количество(), "ЧН=0; ЧГ=0");
	ИначеЕсли ТипЗначения = Тип("Структура") И Значение.Свойство("_presentation") Тогда
		Возврат Строка(Значение._presentation);
	ИначеЕсли ТипЗначения = Тип("Структура") И Значение.Свойство("rows") И Значение.Свойство("total") Тогда
		Возврат "таблица, строк: " + Формат(Значение.total, "ЧН=0; ЧГ=0");
	ИначеЕсли ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("Соответствие") Тогда
		Поля = Новый Массив;
		Для Каждого КлючИЗначение Из Значение Цикл
			Если Поля.Количество() = 6 Тогда
				Поля.Добавить("...");
				Прервать;
			КонецЕсли;
			Поля.Добавить(Строка(КлючИЗначение.Ключ) + ": " + КраткоеЗначение(КлючИЗначение.Значение));
		КонецЦикла;
		Возврат СоединенныеСтроки(Поля, ", ");
	КонецЕсли;
	Возврат Строка(Значение);
	
КонецФункции

Функция КраткоеЗначение(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Структура") И Значение.Свойство("_presentation") Тогда
		Возврат Лев(Строка(Значение._presentation), 40);
	ИначеЕсли ТипЗначения = Тип("Структура") И Значение.Свойство("rows") И Значение.Свойство("total") Тогда
		Возврат "таблица(" + Формат(Значение.total, "ЧН=0; ЧГ=0") + ")";
	ИначеЕсли ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("Соответствие") Тогда
		Возврат "{...}";
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		Возврат "[" + Формат(Значение.Количество(), "ЧН=0; ЧГ=0") + "]";
	КонецЕсли;
	Возврат Лев(ПредставлениеЗначения(Значение), 40);
	
КонецФункции

Функция ПредставлениеРезультата(Ответ, ТекстОтвета)
	
	Результат = Неопределено;
	Если Не Ответ.Свойство("result", Результат) Тогда
		Возврат "";
	КонецЕсли;
	// Большой результат второй раз не форматируем: показываем начало ответа в том виде, как он ушёл агенту
	Если СтрДлина(ТекстОтвета) > ПределТекста() Тогда
		Возврат НачалоТекста(ТекстОтвета);
	КонецЕсли;
	Возврат ТекстJSON(Результат, Истина);
	
КонецФункции

Функция НачалоТекста(Текст)
	
	Если СтрДлина(Текст) <= ПределТекста() Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Лев(Текст, ПределТекста()) + Символы.ПС + СтрокаПоШаблону("... показаны первые %1 символов из %2",
		Формат(ПределТекста(), "ЧГ=0"), Формат(СтрДлина(Текст), "ЧГ=0"));
	
КонецФункции

Функция ОднойСтрокой(Текст, Длина)
	
	Результат = СтрЗаменить(СтрЗаменить(СтрЗаменить(Текст, Символы.ВК, ""), Символы.ПС, " "), Символы.Таб, " ");
	Возврат Лев(СокрЛП(Результат), Длина);
	
КонецФункции

Функция ПерваяСтрока(Текст)
	
	Позиция = Найти(Текст, Символы.ПС);
	Возврат ?(Позиция > 0, Лев(Текст, Позиция - 1), Текст);
	
КонецФункции

Функция ПределТекста()
	
	Возврат 30000;
	
КонецФункции

Функция ПределКомментария()
	
	Возврат 2000;
	
КонецФункции

#КонецОбласти

#Область СтроковыеФункции

Функция СтрокаПоШаблону(Шаблон, Параметр1 = Неопределено, Параметр2 = Неопределено,
	Параметр3 = Неопределено, Параметр4 = Неопределено, Параметр5 = Неопределено)
	
	Параметры = Новый Массив;
	Параметры.Добавить(Параметр1);
	Параметры.Добавить(Параметр2);
	Параметры.Добавить(Параметр3);
	Параметры.Добавить(Параметр4);
	Параметры.Добавить(Параметр5);
	
	Результат = "";
	Остаток = Шаблон;
	Позиция = Найти(Остаток, "%");
	Пока Позиция > 0 Цикл
		Результат = Результат + Лев(Остаток, Позиция - 1);
		Знак = Сред(Остаток, Позиция + 1, 1);
		Номер = ?(Знак = "", 0, Найти("12345", Знак));
		Если Знак = "%" Тогда
			Результат = Результат + "%";
			Остаток = Сред(Остаток, Позиция + 2);
		ИначеЕсли Номер > 0 Тогда
			Результат = Результат + Строка(Параметры[Номер - 1]);
			Остаток = Сред(Остаток, Позиция + 2);
		Иначе
			Результат = Результат + "%";
			Остаток = Сред(Остаток, Позиция + 1);
		КонецЕсли;
		Позиция = Найти(Остаток, "%");
	КонецЦикла;
	Возврат Результат + Остаток;
	
КонецФункции

Функция ЧастиСтроки(Знач Текст, Разделитель, ВключатьПустые = Истина)
	
	Части = Новый Массив;
	ДлинаРазделителя = СтрДлина(Разделитель);
	Позиция = Найти(Текст, Разделитель);
	Пока Позиция > 0 Цикл
		Часть = Лев(Текст, Позиция - 1);
		Если ВключатьПустые Или Часть <> "" Тогда
			Части.Добавить(Часть);
		КонецЕсли;
		Текст = Сред(Текст, Позиция + ДлинаРазделителя);
		Позиция = Найти(Текст, Разделитель);
	КонецЦикла;
	Если ВключатьПустые Или Текст <> "" Тогда
		Части.Добавить(Текст);
	КонецЕсли;
	Возврат Части;
	
КонецФункции

Функция СоединенныеСтроки(Строки, Разделитель = "")
	
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();
	Первая = Истина;
	Для Каждого Часть Из Строки Цикл
		Если Не Первая И Разделитель <> "" Тогда
			Запись.ЗаписатьБезОбработки(Разделитель);
		КонецЕсли;
		Запись.ЗаписатьБезОбработки(Строка(Часть));
		Первая = Ложь;
	КонецЦикла;
	Возврат Запись.Закрыть();
	
КонецФункции

#КонецОбласти

#КонецОбласти