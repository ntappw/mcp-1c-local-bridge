
#Область ОписаниеПеременных

Перем ДанныеСеанса;
Перем ИдентификаторСеанса;
Перем КаталогСеанса;
Перем СвойКаталогОбмена;
Перем МоментСердцебиения;
Перем ВыполненоКоманд;
Перем ЗаписиЖурнала;
Перем СтрокиЖурнала;
Перем ОжидающийОтвет;
Перем РазрешитьЗапись;
Перем РазрешитьКодНаКлиенте;
Перем РучнаяВыдача;
Перем Приостановлен;
Перем ОшибкаМоста;
Перем Индексация;

#КонецОбласти

#Область ОбработчикиСобытийФормы

Процедура ПередОткрытием(Отказ, СтандартнаяОбработка)
	
	ЗаписиЖурнала = Новый Массив;
	ВыполненоКоманд = 0;
	МоментСердцебиения = 0;
	РазрешитьЗапись = Ложь;
	РазрешитьКодНаКлиенте = Истина;
	РучнаяВыдача = Ложь;
	Приостановлен = Ложь;
	ОшибкаМоста = "";
	
	// Элементы создаются до каталога сеанса: если форма не откроется, агенту не останется пустого сеанса
	СоздатьЭлементы();
	// В макете формы назначен только ПередОткрытием, остальные обработчики назначаются кодом
	ЭтаФорма.УстановитьДействие("ПриЗакрытии", Новый Действие("ЗакрытиеФормы"));
	
	ДанныеСеанса = СведенияСеанса();
	СвойКаталогОбмена = СохраненныйКаталогОбмена();
	Попытка
		ПодготовитьКаталогСеанса();
		ЗаписатьСведенияСеанса();
	Исключение
		ОшибкаМоста = "Каталог обмена недоступен: " + ИнформацияОбОшибке().Описание;
	КонецПопытки;
	
	ОбновитьЭлементы();
	Если Не ЗначениеЗаполнено(ОшибкаМоста) Тогда
		ЗапланироватьОпрос();
	КонецЕсли;
	
КонецПроцедуры

// Обработчик закрытия формы: останавливает опрос и удаляет каталог сеанса моста.
//
Процедура ЗакрытиеФормы() Экспорт
	
	Попытка
		ЭтаФорма.ОтключитьОбработчикОжидания("ОбработатьОчередь");
	Исключение
		// Обработчик мог быть уже снят платформой
	КонецПопытки;
	
	УдалитьКаталогСеанса(КаталогСеанса);
	
КонецПроцедуры

// Обработчик ожидания: выполняет команды агента или очередную порцию индекса метаданных
// и обновляет сердцебиение сеанса.
//
Процедура ОбработатьОчередь() Экспорт
	
	// Следующий опрос планируется сразу: исключение в этом опросе не остановит мост
	ЗапланироватьОпрос();
	Если Не Приостановлен И ОжидающийОтвет = Неопределено Тогда
		Попытка
			// Пока строится индекс метаданных, каждый опрос описывает его очередную порцию, а команды ждут
			Если Индексация = Неопределено Тогда
				ВыполнитьВходящиеКоманды();
			Иначе
				ПродолжитьИндексацию();
			КонецЕсли;
		Исключение
			ПоказатьОшибкуМоста("Ошибка опроса: " + ИнформацияОбОшибке().Описание);
		КонецПопытки;
	КонецЕсли;
	Если ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментСердцебиения >= 2000 Тогда
		ОбновитьСердцебиение();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

// Выполняет действие нажатой кнопки: пауза, каталог обмена, копирование идентификатора сеанса, очистка журнала,
// решение по результату команды.
//
// Параметры:
//  Элемент - Кнопка - нажатая кнопка формы.
//
Процедура НажатиеКнопки(Элемент) Экспорт
	
	ИмяКнопки = Элемент.Имя;
	Если ИмяКнопки = "КнопкаПауза" Тогда
		Приостановлен = Не Приостановлен;
	ИначеЕсли ИмяКнопки = "КнопкаКаталогСеанса" И ЗначениеЗаполнено(КаталогСеанса) Тогда
		ЗапуститьПриложение(КаталогСеанса);
	ИначеЕсли ИмяКнопки = "КнопкаИзменитьКаталог" Тогда
		ВыбратьКаталогОбмена();
	ИначеЕсли ИмяКнопки = "КнопкаКаталогПоУмолчанию" Тогда
		СменитьКаталогОбмена("");
	ИначеЕсли ИмяКнопки = "КнопкаКопироватьСеанс" Тогда
		СкопироватьИдентификаторСеанса();
	ИначеЕсли ИмяКнопки = "КнопкаОчистить" Тогда
		ЗаписиЖурнала.Очистить();
		СтрокиЖурнала.Очистить();
		ЭлементыФормы.Подробности.УстановитьТекст("");
	ИначеЕсли ИмяКнопки = "КнопкаОтдать" Тогда
		ЗавершитьОжидание(Истина);
	ИначеЕсли ИмяКнопки = "КнопкаОтказать" Тогда
		ЗавершитьОжидание(Ложь);
	КонецЕсли;
	ОбновитьСердцебиение();
	ОбновитьЭлементы();
	
КонецПроцедуры

// Применяет флажок выдачи результатов с подтверждением или разрешения агенту.
//
// Параметры:
//  Элемент - Флажок - изменённый флажок формы.
//
Процедура ИзменениеФлажка(Элемент) Экспорт
	
	ИмяФлажка = Элемент.Имя;
	Включен = Элемент.Значение = Истина;
	Если ИмяФлажка = "ФлагСПодтверждением" Тогда
		РучнаяВыдача = Включен;
	ИначеЕсли ИмяФлажка = "ФлагЗапись" Тогда
		РазрешитьЗапись = Включен;
	ИначеЕсли ИмяФлажка = "ФлагКодНаКлиенте" Тогда
		РазрешитьКодНаКлиенте = Включен;
	КонецЕсли;
	ОбновитьСердцебиение();
	ОбновитьЭлементы();
	
КонецПроцедуры

// Показывает подробности команды, выбранной в журнале.
//
// Параметры:
//  Элемент - ТабличноеПоле - журнал команд.
//
Процедура АктивизацияСтрокиЖурнала(Элемент) Экспорт
	
	ПоказатьПодробности(Элемент.ТекущаяСтрока);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЭлементыФормы

Процедура СоздатьЭлементы()
	
	// Координаты - от левого верхнего угла формы, поля по 8 пикселей, как у основной панели в макете
	Слева = 8;
	ШиринаОбласти = ЭтаФорма.Ширина - 16;
	
	НадписьСостояния = ДобавитьНадпись("НадписьСостояние", Слева, 8, ШиринаОбласти);
	НадписьСостояния.Шрифт = Новый Шрифт(,, Истина);
	ДобавитьНадпись("НадписьСведения", Слева, 29, ШиринаОбласти);
	
	ДобавитьКнопку("КнопкаПауза", "Приостановить", Слева, 54, 110);
	ДобавитьКнопку("КнопкаКаталогСеанса", "Каталог сеанса", Слева + 116, 54, 120);
	ДобавитьКнопку("КнопкаИзменитьКаталог", "Изменить каталог обмена...", Слева + 242, 54, 180);
	ДобавитьКнопку("КнопкаКаталогПоУмолчанию", "Каталог по умолчанию", Слева + 428, 54, 150);
	ДобавитьКнопку("КнопкаОчистить", "Очистить журнал", Слева + 584, 54, 130);
	ДобавитьКнопку("КнопкаКопироватьСеанс", "Копировать идентификатор", Слева + 720, 54, 160);
	ЭлементыФормы.КнопкаКопироватьСеанс.Подсказка = "Скопировать идентификатор сеанса моста в буфер обмена";
	
	ДобавитьФлажок("ФлагСПодтверждением", "Выдача результатов с подтверждением", Слева, 84, 250);
	ДобавитьФлажок("ФлагЗапись", "Запись в базу", Слева + 256, 84, 130);
	ДобавитьФлажок("ФлагКодНаКлиенте", "Код на клиенте", Слева + 392, 84, 130);
	ДобавитьНадпись("НадписьРазрешения", Слева, 106, ШиринаОбласти, "Без «Записи в базу» серверный код агента " +
		"выполняется в транзакции с откатом; код на клиенте - в этой форме, без транзакции.");
	ДобавитьНадпись("НадписьКаталог", Слева, 127, ШиринаОбласти);
	
	ДобавитьНадпись("НадписьРешение", Слева, 154, ШиринаОбласти);
	ПолеКомментария = НовыйЭлемент("ПолеВвода", "Комментарий", Слева, 175, ШиринаОбласти - 156, 46);
	ПолеКомментария.ТипЗначения = Новый ОписаниеТипов("Строка");
	ПолеКомментария.МногострочныйРежим = Истина;
	ДобавитьКнопку("КнопкаОтдать", "Отдать агенту", Слева + ШиринаОбласти - 150, 175, 150);
	ДобавитьКнопку("КнопкаОтказать", "Не отдавать", Слева + ШиринаОбласти - 150, 199, 150);
	
	СтрокиЖурнала = Новый ТаблицаЗначений;
	СтрокиЖурнала.Колонки.Добавить("Время",, "Время", 8);
	СтрокиЖурнала.Колонки.Добавить("Команда",, "Команда", 12);
	СтрокиЖурнала.Колонки.Добавить("Текст",, "Текст", 40);
	СтрокиЖурнала.Колонки.Добавить("Итог",, "Итог", 18);
	СтрокиЖурнала.Колонки.Добавить("Результат",, "Результат", 28);
	СтрокиЖурнала.Колонки.Добавить("Мс",, "мс", 7);
	СтрокиЖурнала.Колонки.Добавить("Идентификатор");
	Журнал = НовыйЭлемент("ТабличноеПоле", "Журнал", Слева, 229, ШиринаОбласти, 200);
	Журнал.ТипЗначения = Новый ОписаниеТипов("ТаблицаЗначений");
	Журнал.Значение = СтрокиЖурнала;
	Журнал.СоздатьКолонки();
	Журнал.Колонки.Найти("Идентификатор").Видимость = Ложь;
	Журнал.ТолькоПросмотр = Истина;
	Журнал.УстановитьДействие("ПриАктивизацииСтроки", Новый Действие("АктивизацияСтрокиЖурнала"));
	
	Подробности = НовыйЭлемент("ПолеТекстовогоДокумента", "Подробности", Слева, 435, ШиринаОбласти,
		ЭтаФорма.Высота - 443);
	Подробности.ТолькоПросмотр = Истина;
	
	ПривязатьКГраницамФормы();
	
КонецПроцедуры

Функция НовыйЭлемент(ВидЭлемента, ИмяЭлемента, Слева, Сверху, ШиринаЭлемента, ВысотаЭлемента)
	
	Элемент = ЭлементыФормы.Добавить(Тип(ВидЭлемента), ИмяЭлемента, Истина);
	Элемент.Лево = Слева;
	Элемент.Верх = Сверху;
	Элемент.Ширина = ШиринаЭлемента;
	Элемент.Высота = ВысотаЭлемента;
	Возврат Элемент;
	
КонецФункции

Функция ДобавитьНадпись(ИмяНадписи, Слева, Сверху, ШиринаНадписи, ТекстНадписи = "")
	
	Надпись = НовыйЭлемент("Надпись", ИмяНадписи, Слева, Сверху, ШиринаНадписи, 19);
	Надпись.Заголовок = ТекстНадписи;
	Возврат Надпись;
	
КонецФункции

Процедура ДобавитьКнопку(ИмяКнопки, ТекстКнопки, Слева, Сверху, ШиринаКнопки)
	
	Кнопка = НовыйЭлемент("Кнопка", ИмяКнопки, Слева, Сверху, ШиринаКнопки, 22);
	Кнопка.Заголовок = ТекстКнопки;
	Кнопка.УстановитьДействие("Нажатие", Новый Действие("НажатиеКнопки"));
	
КонецПроцедуры

Процедура ДобавитьФлажок(ИмяФлажка, ТекстФлажка, Слева, Сверху, ШиринаФлажка)
	
	Флажок = НовыйЭлемент("Флажок", ИмяФлажка, Слева, Сверху, ШиринаФлажка, 19);
	Флажок.ТипЗначения = Новый ОписаниеТипов("Булево");
	Флажок.Заголовок = ТекстФлажка;
	Флажок.УстановитьДействие("ПриИзменении", Новый Действие("ИзменениеФлажка"));
	
КонецПроцедуры

Процедура ПривязатьКГраницамФормы()
	
	// Надписи, журнал и подробности растягиваются вместе с окном, кнопки решения держатся правого края
	Попытка
		ПанельФормы = ЭтаФорма.Панель;
		ПравыйКрай = ГраницаЭлементаУправления.Право;
		Растягиваемые = "НадписьСостояние,НадписьСведения,НадписьРазрешения,НадписьКаталог,НадписьРешение," +
			"Комментарий,Журнал,Подробности";
		Для Каждого ИмяЭлемента Из ЧастиСтроки(Растягиваемые, ",") Цикл
			ЭлементыФормы.Найти(ИмяЭлемента).УстановитьПривязку(ПравыйКрай, ПанельФормы, ПравыйКрай);
		КонецЦикла;
		Для Каждого ИмяЭлемента Из ЧастиСтроки("КнопкаОтдать,КнопкаОтказать", ",") Цикл
			Кнопка = ЭлементыФормы.Найти(ИмяЭлемента);
			Кнопка.УстановитьПривязку(ГраницаЭлементаУправления.Лево, ПанельФормы, ПравыйКрай);
			Кнопка.УстановитьПривязку(ПравыйКрай, ПанельФормы, ПравыйКрай);
		КонецЦикла;
		ЭлементыФормы.Подробности.УстановитьПривязку(ГраницаЭлементаУправления.Низ, ПанельФормы,
			ГраницаЭлементаУправления.Низ);
	Исключение
		// Без привязок элементы не растягиваются вместе с окном, но мост работает
	КонецПопытки;
	
КонецПроцедуры

Процедура ОбновитьЭлементы()
	
	ЖдётРешения = ОжидающийОтвет <> Неопределено;
	ЭлементыФормы.НадписьСостояние.Заголовок = ТекстСостояния();
	ЭлементыФормы.НадписьСостояние.ЦветТекста = ЦветСостояния();
	ЭлементыФормы.НадписьСведения.Заголовок = ТекстСведений();
	ЭлементыФормы.НадписьКаталог.Заголовок = ТекстКаталога();
	ЭлементыФормы.НадписьРешение.Заголовок = ТекстРешения();
	ЭлементыФормы.КнопкаПауза.Заголовок = ?(Приостановлен, "Продолжить", "Приостановить");
	ЭлементыФормы.КнопкаКаталогПоУмолчанию.Доступность = ЗначениеЗаполнено(СвойКаталогОбмена);
	ЭлементыФормы.ФлагСПодтверждением.Значение = РучнаяВыдача;
	ЭлементыФормы.ФлагЗапись.Значение = РазрешитьЗапись;
	ЭлементыФормы.ФлагКодНаКлиенте.Значение = РазрешитьКодНаКлиенте;
	ЭлементыФормы.Комментарий.Доступность = ЖдётРешения;
	ЭлементыФормы.КнопкаОтдать.Доступность = ЖдётРешения;
	ЭлементыФормы.КнопкаОтказать.Доступность = ЖдётРешения;
	
КонецПроцедуры

Функция ТекстСостояния()
	
	Если ЗначениеЗаполнено(ОшибкаМоста) Тогда
		Возврат "Ошибка: " + ОшибкаМоста;
	ИначеЕсли ОжидающийОтвет <> Неопределено Тогда
		Возврат "Ждёт решения: результат команды ждёт вашего решения - отдать его агенту или нет.";
	ИначеЕсли Приостановлен Тогда
		Возврат "Приостановлен: команды агента ждут в очереди, пока вы не продолжите.";
	ИначеЕсли Индексация <> Неопределено Тогда
		Возврат "Индексация: строится индекс метаданных для агента, " + Формат(ПроцентИндексации(), "ЧН=0") +
			"%. Между порциями окно 1С отвечает, команды агента ждут.";
	КонецЕсли;
	Возврат "Готов: ждёт команд агента.";
	
КонецФункции

Функция ЦветСостояния()
	
	Если ЗначениеЗаполнено(ОшибкаМоста) Тогда
		Возврат WebЦвета.Красный;
	ИначеЕсли ОжидающийОтвет <> Неопределено Или Индексация <> Неопределено Тогда
		Возврат WebЦвета.ТемноОранжевый;
	КонецЕсли;
	Возврат Новый Цвет;
	
КонецФункции

Функция ТекстСведений()
	
	Возврат ПредставлениеБазы(ДанныеСеанса.infobase) + ", " + ДанныеСеанса.userFullName + ", сеанс моста " +
		Строка(ИдентификаторСеанса) + ", выполнено команд: " + Формат(ВыполненоКоманд, "ЧН=0; ЧГ=0");
	
КонецФункции

Функция ТекстКаталога()
	
	ТекстНадписи = "Каталог обмена: " + КаталогОбмена();
	Если ЗначениеЗаполнено(СвойКаталогОбмена) Тогда
		ТекстНадписи = ТекстНадписи + " - не стандартный: агент увидит сеанс, только если MCP-серверу задан " +
			"тот же каталог в MCP_1C_BRIDGE_DIR";
	КонецЕсли;
	Возврат ТекстНадписи;
	
КонецФункции

Функция ТекстРешения()
	
	Если ОжидающийОтвет <> Неопределено Тогда
		Возврат "Результат выделен в журнале. Комментарий агенту - необязательно, уйдёт вместе с решением:";
	ИначеЕсли РучнаяВыдача Тогда
		Возврат "Каждый результат сначала покажется здесь и уйдёт агенту только после вашего решения.";
	КонецЕсли;
	Возврат "Результаты уходят агенту сразу. С подтверждением каждый результат сначала покажется здесь.";
	
КонецФункции

Процедура ПоказатьОшибкуМоста(Текст)
	
	Если ОшибкаМоста <> Текст Тогда
		ОшибкаМоста = Текст;
		ОбновитьЭлементы();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПоказатьНовуюЗапись(Запись)
	
	// Новую строку выделяем, если выделена была самая свежая или никакая: иначе пользователь смотрит другую
	Журнал = ЭлементыФормы.Журнал;
	ВыделитьНовую = ОжидающийОтвет <> Неопределено Или Журнал.ТекущаяСтрока = Неопределено
		Или СтрокиЖурнала.Количество() > 0 И Журнал.ТекущаяСтрока = СтрокиЖурнала[0];
	СтрокаЖурнала = СтрокиЖурнала.Вставить(0);
	ЗаполнитьСтрокуЖурнала(СтрокаЖурнала, Запись);
	Пока СтрокиЖурнала.Количество() > 50 Цикл
		СтрокиЖурнала.Удалить(СтрокиЖурнала.Количество() - 1);
	КонецЦикла;
	Если ВыделитьНовую Тогда
		Журнал.ТекущаяСтрока = СтрокаЖурнала;
		ПоказатьПодробности(СтрокаЖурнала);
	КонецЕсли;
	ОбновитьЭлементы();
	
КонецПроцедуры

Процедура ОбновитьЗаписьЖурнала(Запись)
	
	СтрокаЖурнала = СтрокиЖурнала.Найти(Запись.Идентификатор, "Идентификатор");
	Если СтрокаЖурнала = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьСтрокуЖурнала(СтрокаЖурнала, Запись);
	Если ЭлементыФормы.Журнал.ТекущаяСтрока = СтрокаЖурнала Тогда
		ПоказатьПодробности(СтрокаЖурнала);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСтрокуЖурнала(СтрокаЖурнала, Запись)
	
	СтрокаЖурнала.Идентификатор = Запись.Идентификатор;
	СтрокаЖурнала.Время = Формат(Запись.Время, "ДФ=ЧЧ:мм:сс");
	СтрокаЖурнала.Команда = ПредставлениеВида(Запись);
	СтрокаЖурнала.Текст = Запись.Текст;
	СтрокаЖурнала.Итог = ПредставлениеИтога(Запись);
	СтрокаЖурнала.Результат = Запись.Итог;
	СтрокаЖурнала.Мс = Запись.Длительность;
	
КонецПроцедуры

Процедура ПоказатьПодробности(СтрокаЖурнала)
	
	ТекстПодробностей = "";
	Если СтрокаЖурнала <> Неопределено Тогда
		Для Каждого Запись Из ЗаписиЖурнала Цикл
			Если Запись.Идентификатор = СтрокаЖурнала.Идентификатор Тогда
				ТекстПодробностей = ПодробностиЗаписи(Запись);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	ЭлементыФормы.Подробности.УстановитьТекст(ТекстПодробностей);
	
КонецПроцедуры

Функция ПодробностиЗаписи(Запись)
	
	Части = Новый Массив;
	Части.Добавить(СтрокаПоШаблону("Команда %1, %2, %3, %4 мс, %5", Запись.Идентификатор, ПредставлениеВида(Запись),
		Формат(Запись.Время, "ДФ=ЧЧ:мм:сс"), Формат(Запись.Длительность, "ЧН=0; ЧГ=0"), ПредставлениеИтога(Запись)));
	ДобавитьРаздел(Части, "Комментарий агенту", Запись.Комментарий);
	ДобавитьРаздел(Части, "Текст команды", Запись.ПолныйТекст);
	ДобавитьРаздел(Части, "Параметры", Запись.Параметры);
	ДобавитьРаздел(Части, "Результат", Запись.Результат);
	ДобавитьРаздел(Части, "Сообщения", СоединенныеСтроки(Запись.Сообщения, Символы.ПС));
	ДобавитьРаздел(Части, "Ошибка", Запись.Ошибка);
	Возврат СоединенныеСтроки(Части, Символы.ПС);
	
КонецФункции

Процедура ДобавитьРаздел(Части, ИмяРаздела, ТекстРаздела)
	
	Если ЗначениеЗаполнено(ТекстРаздела) Тогда
		Части.Добавить("");
		Части.Добавить(ИмяРаздела + ":");
		Части.Добавить(ТекстРаздела);
	КонецЕсли;
	
КонецПроцедуры

Функция ПредставлениеИтога(Запись)
	
	Если Запись.Статус = "ok" Тогда
		Итог = "выполнена";
	ИначеЕсли Запись.Статус = "error" Тогда
		Итог = "ошибка";
	ИначеЕсли Запись.Статус = "rejected" Тогда
		Итог = "отказ";
	ИначеЕсли Запись.Статус = "expired" Тогда
		Итог = "просрочена";
	Иначе
		Итог = Запись.Статус;
	КонецЕсли;
	Если Запись.Выдача = "ждёт" Тогда
		Итог = Итог + ", ждёт решения";
	ИначеЕсли Запись.Выдача = "отдано" Или Запись.Выдача = "не отдано" Тогда
		Итог = Итог + ", " + Запись.Выдача;
	КонецЕсли;
	Возврат Итог;
	
КонецФункции

Функция ПредставлениеВида(Запись)
	
	Возврат Запись.Вид + ?(Запись.Клиентская, ", клиент", "");
	
КонецФункции

Функция ПредставлениеБазы(СтрокаСоединения)
	
	Свойства = Новый Соответствие;
	Для Каждого Часть Из ЧастиСтроки(СтрокаСоединения, ";", Ложь) Цикл
		Позиция = Найти(Часть, "=");
		Если Позиция > 0 Тогда
			Свойства.Вставить(НРег(Лев(Часть, Позиция - 1)), СтрЗаменить(Сред(Часть, Позиция + 1), """", ""));
		КонецЕсли;
	КонецЦикла;
	Если Свойства.Получить("ref") <> Неопределено Тогда
		Возврат СтрокаПоШаблону("%1 на %2", Свойства.Получить("ref"), Свойства.Получить("srvr"));
	ИначеЕсли Свойства.Получить("file") <> Неопределено Тогда
		Возврат Свойства.Получить("file");
	КонецЕсли;
	Возврат СтрокаСоединения;
	
КонецФункции

Процедура Предупредить(Текст)
	
	// Модальное предупреждение недоступно, если в конфигурации модальность не используется
	Попытка
		Предупреждение(Текст);
	Исключение
		Сообщить(Текст);
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область Действия

Процедура ЗавершитьОжидание(Разрешено)
	
	Если ОжидающийОтвет = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Ответ = ОжидающийОтвет.Ответ;
	ТекстОтвета = ОжидающийОтвет.ТекстОтвета;
	Комментарий = Лев(СокрЛП(Строка(ЭлементыФормы.Комментарий.Значение)), ПределКомментария());
	Если Не Разрешено Тогда
		ОтветБезДанных = Новый Структура;
		ОтветБезДанных.Вставить("protocol", 1);
		ОтветБезДанных.Вставить("id", Ответ.id);
		ОтветБезДанных.Вставить("status", "denied");
		ОтветБезДанных.Вставить("error", "Пользователь не разрешил выдачу результата агенту.");
		ОтветБезДанных.Вставить("durationMs", Ответ.durationMs);
		ТекстОтвета = ТекстJSON(ОтветБезДанных, Ложь);
	КонецЕсли;
	Если ЗначениеЗаполнено(Комментарий) Тогда
		ТекстОтвета = ТекстОтветаСКомментарием(ТекстОтвета, Комментарий);
	КонецЕсли;
	// Файл индекса метаданных пишется только при выдаче: при отказе агент его не получит
	Если Разрешено Тогда
		ЗаписатьФайлИндекса(ОжидающийОтвет.ТекстИндекса);
	КонецЕсли;
	ОтдатьОтвет(Ответ.id, ТекстОтвета, ОжидающийОтвет.ФайлВРаботе);
	Запись = ОжидающийОтвет.Запись;
	Запись.Выдача = ?(Разрешено, "отдано", "не отдано");
	Запись.Комментарий = Комментарий;
	ОжидающийОтвет = Неопределено;
	ЭлементыФормы.Комментарий.Значение = "";
	ОбновитьЗаписьЖурнала(Запись);
	
КонецПроцедуры

Функция ТекстОтветаСКомментарием(ТекстОтвета, Комментарий)
	
	// Ответ уже записан в JSON: поле дописывается в начало объекта, без повторной записи результата
	Возврат "{""comment"":" + ТекстJSON(Комментарий, Ложь) + "," + Сред(ТекстОтвета, 2);
	
КонецФункции

Процедура СкопироватьИдентификаторСеанса()
	
	Если ПомещенВБуферОбмена(ИдентификаторСеанса) Тогда
		ПоказатьОповещениеПользователя("Идентификатор сеанса моста скопирован",, ИдентификаторСеанса);
	Иначе
		// Буфер обмена недоступен: из окна сообщений идентификатор можно скопировать вручную
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Скопировать в буфер обмена не удалось. Идентификатор сеанса моста: " + ИдентификаторСеанса;
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры

Функция ПомещенВБуферОбмена(Текст)
	
	// Средства буфера обмена есть с платформы 8.3.24, а обработка компилируется и в режимах совместимости 8.3.14
	// и 8.2: обращение к ним - через Вычислить. На платформах старее - объект htmlfile из Windows
	Попытка
		СредстваБуфера = Вычислить("СредстваБуфераОбмена");
		Если СредстваБуфера.ИспользованиеДоступно() Тогда
			ЭлементБуфера = Вычислить("Новый ЭлементБуфераОбмена(СтандартныйФорматДанныхБуфераОбмена.Текст, Текст)");
			СредстваБуфера.ПоместитьДанныеАсинх(ЭлементБуфера);
			Возврат Истина;
		КонецЕсли;
	Исключение
		// Средств буфера обмена нет: платформа старее 8.3.24 или их скрывает режим совместимости
	КонецПопытки;
	Попытка
		ДокументHTML = Новый COMОбъект("htmlfile");
		ДокументHTML.parentWindow.clipboardData.setData("Text", Текст);
		Возврат Истина;
	Исключение
		// COM недоступен: не Windows или запрет политикой
	КонецПопытки;
	Возврат Ложь;
	
КонецФункции

Процедура ВыбратьКаталогОбмена()
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = "Каталог обмена с MCP-сервером";
	Диалог.Каталог = КаталогОбмена();
	// В обычном приложении диалог модальный: пока он открыт, опрос стоит, и MCP видит сеанс молчащим
	Попытка
		Выбран = Диалог.Выбрать();
	Исключение
		Предупредить("Каталог обмена не выбран: " + ИнформацияОбОшибке().Описание);
		Возврат;
	КонецПопытки;
	Если Выбран Тогда
		СменитьКаталогОбмена(Диалог.Каталог);
	КонецЕсли;
	
КонецПроцедуры

Процедура СменитьКаталогОбмена(Каталог)
	
	// Ответ на команду, ждущую решения, пишется в каталог сеанса, где его ждёт MCP
	Если ОжидающийОтвет <> Неопределено Тогда
		Предупредить("Каталог обмена не сменён: сначала решите, отдавать ли агенту результат.");
		Возврат;
	КонецЕсли;
	Если Индексация <> Неопределено Тогда
		Предупредить("Каталог обмена не сменён: дождитесь окончания индексации метаданных.");
		Возврат;
	КонецЕсли;
	
	НовыйСвойКаталог = КаталогДляНастройки(Каталог);
	Если НРег(НовыйСвойКаталог) = НРег(СвойКаталогОбмена) И Не ЗначениеЗаполнено(ОшибкаМоста) Тогда
		Возврат;
	КонецЕсли;
	
	ПрежнийСвойКаталог = СвойКаталогОбмена;
	ПрежнийКаталогСеанса = КаталогСеанса;
	ПрежнийИдентификатор = ИдентификаторСеанса;
	СвойКаталогОбмена = НовыйСвойКаталог;
	Попытка
		ПодготовитьКаталогСеанса();
		ЗаписатьСведенияСеанса();
	Исключение
		Описание = ИнформацияОбОшибке().Описание;
		Если КаталогСеанса <> ПрежнийКаталогСеанса Тогда
			УдалитьКаталогСеанса(КаталогСеанса);
		КонецЕсли;
		СвойКаталогОбмена = ПрежнийСвойКаталог;
		КаталогСеанса = ПрежнийКаталогСеанса;
		ИдентификаторСеанса = ПрежнийИдентификатор;
		ДанныеСеанса.Вставить("session", ИдентификаторСеанса);
		ДанныеСеанса.Вставить("path", КаталогСеанса);
		Предупредить("Каталог обмена не сменён: " + Описание);
		Возврат;
	КонецПопытки;
	
	// Сеанс переехал под новым идентификатором; команды, не начатые в прежнем каталоге, агент пошлёт заново
	УдалитьКаталогСеанса(ПрежнийКаталогСеанса);
	ОшибкаМоста = "";
	// После неудачного открытия формы опрос не запускался, а если он идёт - второй обработчик не нужен
	ЭтаФорма.ОтключитьОбработчикОжидания("ОбработатьОчередь");
	ЗапланироватьОпрос();
	
	Попытка
		СохранитьКаталогОбмена(СвойКаталогОбмена);
	Исключение
		Предупредить("Каталог обмена сменён, но запомнить его не удалось: " + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область Опрос

Процедура ЗапланироватьОпрос()
	
	// Интервал меньше секунды допускается только для однократного обработчика: он подключается на каждом опросе
	ЭтаФорма.ПодключитьОбработчикОжидания("ОбработатьОчередь", 0.5, Истина);
	
КонецПроцедуры

Процедура ВыполнитьВходящиеКоманды()
	
	Файлы = НайтиФайлы(КаталогСеанса + "in", "*.json");
	Если Файлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Идентификаторы команд начинаются с момента создания: порядок имён - порядок поступления
	Имена = Новый СписокЗначений;
	Для Каждого ФайлКоманды Из Файлы Цикл
		Имена.Добавить(ФайлКоманды.Имя);
	КонецЦикла;
	Имена.СортироватьПоЗначению();
	
	Для Каждого ЭлементСписка Из Имена Цикл
		Если ОжидающийОтвет <> Неопределено Или Приостановлен Или Индексация <> Неопределено Тогда
			Прервать;
		КонецЕсли;
		ВыполнитьКомандуИзФайла(ЭлементСписка.Значение);
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыполнитьКомандуИзФайла(ИмяФайла)
	
	Разделитель = ПолучитьРазделительПути();
	ИдентификаторКоманды = Лев(ИмяФайла, СтрДлина(ИмяФайла) - СтрДлина(".json"));
	ФайлВРаботе = КаталогСеанса + "work" + Разделитель + ИмяФайла;
	Попытка
		ПереместитьФайл(КаталогСеанса + "in" + Разделитель + ИмяФайла, ФайлВРаботе);
	Исключение
		// Команду успел снять MCP: истёк срок, за который её нужно было начать
		Возврат;
	КонецПопытки;
	
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Команда = Неопределено;
	Попытка
		Команда = ДанныеФайлаJSON(ФайлВРаботе);
		Ответ = ОтветМоста(Команда, ИдентификаторКоманды, ФайлВРаботе);
	Исключение
		Ответ = ОтветОбОшибке(ИнформацияОбОшибке());
	КонецПопытки;
	// Индекс метаданных строится порциями в следующих опросах: ответ будет, когда построение закончится
	Если Ответ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗавершитьКоманду(ИдентификаторКоманды, Команда, Ответ, ФайлВРаботе, Начало);
	
КонецПроцедуры

Процедура ЗавершитьКоманду(ИдентификаторКоманды, Команда, Ответ, ФайлВРаботе, Начало)
	
	// Текст индекса метаданных уходит агенту отдельным файлом, а не в ответе
	ТекстИндекса = "";
	Если Ответ.Свойство("indexText") Тогда
		ТекстИндекса = Ответ.indexText;
		Ответ.Удалить("indexText");
	КонецЕсли;
	Ответ.Вставить("protocol", 1);
	Ответ.Вставить("id", ИдентификаторКоманды);
	Ответ.Вставить("durationMs", ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало);
	ТекстОтвета = ТекстОтветаДляФайла(Ответ);
	
	ВыполненоКоманд = ВыполненоКоманд + 1;
	ОшибкаМоста = "";
	Запись = НоваяЗаписьЖурнала(ИдентификаторКоманды, Команда, Ответ, ТекстОтвета);
	ЗаписиЖурнала.Вставить(0, Запись);
	Пока ЗаписиЖурнала.Количество() > 50 Цикл
		ЗаписиЖурнала.Удалить(ЗаписиЖурнала.ВГраница());
	КонецЦикла;
	
	// В ручном режиме ответ ждёт решения пользователя; не начатую вовремя команду решать нечего
	Если РучнаяВыдача И Ответ.status <> "expired" Тогда
		Запись.Выдача = "ждёт";
		ОжидающийОтвет = Новый Структура;
		ОжидающийОтвет.Вставить("Ответ", Ответ);
		ОжидающийОтвет.Вставить("ТекстОтвета", ТекстОтвета);
		ОжидающийОтвет.Вставить("ТекстИндекса", ТекстИндекса);
		ОжидающийОтвет.Вставить("Запись", Запись);
		ОжидающийОтвет.Вставить("ФайлВРаботе", ФайлВРаботе);
		ЭлементыФормы.Комментарий.Значение = "";
		ОбновитьСердцебиение();
		ПоказатьНовуюЗапись(Запись);
		ПоказатьОповещениеПользователя("Мост MCP: результат ждёт решения",, Запись.Текст);
		Активизировать();
		Возврат;
	КонецЕсли;
	
	ЗаписатьФайлИндекса(ТекстИндекса);
	ОтдатьОтвет(ИдентификаторКоманды, ТекстОтвета, ФайлВРаботе);
	Запись.Выдача = "авто";
	ОбновитьСердцебиение();
	ПоказатьНовуюЗапись(Запись);
	
КонецПроцедуры

Функция ТекстОтветаДляФайла(Ответ)
	
	Попытка
		Возврат ТекстJSON(Ответ, Ложь);
	Исключение
		// Результат не записался в JSON: агент получит ошибку вместо него
		ОтветСОшибкой = ОтветОбОшибке(ИнформацияОбОшибке());
		ОтветСОшибкой.Вставить("protocol", 1);
		ОтветСОшибкой.Вставить("id", Ответ.id);
		ОтветСОшибкой.Вставить("durationMs", Ответ.durationMs);
		Возврат ТекстJSON(ОтветСОшибкой, Ложь);
	КонецПопытки;
	
КонецФункции

Функция ОтветМоста(Команда, ИдентификаторКоманды, ФайлВРаботе)
	
	Если КомандаПросрочена(Команда, ФайлВРаботе) Тогда
		Ответ = Новый Структура;
		Ответ.Вставить("status", "expired");
		Ответ.Вставить("error", "Команда не начата в отведённый срок.");
		Возврат Ответ;
	КонецЕсли;
	
	ОбновитьСердцебиение(ИдентификаторКоманды);
	Вид = Команда.Получить("type");
	Если Вид = "index" Тогда
		Возврат ОтветИндекса(Команда, ИдентификаторКоманды, ФайлВРаботе);
	КонецЕсли;
	Если Команда.Получить("side") = "client" И (Вид = "eval" Или Вид = "execute") Тогда
		Возврат ОтветКлиентскогоВыполнения(Команда);
	КонецЕсли;
	// В толстом клиенте обычного приложения модуль объекта выполняется здесь же, без вызова сервера
	Возврат ЭтотОбъект.ОтветНаКоманду(Команда, РазрешитьЗапись);
	
КонецФункции

Функция КомандаПросрочена(Команда, ФайлВРаботе)
	
	Срок = Команда.Получить("ttlSec");
	Если ТипЗнч(Срок) <> Тип("Число") Или Срок <= 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	// Время изменения ставит Windows при записи файла MCP, перемещение его не меняет
	ФайлКоманды = Новый Файл(ФайлВРаботе);
	Возврат ТекущаяУниверсальнаяДата() - ФайлКоманды.ПолучитьУниверсальноеВремяИзменения() > Срок;
	
КонецФункции

Функция ОтветКлиентскогоВыполнения(Команда)
	
	Ответ = Новый Структура;
	Если Не РазрешитьКодНаКлиенте Тогда
		Ответ.Вставить("status", "rejected");
		Ответ.Вставить("error", "Код на клиенте не разрешён: на форме обработки выключен «Код на клиенте».");
		Возврат Ответ;
	КонецЕсли;
	
	// Код на клиенте видит переменные этой формы: разрешения и режим восстанавливаются после него
	БылаЗапись = РазрешитьЗапись;
	БылРучнойРежим = РучнаяВыдача;
	Попытка
		Если Команда.Получить("type") = "eval" Тогда
			Значение = ЗначениеВыраженияНаКлиенте(Команда.Получить("expression"));
		Иначе
			Значение = ЗначениеКодаНаКлиенте(Команда.Получить("code"));
		КонецЕсли;
	Исключение
		РазрешитьЗапись = БылаЗапись;
		РучнаяВыдача = БылРучнойРежим;
		РазрешитьКодНаКлиенте = Истина;
		Возврат ОтветОбОшибке(ИнформацияОбОшибке());
	КонецПопытки;
	РазрешитьЗапись = БылаЗапись;
	РучнаяВыдача = БылРучнойРежим;
	РазрешитьКодНаКлиенте = Истина;
	
	Ответ.Вставить("status", "ok");
	Ответ.Вставить("result", ЗначениеДляОтвета(Значение));
	Возврат Ответ;
	
КонецФункции

Функция ЗначениеВыраженияНаКлиенте(Выражение)
	
	Возврат Вычислить(Выражение);
	
КонецФункции

Функция ЗначениеКодаНаКлиенте(Код)
	
	Результат = Неопределено;
	Выполнить(Код);
	Возврат Результат;
	
КонецФункции

Функция ЗначениеДляОтвета(Значение)
	
	Попытка
		Возврат ЭтотОбъект.ЗначениеДляJSON(Значение);
	Исключение
		// Значение не удалось разобрать: агент получит тип и представление
	КонецПопытки;
	
	Описание = Новый Структура;
	Описание.Вставить("_type", Строка(ТипЗнч(Значение)));
	Попытка
		Описание.Вставить("_presentation", Строка(Значение));
	Исключение
		Описание.Вставить("_presentation", "");
	КонецПопытки;
	Возврат Описание;
	
КонецФункции

Функция ОтветОбОшибке(Информация)
	
	Ответ = Новый Структура;
	Ответ.Вставить("status", "error");
	Ответ.Вставить("error", Информация.Описание);
	Ответ.Вставить("errorDetails", ПодробноеПредставлениеОшибки(Информация));
	Возврат Ответ;
	
КонецФункции

#КонецОбласти

#Область ИндексМетаданных

Функция ОтветИндекса(Команда, ИдентификаторКоманды, ФайлВРаботе)
	
	Сведения = ЭтотОбъект.СведенияИндекса(Команда.Получить("refresh") = Истина);
	Если ЗначениеЗаполнено(Сведения.Текст) Тогда
		Возврат ОтветСИндексом(Сведения, "saved", "");
	КонецЕсли;
	
	// Индекс строится порциями в следующих опросах, чтобы окно 1С между ними отвечало: ответа пока нет
	Индексация = Новый Структура;
	Индексация.Вставить("Команда", Команда);
	Индексация.Вставить("Идентификатор", ИдентификаторКоманды);
	Индексация.Вставить("ФайлВРаботе", ФайлВРаботе);
	Индексация.Вставить("Начало", ТекущаяУниверсальнаяДатаВМиллисекундах());
	Индексация.Вставить("Сведения", Сведения);
	Индексация.Вставить("Части", Новый Массив);
	Индексация.Вставить("НомерКоллекции", 0);
	Индексация.Вставить("Позиция", 0);
	Индексация.Вставить("Описано", 0);
	Индексация.Вставить("Всего", ОбъектовВКоллекциях(Сведения.Коллекции));
	Индексация.Вставить("Объектов", 0);
	Индексация.Вставить("Полей", 0);
	ОбновитьЭлементы();
	Возврат Неопределено;
	
КонецФункции

Процедура ПродолжитьИндексацию()
	
	Попытка
		Если Индексация.НомерКоллекции < Индексация.Сведения.Коллекции.Количество() Тогда
			ДобавитьПорциюИндекса();
			ОбновитьСердцебиение();
			ОбновитьЭлементы();
			Возврат;
		КонецЕсли;
		Ответ = ОтветПостроенногоИндекса();
	Исключение
		// Ошибка порции завершает команду ответом с ошибкой: мост не остаётся занятым
		Ответ = ОтветОбОшибке(ИнформацияОбОшибке());
	КонецПопытки;
	
	Завершенная = Индексация;
	Индексация = Неопределено;
	ЗавершитьКоманду(Завершенная.Идентификатор, Завершенная.Команда, Ответ, Завершенная.ФайлВРаботе,
		Завершенная.Начало);
	
КонецПроцедуры

Процедура ДобавитьПорциюИндекса()
	
	Коллекция = Индексация.Сведения.Коллекции[Индексация.НомерКоллекции];
	Порция = ЭтотОбъект.ПорцияИндекса(Коллекция.Имя, Индексация.Позиция, БюджетПорцииМс());
	Индексация.Части.Добавить(Порция.Текст);
	Индексация.Описано = Индексация.Описано + Порция.Описано;
	Индексация.Объектов = Индексация.Объектов + Порция.Объектов;
	Индексация.Полей = Индексация.Полей + Порция.Полей;
	Если Порция.Следующий = 0 Тогда
		Индексация.НомерКоллекции = Индексация.НомерКоллекции + 1;
		Индексация.Позиция = 0;
	Иначе
		Индексация.Позиция = Порция.Следующий;
	КонецЕсли;
	
КонецПроцедуры

Функция ОтветПостроенногоИндекса()
	
	Сведения = Индексация.Сведения;
	Сведения.Построен = ТекущаяУниверсальнаяДата();
	Сведения.Объектов = Индексация.Объектов;
	Сведения.Полей = Индексация.Полей;
	Сведения.Текст = ТекстИндекса(Сведения, Индексация.Части);
	
	Замечание = "";
	Попытка
		ЭтотОбъект.СохранитьИндекс(Сведения);
	Исключение
		// Агент получит индекс и без сохранения, но в следующий раз он будет построен заново
		Замечание = "Индекс не сохранён в настройках пользователя, в следующий раз он будет построен заново: " +
			ИнформацияОбОшибке().Описание;
	КонецПопытки;
	Возврат ОтветСИндексом(Сведения, "built", Замечание);
	
КонецФункции

Функция ТекстИндекса(Сведения, Части)
	
	// Не «Заголовок»: в модуле формы так называется заголовок самой формы
	ЗаголовокИндекса = Сведения.Заголовок;
	ЗаголовокИндекса.Вставить("built", XMLСтрока(Сведения.Построен));
	ЗаголовокИндекса.Вставить("objects", Сведения.Объектов);
	ЗаголовокИндекса.Вставить("fields", Сведения.Полей);
	ТекстЗаголовка = ТекстJSON(ЗаголовокИндекса, Ложь);
	// Порции уже записаны в JSON модулем объекта: массив порций дописывается в конец объекта заголовка
	Возврат Лев(ТекстЗаголовка, СтрДлина(ТекстЗаголовка) - 1) + ",""parts"":[" + СоединенныеСтроки(Части, ",") + "]}";
	
КонецФункции

Функция ОтветСИндексом(Сведения, Источник, Замечание)
	
	Результат = Новый Структура;
	Результат.Вставить("file", ИмяФайлаИндекса());
	Результат.Вставить("source", Источник);
	Результат.Вставить("fingerprint", Сведения.Отпечаток);
	Результат.Вставить("built", XMLСтрока(Сведения.Построен));
	Результат.Вставить("objects", Сведения.Объектов);
	Результат.Вставить("fields", Сведения.Полей);
	
	Ответ = Новый Структура;
	Ответ.Вставить("status", "ok");
	Ответ.Вставить("result", Результат);
	// Текст индекса не входит в ответ: при выдаче агенту он пишется отдельным файлом в каталог сеанса
	Ответ.Вставить("indexText", Сведения.Текст);
	Если ЗначениеЗаполнено(Замечание) Тогда
		Замечания = Новый Массив;
		Замечания.Добавить(Замечание);
		Ответ.Вставить("warnings", Замечания);
	КонецЕсли;
	Возврат Ответ;
	
КонецФункции

Процедура ЗаписатьФайлИндекса(ТекстИндекса)
	
	Если ЗначениеЗаполнено(ТекстИндекса) Тогда
		ЗаписатьТекстовыйФайл(КаталогСеанса + ИмяФайлаИндекса(), ТекстИндекса);
	КонецЕсли;
	
КонецПроцедуры

Функция ИмяФайлаИндекса()
	
	Возврат "index.json";
	
КонецФункции

Функция БюджетПорцииМс()
	
	// Сколько описываются объекты за один опрос; между порциями окно 1С отвечает пользователю
	Возврат 1000;
	
КонецФункции

Функция ОбъектовВКоллекциях(Коллекции)
	
	Всего = 0;
	Для Каждого Коллекция Из Коллекции Цикл
		Всего = Всего + Коллекция.Количество;
	КонецЦикла;
	Возврат Всего;
	
КонецФункции

Функция ПроцентИндексации()
	
	Если Индексация.Всего = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Цел(Индексация.Описано * 100 / Индексация.Всего);
	
КонецФункции

#КонецОбласти

#Область Файлы

Процедура ПодготовитьКаталогСеанса()
	
	Разделитель = ПолучитьРазделительПути();
	Корень = КаталогОбмена();
	Если Прав(Корень, 1) <> Разделитель Тогда
		Корень = Корень + Разделитель;
	КонецЕсли;
	
	ИдентификаторСеанса = НРег(Лев(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""), 8));
	КаталогСеанса = Корень + ИдентификаторСеанса + Разделитель;
	СоздатьКаталог(КаталогСеанса + "in");
	СоздатьКаталог(КаталогСеанса + "work");
	СоздатьКаталог(КаталогСеанса + "out");
	
	ДанныеСеанса.Вставить("session", ИдентификаторСеанса);
	ДанныеСеанса.Вставить("path", КаталогСеанса);
	
КонецПроцедуры

Процедура УдалитьКаталогСеанса(Каталог)
	
	Если Не ЗначениеЗаполнено(Каталог) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		УдалитьФайлы(Лев(Каталог, СтрДлина(Каталог) - 1));
	Исключение
		// Каталог молчащего сеанса через сутки удалит MCP-сервер, который работает с этим каталогом обмена
	КонецПопытки;
	
КонецПроцедуры

Функция КаталогОбмена()
	
	Возврат ?(ЗначениеЗаполнено(СвойКаталогОбмена), СвойКаталогОбмена, СтандартныйКаталогОбмена());
	
КонецФункции

Функция СтандартныйКаталогОбмена()
	
	// Здесь же сеансы ищет MCP-сервер, если ему не задан MCP_1C_BRIDGE_DIR
	КаталогВременных = КаталогВременныхФайлов();
	Если Прав(КаталогВременных, 1) <> ПолучитьРазделительПути() Тогда
		КаталогВременных = КаталогВременных + ПолучитьРазделительПути();
	КонецЕсли;
	Возврат КаталогВременных + "mcp-1c-local-bridge";
	
КонецФункции

Функция КаталогДляНастройки(Каталог)
	
	// Стандартный каталог в настройке не хранится: пустое значение и означает каталог по умолчанию
	Результат = СокрЛП(Каталог);
	Если СтрДлина(Результат) > 3 И Прав(Результат, 1) = ПолучитьРазделительПути() Тогда
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЕсли;
	Если НРег(Результат) = НРег(СтандартныйКаталогОбмена()) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

Процедура ОбновитьСердцебиение(КомандаВРаботе = "")
	
	Если Не ЗначениеЗаполнено(КаталогСеанса) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ЗаписатьСведенияСеанса(КомандаВРаботе);
	Исключение
		// session.json мог быть открыт MCP на чтение: запишем при следующем опросе
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаписатьСведенияСеанса(КомандаВРаботе = "")
	
	Прогресс = "";
	Если ЗначениеЗаполнено(КомандаВРаботе) Тогда
		СостояниеСеанса = "busy";
		ТекущаяКоманда = КомандаВРаботе;
	ИначеЕсли ОжидающийОтвет <> Неопределено Тогда
		СостояниеСеанса = "awaiting";
		ТекущаяКоманда = ОжидающийОтвет.Ответ.id;
	ИначеЕсли Приостановлен Тогда
		СостояниеСеанса = "paused";
		ТекущаяКоманда = "";
	ИначеЕсли Индексация <> Неопределено Тогда
		СостояниеСеанса = "busy";
		ТекущаяКоманда = Индексация.Идентификатор;
		Прогресс = "индекс метаданных: " + Формат(ПроцентИндексации(), "ЧН=0") + "%";
	Иначе
		СостояниеСеанса = "ready";
		ТекущаяКоманда = "";
	КонецЕсли;
	
	ДанныеСеанса.Вставить("state", СостояниеСеанса);
	ДанныеСеанса.Вставить("busyCommand", ТекущаяКоманда);
	ДанныеСеанса.Вставить("progress", Прогресс);
	ДанныеСеанса.Вставить("heartbeat", XMLСтрока(ТекущаяУниверсальнаяДата()));
	ДанныеСеанса.Вставить("mode", ?(РучнаяВыдача, "manual", "auto"));
	ДанныеСеанса.Вставить("allowWrite", РазрешитьЗапись);
	ДанныеСеанса.Вставить("allowClientCode", РазрешитьКодНаКлиенте);
	ДанныеСеанса.Вставить("commandsDone", ВыполненоКоманд);
	ЗаписатьТекстовыйФайл(КаталогСеанса + "session.json", ТекстJSON(ДанныеСеанса, Ложь));
	МоментСердцебиения = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
КонецПроцедуры

Процедура ОтдатьОтвет(Идентификатор, ТекстОтвета, ФайлВРаботе)
	
	ИмяБезРасширения = КаталогСеанса + "out" + ПолучитьРазделительПути() + Идентификатор;
	// Ответ пишется во временный файл и переименовывается: MCP не увидит его недописанным
	ЗаписатьТекстовыйФайл(ИмяБезРасширения + ".tmp", ТекстОтвета);
	ПереместитьФайл(ИмяБезРасширения + ".tmp", ИмяБезРасширения + ".json");
	
	Попытка
		УдалитьФайлы(ФайлВРаботе);
	Исключение
		// MCP ориентируется на файл ответа, оставшийся файл команды работе не мешает
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаписатьТекстовыйФайл(ИмяФайла, Текст)
	
	Запись = Новый ЗаписьТекста(ИмяФайла, КодировкаТекста.UTF8);
	Попытка
		Запись.Записать(Текст);
	Исключение
		Запись.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Запись.Закрыть();
	
КонецПроцедуры

Функция ТекстJSON(Данные, СПереносами)
	
	Перенос = ?(СПереносами, ПереносСтрокJSON.Авто, ПереносСтрокJSON.Нет);
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(Перенос, " "));
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
	
КонецФункции

Функция ДанныеФайлаJSON(ИмяФайла)
	
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(ИмяФайла, "UTF-8");
	Попытка
		Данные = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Чтение.Закрыть();
	Возврат Данные;
	
КонецФункции

Функция СведенияСеанса()
	
	// В толстом клиенте обычного приложения код сервера выполняется в том же процессе: версия одна
	Система = Новый СистемнаяИнформация;
	Сведения = Новый Структура;
	Сведения.Вставить("protocol", 1);
	Сведения.Вставить("bridgeVersion", "1.5.0");
	Сведения.Вставить("application", "ordinary");
	Сведения.Вставить("infobase", СтрокаСоединенияИнформационнойБазы());
	Сведения.Вставить("user", ИмяПользователя());
	Сведения.Вставить("userFullName", ПолноеИмяПользователя());
	Сведения.Вставить("sessionNumber", НомерСеансаИнформационнойБазы());
	Сведения.Вставить("configuration", Метаданные.Имя);
	Сведения.Вставить("configurationSynonym", Метаданные.Синоним);
	Сведения.Вставить("configurationVersion", Метаданные.Версия);
	Сведения.Вставить("compatibilityMode", Строка(Метаданные.РежимСовместимости));
	Сведения.Вставить("platform", Система.ВерсияПриложения);
	Сведения.Вставить("serverPlatform", Система.ВерсияПриложения);
	Сведения.Вставить("started", XMLСтрока(ТекущаяУниверсальнаяДата()));
	Возврат Сведения;
	
КонецФункции

Функция СохраненныйКаталогОбмена()
	
	Каталог = ХранилищеОбщихНастроек.Загрузить("MCPLocalBridge", "КаталогОбмена");
	Возврат ?(ТипЗнч(Каталог) = Тип("Строка"), Каталог, "");
	
КонецФункции

Процедура СохранитьКаталогОбмена(Каталог)
	
	// Пустая строка - каталог по умолчанию
	ХранилищеОбщихНастроек.Сохранить("MCPLocalBridge", "КаталогОбмена", Каталог);
	
КонецПроцедуры

#КонецОбласти

#Область Журнал

Функция НоваяЗаписьЖурнала(ИдентификаторКоманды, Команда, Ответ, ТекстОтвета)
	
	Вид = "";
	Клиентская = Ложь;
	ТекстКоманды = "";
	ТекстПараметров = "";
	Если ТипЗнч(Команда) = Тип("Соответствие") Тогда
		Вид = Строка(Команда.Получить("type"));
		Клиентская = Команда.Получить("side") = "client";
		ТекстКоманды = ПолныйТекстКоманды(Команда);
		ПараметрыКоманды = Команда.Получить("params");
		Если ПараметрыКоманды <> Неопределено Тогда
			ТекстПараметров = ТекстJSON(ПараметрыКоманды, Истина);
		КонецЕсли;
	КонецЕсли;
	
	Ошибка = "";
	Если Не Ответ.Свойство("errorDetails", Ошибка) Тогда
		Ответ.Свойство("error", Ошибка);
	КонецЕсли;
	Сообщения = Новый Массив;
	Ответ.Свойство("messages", Сообщения);
	
	Запись = Новый Структура;
	Запись.Вставить("Идентификатор", ИдентификаторКоманды);
	Запись.Вставить("Время", ТекущаяДата());
	Запись.Вставить("Вид", Вид);
	Запись.Вставить("Клиентская", Клиентская);
	Запись.Вставить("Текст", ОднойСтрокой(ТекстКоманды, 300));
	Запись.Вставить("ПолныйТекст", НачалоТекста(ТекстКоманды));
	Запись.Вставить("Параметры", НачалоТекста(ТекстПараметров));
	Запись.Вставить("Статус", Ответ.status);
	Запись.Вставить("Итог", ОднойСтрокой(КраткийРезультат(Вид, Ответ), 300));
	Запись.Вставить("Длительность", Ответ.durationMs);
	Запись.Вставить("Результат", ПредставлениеРезультата(Ответ, ТекстОтвета));
	Запись.Вставить("Ошибка", НачалоТекста(Строка(Ошибка)));
	Запись.Вставить("Сообщения", ?(ТипЗнч(Сообщения) = Тип("Массив"), Сообщения, Новый Массив));
	Запись.Вставить("Выдача", "");
	Запись.Вставить("Комментарий");
	Возврат Запись;
	
КонецФункции

Функция ПолныйТекстКоманды(Команда)
	
	Если Команда.Получить("type") = "index" Тогда
		Возврат ?(Команда.Получить("refresh") = Истина, "Построить индекс метаданных заново", "Индекс метаданных");
	КонецЕсли;
	Для Каждого Ключ Из ЧастиСтроки("text,expression,code,path", ",") Цикл
		Текст = Команда.Получить(Ключ);
		Если ЗначениеЗаполнено(Текст) Тогда
			Возврат Строка(Текст);
		КонецЕсли;
	КонецЦикла;
	Отбор = Команда.Получить("filter");
	Если ЗначениеЗаполнено(Отбор) Тогда
		Возврат "Отбор: " + Отбор;
	КонецЕсли;
	Возврат "";
	
КонецФункции

Функция КраткийРезультат(Вид, Ответ)
	
	Если Ответ.status <> "ok" Тогда
		Ошибка = "";
		Ответ.Свойство("error", Ошибка);
		Возврат ПерваяСтрока(Строка(Ошибка));
	КонецЕсли;
	
	Результат = Неопределено;
	Ответ.Свойство("result", Результат);
	Если Вид = "query" Тогда
		Возврат ИтогЗапроса(Результат);
	ИначеЕсли Вид = "ping" Тогда
		Возврат "связь есть";
	ИначеЕсли Вид = "metadata" И ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("collections") Тогда
		Количество = 0;
		Для Каждого Коллекция Из Результат.collections Цикл
			Количество = Количество + Коллекция.objects.Количество();
		КонецЦикла;
		Возврат "объектов: " + Формат(Количество, "ЧН=0; ЧГ=0");
	ИначеЕсли Вид = "index" И ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("objects") Тогда
		Источник = ?(Результат.source = "saved", "из настроек пользователя", "построен заново");
		Возврат Источник + ", объектов: " + Формат(Результат.objects, "ЧН=0; ЧГ=0");
	КонецЕсли;
	Возврат ПредставлениеЗначения(Результат);
	
КонецФункции

Функция ИтогЗапроса(Результат)
	
	Если ТипЗнч(Результат) <> Тип("Структура") Или Не Результат.Свойство("results") Тогда
		Возврат "";
	КонецЕсли;
	Последний = Неопределено;
	Для Каждого Таблица Из Результат.results Цикл
		Если Таблица <> Неопределено Тогда
			Последний = Таблица;
		КонецЕсли;
	КонецЦикла;
	Если Последний = Неопределено Тогда
		Возврат "без результата";
	КонецЕсли;
	
	Строк = Формат(Последний.total, "ЧН=0; ЧГ=0");
	Если Результат.results.Количество() > 1 Тогда
		Возврат СтрокаПоШаблону("запросов: %1, в последнем строк: %2",
			Формат(Результат.results.Количество(), "ЧГ=0"), Строк);
	КонецЕсли;
	Возврат "строк: " + Строк;
	
КонецФункции

Функция ПредставлениеЗначения(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	Если Значение = Неопределено Тогда
		Возврат "Неопределено";
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧН=0; ЧГ=0");
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат ?(Значение, "Истина", "Ложь");
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		Возврат "массив, элементов: " + Формат(Значение.Количество(), "ЧН=0; ЧГ=0");
	ИначеЕсли ТипЗначения = Тип("Структура") И Значение.Свойство("_presentation") Тогда
		Возврат Строка(Значение._presentation);
	ИначеЕсли ТипЗначения = Тип("Структура") И Значение.Свойство("rows") И Значение.Свойство("total") Тогда
		Возврат "таблица, строк: " + Формат(Значение.total, "ЧН=0; ЧГ=0");
	ИначеЕсли ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("Соответствие") Тогда
		Поля = Новый Массив;
		Для Каждого КлючИЗначение Из Значение Цикл
			Если Поля.Количество() = 6 Тогда
				Поля.Добавить("...");
				Прервать;
			КонецЕсли;
			Поля.Добавить(Строка(КлючИЗначение.Ключ) + ": " + КраткоеЗначение(КлючИЗначение.Значение));
		КонецЦикла;
		Возврат СоединенныеСтроки(Поля, ", ");
	КонецЕсли;
	Возврат Строка(Значение);
	
КонецФункции

Функция КраткоеЗначение(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Структура") И Значение.Свойство("_presentation") Тогда
		Возврат Лев(Строка(Значение._presentation), 40);
	ИначеЕсли ТипЗначения = Тип("Структура") И Значение.Свойство("rows") И Значение.Свойство("total") Тогда
		Возврат "таблица(" + Формат(Значение.total, "ЧН=0; ЧГ=0") + ")";
	ИначеЕсли ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("Соответствие") Тогда
		Возврат "{...}";
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		Возврат "[" + Формат(Значение.Количество(), "ЧН=0; ЧГ=0") + "]";
	КонецЕсли;
	Возврат Лев(ПредставлениеЗначения(Значение), 40);
	
КонецФункции

Функция ПредставлениеРезультата(Ответ, ТекстОтвета)
	
	Результат = Неопределено;
	Если Не Ответ.Свойство("result", Результат) Тогда
		Возврат "";
	КонецЕсли;
	// Большой результат второй раз не форматируем: показываем начало ответа в том виде, как он ушёл агенту
	Если СтрДлина(ТекстОтвета) > ПределТекста() Тогда
		Возврат НачалоТекста(ТекстОтвета);
	КонецЕсли;
	Возврат ТекстJSON(Результат, Истина);
	
КонецФункции

Функция НачалоТекста(Текст)
	
	Если СтрДлина(Текст) <= ПределТекста() Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Лев(Текст, ПределТекста()) + Символы.ПС + СтрокаПоШаблону("... показаны первые %1 символов из %2",
		Формат(ПределТекста(), "ЧГ=0"), Формат(СтрДлина(Текст), "ЧГ=0"));
	
КонецФункции

Функция ОднойСтрокой(Текст, Длина)
	
	Результат = СтрЗаменить(СтрЗаменить(СтрЗаменить(Текст, Символы.ВК, ""), Символы.ПС, " "), Символы.Таб, " ");
	Возврат Лев(СокрЛП(Результат), Длина);
	
КонецФункции

Функция ПерваяСтрока(Текст)
	
	Позиция = Найти(Текст, Символы.ПС);
	Возврат ?(Позиция > 0, Лев(Текст, Позиция - 1), Текст);
	
КонецФункции

Функция ПределТекста()
	
	Возврат 30000;
	
КонецФункции

Функция ПределКомментария()
	
	Возврат 2000;
	
КонецФункции

#КонецОбласти

#Область СтроковыеФункции

Функция СтрокаПоШаблону(Шаблон, Параметр1 = Неопределено, Параметр2 = Неопределено,
	Параметр3 = Неопределено, Параметр4 = Неопределено, Параметр5 = Неопределено)
	
	Параметры = Новый Массив;
	Параметры.Добавить(Параметр1);
	Параметры.Добавить(Параметр2);
	Параметры.Добавить(Параметр3);
	Параметры.Добавить(Параметр4);
	Параметры.Добавить(Параметр5);
	
	Результат = "";
	Остаток = Шаблон;
	Позиция = Найти(Остаток, "%");
	Пока Позиция > 0 Цикл
		Результат = Результат + Лев(Остаток, Позиция - 1);
		Знак = Сред(Остаток, Позиция + 1, 1);
		Номер = ?(Знак = "", 0, Найти("12345", Знак));
		Если Знак = "%" Тогда
			Результат = Результат + "%";
			Остаток = Сред(Остаток, Позиция + 2);
		ИначеЕсли Номер > 0 Тогда
			Результат = Результат + Строка(Параметры[Номер - 1]);
			Остаток = Сред(Остаток, Позиция + 2);
		Иначе
			Результат = Результат + "%";
			Остаток = Сред(Остаток, Позиция + 1);
		КонецЕсли;
		Позиция = Найти(Остаток, "%");
	КонецЦикла;
	Возврат Результат + Остаток;
	
КонецФункции

Функция ЧастиСтроки(Знач Текст, Разделитель, ВключатьПустые = Истина)
	
	Части = Новый Массив;
	ДлинаРазделителя = СтрДлина(Разделитель);
	Позиция = Найти(Текст, Разделитель);
	Пока Позиция > 0 Цикл
		Часть = Лев(Текст, Позиция - 1);
		Если ВключатьПустые Или Часть <> "" Тогда
			Части.Добавить(Часть);
		КонецЕсли;
		Текст = Сред(Текст, Позиция + ДлинаРазделителя);
		Позиция = Найти(Текст, Разделитель);
	КонецЦикла;
	Если ВключатьПустые Или Текст <> "" Тогда
		Части.Добавить(Текст);
	КонецЕсли;
	Возврат Части;
	
КонецФункции

Функция СоединенныеСтроки(Строки, Разделитель = "")
	
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();
	Первая = Истина;
	Для Каждого Часть Из Строки Цикл
		Если Не Первая И Разделитель <> "" Тогда
			Запись.ЗаписатьБезОбработки(Разделитель);
		КонецЕсли;
		Запись.ЗаписатьБезОбработки(Строка(Часть));
		Первая = Ложь;
	КонецЦикла;
	Возврат Запись.Закрыть();
	
КонецФункции

#КонецОбласти

#КонецОбласти