#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Перем ЛимитСтрок;
Перем ПредставленияСсылок;
Перем СведенияТипов;

#Область ПрограммныйИнтерфейс

// Выполняет команду агента на сервере и возвращает ответ для записи в файл результата.
//
// Параметры:
//  Команда - Соответствие - разобранная команда протокола моста: вид (type), параметры и ограничения.
//  ЗаписьРазрешена - Булево - если Истина, то на форме обработки разрешена запись в базу.
//
// Возвращаемое значение:
//  Структура - ответ: status, result или error и errorDetails, messages, rolledBack, warnings.
//
Функция ОтветНаКоманду(Команда, ЗаписьРазрешена) Экспорт
	
	ЛимитСтрок = ЧислоИзКоманды(Команда, "rowLimit", 1000);
	ПредставленияСсылок = Новый Соответствие;
	СведенияТипов = Новый Соответствие;
	Вид = Команда.Получить("type");
	Ответ = Новый Структура;
	Ответ.Вставить("status", "ok");
	
	Попытка
		Если Вид = "ping" Тогда
			Ответ.Вставить("result", ДанныеПинга());
		ИначеЕсли Вид = "query" Тогда
			Ответ.Вставить("result", ДанныеЗапроса(Команда));
		ИначеЕсли Вид = "eval" Или Вид = "execute" Тогда
			ДополнитьОтветВыполнением(Ответ, Команда, ЗаписьРазрешена);
		ИначеЕсли Вид = "metadata" Тогда
			Ответ.Вставить("result", ДанныеМетаданных(Команда));
		Иначе
			Ответ.Вставить("status", "rejected");
			Ответ.Вставить("error", СтрокаПоШаблону("Неизвестный вид команды: %1", Вид));
		КонецЕсли;
	Исключение
		ЗаполнитьОшибку(Ответ, ИнформацияОбОшибке());
	КонецПопытки;
	
	Ответ.Вставить("messages", ТекстыСообщений());
	Возврат Ответ;
	
КонецФункции

// Преобразует значение 1С в значение из примитивов, структур, соответствий и массивов, пригодное для ЗаписатьJSON.
// Ссылки передаются типом, UUID и представлением, объекты - реквизитами и табличными частями,
// таблицы и выборки - колонками и строками.
//
// Параметры:
//  Значение - Произвольный - значение, полученное при выполнении команды агента.
//
// Возвращаемое значение:
//  Произвольный - преобразованное значение.
//
Функция ЗначениеДляJSON(Значение) Экспорт
	
	ЛимитСтрок = 1000;
	ПредставленияСсылок = Новый Соответствие;
	СведенияТипов = Новый Соответствие;
	Возврат ПреобразованноеЗначение(Значение, 0);
	
КонецФункции

// Возвращает сведения для индекса метаданных сеанса: отпечаток метаданных, заголовок индекса, коллекции
// для обхода и сохранённый индекс текущего пользователя, если он построен по тем же метаданным.
//
// Параметры:
//  Обновить - Булево - если Истина, то сохранённый индекс не читается: индекс строится заново.
//
// Возвращаемое значение:
//  Структура - сведения индекса:
//   * Отпечаток - Строка - хеш состава метаданных сеанса, версии конфигурации и активных расширений.
//   * Заголовок - Структура - формат, отпечаток, конфигурация и активные расширения для заголовка JSON.
//   * Коллекции - Массив из Структура - коллекции метаданных для обхода: Имя, Количество.
//   * Текст - Строка - сохранённый индекс в JSON; пустая строка - сохранённого нет или он устарел.
//   * Построен - Дата - момент построения сохранённого индекса, UTC.
//   * Объектов - Число - сколько описаний объектов метаданных в сохранённом индексе.
//   * Полей - Число - сколько реквизитов, измерений, ресурсов и полей табличных частей в сохранённом индексе.
//
Функция СведенияИндекса(Обновить) Экспорт
	
	Расширения = АктивныеРасширения();
	Отпечаток = ОтпечатокМетаданных(Расширения);
	
	СведенияКонфигурации = Новый Структура;
	СведенияКонфигурации.Вставить("name", Метаданные.Имя);
	СведенияКонфигурации.Вставить("synonym", Метаданные.Синоним);
	СведенияКонфигурации.Вставить("version", Метаданные.Версия);
	СведенияКонфигурации.Вставить("compatibilityMode", Строка(Метаданные.РежимСовместимости));
	
	Заголовок = Новый Структура;
	Заголовок.Вставить("format", ФорматИндекса());
	Заголовок.Вставить("fingerprint", Отпечаток);
	Заголовок.Вставить("configuration", СведенияКонфигурации);
	Заголовок.Вставить("extensions", Расширения);
	
	Сведения = Новый Структура;
	Сведения.Вставить("Отпечаток", Отпечаток);
	Сведения.Вставить("Заголовок", Заголовок);
	Сведения.Вставить("Коллекции", КоллекцииИндекса());
	Сведения.Вставить("Текст", "");
	Сведения.Вставить("Построен", Дата(1, 1, 1));
	Сведения.Вставить("Объектов", 0);
	Сведения.Вставить("Полей", 0);
	Если Не Обновить Тогда
		ЗаполнитьСохраненнымИндексом(Сведения);
	КонецЕсли;
	Возврат Сведения;
	
КонецФункции

// Описывает для индекса порцию объектов коллекции метаданных: объекты от Начало, пока не истечёт бюджет
// времени.
//
// Параметры:
//  ИмяКоллекции - Строка - имя коллекции метаданных, например "Справочники".
//  Начало - Число - индекс первого объекта порции в коллекции.
//  БюджетМс - Число - сколько миллисекунд можно потратить на порцию; первый объект описывается в любом случае.
//
// Возвращаемое значение:
//  Структура - порция индекса:
//   * Текст - Строка - порция в JSON: имя коллекции, таблица типов и описания объектов.
//   * Следующий - Число - индекс первого объекта следующей порции; 0 - коллекция пройдена.
//   * Описано - Число - сколько объектов коллекции вошло в порцию.
//   * Объектов - Число - сколько описаний объектов в порции вместе с вложенными подсистемами.
//   * Полей - Число - сколько реквизитов, измерений, ресурсов и полей табличных частей в порции.
//
Функция ПорцияИндекса(ИмяКоллекции, Начало, БюджетМс) Экспорт
	
	Старт = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Коллекция = КоллекцияМетаданных(ИмяКоллекции);
	Всего = Коллекция.Количество();
	Порция = НоваяПорцияИндекса(ИмяКоллекции);
	Индекс = Начало;
	Пока Индекс < Всего Цикл
		ДобавитьОписаниеОбъекта(Порция, Коллекция.Получить(Индекс));
		Индекс = Индекс + 1;
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() - Старт >= БюджетМс Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Данные = Новый Структура;
	Данные.Вставить("collection", ИмяКоллекции);
	Данные.Вставить("types", Порция.Типы);
	Данные.Вставить("objects", Порция.Объекты);
	
	Результат = Новый Структура;
	Результат.Вставить("Текст", ТекстJSON(Данные));
	Результат.Вставить("Следующий", ?(Индекс < Всего, Индекс, 0));
	Результат.Вставить("Описано", Индекс - Начало);
	Результат.Вставить("Объектов", Порция.Объекты.Количество());
	Результат.Вставить("Полей", Порция.Полей);
	Возврат Результат;
	
КонецФункции

// Сохраняет индекс метаданных в настройках текущего пользователя информационной базы.
//
// Параметры:
//  Сведения - Структура - сведения индекса (см. СведенияИндекса) с текстом построенного индекса.
//
Процедура СохранитьИндекс(Сведения) Экспорт
	
	Сохраняемый = Новый Структура;
	Сохраняемый.Вставить("Отпечаток", Сведения.Отпечаток);
	Сохраняемый.Вставить("Построен", Сведения.Построен);
	Сохраняемый.Вставить("Объектов", Сведения.Объектов);
	Сохраняемый.Вставить("Полей", Сведения.Полей);
	// JSON индекса хорошо сжимается: в настройках он занимает в разы меньше
	Сохраняемый.Вставить("Данные", Новый ХранилищеЗначения(Сведения.Текст, Новый СжатиеДанных(9)));
	ХранилищеОбщихНастроек.Сохранить(КлючОбъектаНастроек(), КлючНастроекИндекса(), Сохраняемый);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Команды

Функция ДанныеПинга()
	
	Данные = Новый Структура;
	Данные.Вставить("pong", Истина);
	Данные.Вставить("serverTime", XMLСтрока(ТекущаяДатаСеанса()));
	Данные.Вставить("sessionNumber", НомерСеансаИнформационнойБазы());
	Данные.Вставить("user", ИмяПользователя());
	Возврат Данные;
	
КонецФункции

Функция ДанныеЗапроса(Команда)
	
	Запрос = Новый Запрос(Команда.Получить("text"));
	ПараметрыЗапроса = Команда.Получить("params");
	Если ТипЗнч(ПараметрыЗапроса) = Тип("Соответствие") Тогда
		Для Каждого ОписаниеПараметра Из ПараметрыЗапроса Цикл
			Запрос.УстановитьПараметр(ОписаниеПараметра.Ключ, ЗначениеПараметра(ОписаниеПараметра.Значение));
		КонецЦикла;
	КонецЕсли;
	
	Результаты = Новый Массив;
	Для Каждого РезультатЗапроса Из Запрос.ВыполнитьПакет() Цикл
		Результаты.Добавить(ДанныеРезультатаЗапроса(РезультатЗапроса));
	КонецЦикла;
	
	Данные = Новый Структура;
	Данные.Вставить("results", Результаты);
	Возврат Данные;
	
КонецФункции

Процедура ДополнитьОтветВыполнением(Ответ, Команда, ЗаписьРазрешена)
	
	// Без разрешения записи на форме код выполняется в транзакции с откатом, даже если агент просит запись.
	// Запись по умолчанию тоже идёт в транзакции: она фиксируется, только если код отработал без ошибок
	ЗаписьЗапрошена = Команда.Получить("allowWrite") = Истина;
	Откатить = Не (ЗаписьЗапрошена И ЗаписьРазрешена = Истина);
	ВТранзакции = Откатить Или Команда.Получить("transaction") <> Ложь;
	Предупреждения = Новый Массив;
	Если ЗаписьЗапрошена И Откатить Тогда
		Предупреждения.Добавить("Запись в базу выключена на форме обработки: код выполнен в транзакции с откатом, " +
			"изменения не сохранены.");
	КонецЕсли;
	Если ВТранзакции Тогда
		НачатьТранзакцию();
	КонецЕсли;
	
	// Код агента выполняется в отдельной функции: переменные, от которых зависит откат, ему не видны
	Выполнен = Ложь;
	Попытка
		Если Команда.Получить("type") = "eval" Тогда
			Значение = ЗначениеВыражения(Команда.Получить("expression"));
		Иначе
			Значение = ЗначениеКода(Команда.Получить("code"));
		КонецЕсли;
		// Представления ссылок читаются до отката: объекты, созданные кодом, после него уже не прочитать
		Ответ.Вставить("result", ПреобразованноеЗначение(Значение, 0));
		Выполнен = Истина;
	Исключение
		ЗаполнитьОшибку(Ответ, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если ВТранзакции И Не ТранзакцияАктивна() Тогда
		Итог = "none";
		Предупреждения.Добавить("Код сам завершил транзакцию моста: изменения, сделанные им до этого, могли " +
			"сохраниться.");
	ИначеЕсли Откатить Тогда
		Итог = "rolledBack";
	ИначеЕсли Не ВТранзакции Тогда
		Итог = "none";
		Если ТранзакцияАктивна() Тогда
			Предупреждения.Добавить("Код оставил незавершённую транзакцию, она отменена.");
		КонецЕсли;
	ИначеЕсли Выполнен Тогда
		Итог = ИтогФиксацииЗаписи(Ответ, Предупреждения);
	Иначе
		Итог = "rolledBack";
	КонецЕсли;
	
	Для Счетчик = 1 По 100 Цикл
		Если Не ТранзакцияАктивна() Тогда
			Прервать;
		КонецЕсли;
		ОтменитьТранзакцию();
	КонецЦикла;
	Ответ.Вставить("rolledBack", Итог = "rolledBack");
	Ответ.Вставить("transaction", Итог);
	Если Предупреждения.Количество() > 0 Тогда
		Ответ.Вставить("warnings", Предупреждения);
	КонецЕсли;
	
КонецПроцедуры

Функция ИтогФиксацииЗаписи(Ответ, Предупреждения)
	
	// После ошибки записи, которую код перехватил сам, транзакция сломана: фиксация её молча откатывает.
	// Распознаётся она до фиксации пробным запросом - в сломанной транзакции любой запрос падает
	Попытка
		Проба = Новый Запрос("ВЫБРАТЬ 1 КАК Поле");
		Проба.Выполнить();
	Исключение
		Ответ.Удалить("result");
		Ответ.Вставить("status", "error");
		Ответ.Вставить("error", "Запись не зафиксирована: код перехватил ошибку записи в базу, после которой " +
			"транзакция не фиксируется. Изменения отменены.");
		Ответ.Вставить("errorDetails", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат "rolledBack";
	КонецПопытки;
	
	// Транзакция, которую код открыл и не закрыл, не даёт зафиксировать запись: она отменяется целиком
	Попытка
		ЗафиксироватьТранзакцию();
	Исключение
		Ответ.Удалить("result");
		ЗаполнитьОшибку(Ответ, ИнформацияОбОшибке());
		Возврат "rolledBack";
	КонецПопытки;
	Если ТранзакцияАктивна() Тогда
		Предупреждения.Добавить("Код оставил незавершённую транзакцию: запись не зафиксирована, изменения отменены.");
		Возврат "rolledBack";
	КонецЕсли;
	Возврат "committed";
	
КонецФункции

Функция ЗначениеВыражения(Выражение)
	
	Возврат Вычислить(Выражение);
	
КонецФункции

Функция ЗначениеКода(Код)
	
	Результат = Неопределено;
	Выполнить(Код);
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьОшибку(Ответ, Информация)
	
	Ответ.Вставить("status", "error");
	Ответ.Вставить("error", ТекстОшибки(Информация));
	Ответ.Вставить("errorDetails", ПодробноеПредставлениеОшибки(Информация));
	
КонецПроцедуры

Функция ТекстОшибки(Информация)
	
	Текст = Информация.Описание;
	Причина = Информация.Причина;
	Пока Причина <> Неопределено Цикл
		Текст = Текст + Символы.ПС + Причина.Описание;
		Причина = Причина.Причина;
	КонецЦикла;
	Возврат Текст;
	
КонецФункции

Функция ТекстыСообщений()
	
	Тексты = Новый Массив;
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Тексты.Добавить(Сообщение.Текст);
	КонецЦикла;
	Возврат Тексты;
	
КонецФункции

Функция ЧислоИзКоманды(Команда, Имя, ПоУмолчанию)
	
	Значение = Команда.Получить(Имя);
	Если ТипЗнч(Значение) = Тип("Число") И Значение > 0 Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ПоУмолчанию;
	
КонецФункции

#КонецОбласти

#Область ПараметрыЗапроса

Функция ЗначениеПараметра(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Массив") Тогда
		Значения = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Значения.Добавить(ЗначениеПараметра(Элемент));
		КонецЦикла;
		Возврат Значения;
	ИначеЕсли ТипЗначения <> Тип("Соответствие") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Если Значение.Получить("_date") <> Неопределено Тогда
		Возврат XMLЗначение(Тип("Дата"), Значение.Получить("_date"));
	ИначеЕсли Значение.Получить("_predefined") <> Неопределено Тогда
		Возврат ПредопределенноеЗначение(Значение.Получить("_predefined"));
	ИначеЕсли Значение.Получить("_expr") <> Неопределено Тогда
		Возврат Вычислить(Значение.Получить("_expr"));
	ИначеЕсли Значение.Получить("_type") <> Неопределено Тогда
		Возврат СсылкаПоОписанию(Значение);
	КонецЕсли;
	
	ВызватьИсключение "Объект в параметре запроса должен содержать _type, _date, _predefined или _expr.";
	
КонецФункции

Функция СсылкаПоОписанию(Описание)
	
	ПолноеИмя = Описание.Получить("_type");
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если ОбъектМетаданных = Неопределено Тогда
		ВызватьИсключение СтрокаПоШаблону("Не найден объект метаданных %1.", ПолноеИмя);
	КонецЕсли;
	
	Класс = ЧастиСтроки(ОбъектМетаданных.ПолноеИмя(), ".")[0];
	Если Класс = "Перечисление" Тогда
		ИмяЗначения = Описание.Получить("_name");
		Если Не ЗначениеЗаполнено(ИмяЗначения) Тогда
			Возврат Перечисления[ОбъектМетаданных.Имя].ПустаяСсылка();
		КонецЕсли;
		Возврат Перечисления[ОбъектМетаданных.Имя][ИмяЗначения];
	КонецЕсли;
	
	Возврат XMLЗначение(Тип(Класс + "Ссылка." + ОбъектМетаданных.Имя), Описание.Получить("_uuid"));
	
КонецФункции

#КонецОбласти

#Область ПреобразованиеЗначений

Функция ПреобразованноеЗначение(Значение, Глубина)
	
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") Или ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат XMLСтрока(Значение);
	ИначеЕсли ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Возврат Строка(Значение);
	ИначеЕсли Глубина > ПределВложенности() Тогда
		Возврат ОписаниеЗначения(Значение);
	ИначеЕсли ТипЗначения = Тип("Массив") Или ТипЗначения = Тип("ФиксированныйМассив") Тогда
		Возврат ДанныеМассива(Значение, Глубина);
	ИначеЕсли ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		Возврат ДанныеСтруктуры(Значение, Глубина);
	ИначеЕсли ТипЗначения = Тип("Соответствие") Или ТипЗначения = Тип("ФиксированноеСоответствие") Тогда
		Возврат ДанныеСоответствия(Значение, Глубина);
	ИначеЕсли ТипЗначения = Тип("ТаблицаЗначений") Тогда
		Возврат ДанныеТаблицыЗначений(Значение, Глубина);
	ИначеЕсли ТипЗначения = Тип("ДеревоЗначений") Тогда
		Возврат ДанныеДереваЗначений(Значение, Глубина);
	ИначеЕсли ТипЗначения = Тип("СписокЗначений") Тогда
		Возврат ДанныеСпискаЗначений(Значение, Глубина);
	ИначеЕсли ТипЗначения = Тип("РезультатЗапроса") Тогда
		Возврат ДанныеРезультатаЗапроса(Значение);
	ИначеЕсли ТипЗначения = Тип("ОписаниеТипов") Тогда
		Возврат ДанныеОписанияТипов(Значение);
	ИначеЕсли ТипЗначения = Тип("ОбъектМетаданных") Тогда
		Возврат Значение.ПолноеИмя();
	ИначеЕсли ТипЗначения = Тип("Тип") Тогда
		Возврат ИмяТипа(Значение);
	ИначеЕсли ТипЗначения = Тип("ДвоичныеДанные") Тогда
		Данные = Новый Структура;
		Данные.Вставить("_type", "ДвоичныеДанные");
		Данные.Вставить("size", Значение.Размер());
		Возврат Данные;
	КонецЕсли;
	
	Сведения = СведенияТипа(ТипЗначения);
	Если ЗначениеЗаполнено(Сведения.Вид) Тогда
		Возврат ДанныеОбъектаКонфигурации(Значение, Сведения, Глубина);
	КонецЕсли;
	
	Возврат ОписаниеЗначения(Значение);
	
КонецФункции

Функция ДанныеМассива(Значение, Глубина)
	
	Данные = Новый Массив;
	Для Каждого Элемент Из Значение Цикл
		Данные.Добавить(ПреобразованноеЗначение(Элемент, Глубина + 1));
	КонецЦикла;
	Возврат Данные;
	
КонецФункции

Функция ДанныеСтруктуры(Значение, Глубина)
	
	Данные = Новый Структура;
	Для Каждого КлючИЗначение Из Значение Цикл
		Данные.Вставить(КлючИЗначение.Ключ, ПреобразованноеЗначение(КлючИЗначение.Значение, Глубина + 1));
	КонецЦикла;
	Возврат Данные;
	
КонецФункции

Функция ДанныеСоответствия(Значение, Глубина)
	
	КлючиСтроковые = Истина;
	Для Каждого КлючИЗначение Из Значение Цикл
		Если ТипЗнч(КлючИЗначение.Ключ) <> Тип("Строка") Тогда
			КлючиСтроковые = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если КлючиСтроковые Тогда
		Данные = Новый Соответствие;
		Для Каждого КлючИЗначение Из Значение Цикл
			Данные.Вставить(КлючИЗначение.Ключ, ПреобразованноеЗначение(КлючИЗначение.Значение, Глубина + 1));
		КонецЦикла;
		Возврат Данные;
	КонецЕсли;
	
	// Ключи-ссылки и прочие нестроковые ключи JSON-объект не примет: отдаём пары
	Пары = Новый Массив;
	Для Каждого КлючИЗначение Из Значение Цикл
		Пара = Новый Структура;
		Пара.Вставить("key", ПреобразованноеЗначение(КлючИЗначение.Ключ, Глубина + 1));
		Пара.Вставить("value", ПреобразованноеЗначение(КлючИЗначение.Значение, Глубина + 1));
		Пары.Добавить(Пара);
	КонецЦикла;
	Данные = Новый Структура;
	Данные.Вставить("_type", "Соответствие");
	Данные.Вставить("pairs", Пары);
	Возврат Данные;
	
КонецФункции

Функция ДанныеТаблицыЗначений(Таблица, Глубина)
	
	Данные = ОписаниеТаблицы(Таблица.Колонки);
	Данные.Вставить("_type", "ТаблицаЗначений");
	Данные.Вставить("total", Таблица.Количество());
	ЗагрузитьПредставления(ЗначенияТаблицы(Таблица));
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если Данные.rows.Количество() >= ЛимитСтрок Тогда
			Прервать;
		КонецЕсли;
		Данные.rows.Добавить(ЗначенияСтроки(СтрокаТаблицы, Таблица.Колонки, Глубина));
	КонецЦикла;
	Данные.Вставить("truncated", Данные.total > Данные.rows.Количество());
	Возврат Данные;
	
КонецФункции

Функция ЗначенияТаблицы(Таблица)
	
	Значения = Новый Массив;
	Строк = 0;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если Строк >= ЛимитСтрок Тогда
			Прервать;
		КонецЕсли;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Значения.Добавить(СтрокаТаблицы[Колонка.Имя]);
		КонецЦикла;
		Строк = Строк + 1;
	КонецЦикла;
	Возврат Значения;
	
КонецФункции

Функция ДанныеДереваЗначений(Дерево, Глубина)
	
	Данные = ОписаниеТаблицы(Дерево.Колонки);
	Данные.Вставить("_type", "ДеревоЗначений");
	Данные.Вставить("rows", УзлыДерева(Дерево.Строки, Дерево.Колонки, Глубина));
	Возврат Данные;
	
КонецФункции

Функция УзлыДерева(СтрокиДерева, Колонки, Глубина)
	
	Узлы = Новый Массив;
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		Если Узлы.Количество() >= ЛимитСтрок Тогда
			Прервать;
		КонецЕсли;
		Узел = Новый Структура;
		Узел.Вставить("values", ЗначенияСтроки(СтрокаДерева, Колонки, Глубина));
		Если СтрокаДерева.Строки.Количество() > 0 И Глубина < ПределВложенности() Тогда
			Узел.Вставить("rows", УзлыДерева(СтрокаДерева.Строки, Колонки, Глубина + 1));
		КонецЕсли;
		Узлы.Добавить(Узел);
	КонецЦикла;
	Возврат Узлы;
	
КонецФункции

Функция ЗначенияСтроки(СтрокаТаблицы, Колонки, Глубина)
	
	Значения = Новый Массив;
	Для Каждого Колонка Из Колонки Цикл
		Значения.Добавить(ПреобразованноеЗначение(СтрокаТаблицы[Колонка.Имя], Глубина + 1));
	КонецЦикла;
	Возврат Значения;
	
КонецФункции

Функция ДанныеСпискаЗначений(Список, Глубина)
	
	ЭлементыСписка = Новый Массив;
	Для Каждого ЭлементСписка Из Список Цикл
		Описание = Новый Структура;
		Описание.Вставить("value", ПреобразованноеЗначение(ЭлементСписка.Значение, Глубина + 1));
		Описание.Вставить("presentation", ЭлементСписка.Представление);
		Описание.Вставить("check", ЭлементСписка.Пометка);
		ЭлементыСписка.Добавить(Описание);
	КонецЦикла;
	
	Данные = Новый Структура;
	Данные.Вставить("_type", "СписокЗначений");
	Данные.Вставить("items", ЭлементыСписка);
	Возврат Данные;
	
КонецФункции

Функция ДанныеРезультатаЗапроса(РезультатЗапроса)
	
	// Пакетный запрос с УНИЧТОЖИТЬ возвращает на месте этого запроса Неопределено
	Если РезультатЗапроса = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Данные = ОписаниеТаблицы(РезультатЗапроса.Колонки);
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Данные;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Данные.Вставить("total", Выборка.Количество());
	КоличествоКолонок = РезультатЗапроса.Колонки.Количество();
	ЗагрузитьПредставления(ЗначенияВыборки(Выборка, КоличествоКолонок));
	Выборка.Сбросить();
	Пока Данные.rows.Количество() < ЛимитСтрок И Выборка.Следующий() Цикл
		Значения = Новый Массив;
		Для Индекс = 0 По КоличествоКолонок - 1 Цикл
			Значения.Добавить(ПреобразованноеЗначение(Выборка.Получить(Индекс), 1));
		КонецЦикла;
		Данные.rows.Добавить(Значения);
	КонецЦикла;
	Данные.Вставить("truncated", Данные.total > Данные.rows.Количество());
	Возврат Данные;
	
КонецФункции

Функция ЗначенияВыборки(Выборка, КоличествоКолонок)
	
	Значения = Новый Массив;
	Строк = 0;
	Пока Строк < ЛимитСтрок И Выборка.Следующий() Цикл
		Для Индекс = 0 По КоличествоКолонок - 1 Цикл
			Значения.Добавить(Выборка.Получить(Индекс));
		КонецЦикла;
		Строк = Строк + 1;
	КонецЦикла;
	Возврат Значения;
	
КонецФункции

Функция ОписаниеТаблицы(Колонки)
	
	ОписанияКолонок = Новый Массив;
	Для Каждого Колонка Из Колонки Цикл
		ОписаниеКолонки = Новый Структура;
		ОписаниеКолонки.Вставить("name", Колонка.Имя);
		ОписаниеКолонки.Вставить("types", ИменаТипов(Колонка.ТипЗначения));
		ОписанияКолонок.Добавить(ОписаниеКолонки);
	КонецЦикла;
	
	Данные = Новый Структура;
	Данные.Вставить("columns", ОписанияКолонок);
	Данные.Вставить("rows", Новый Массив);
	Данные.Вставить("total", 0);
	Данные.Вставить("truncated", Ложь);
	Возврат Данные;
	
КонецФункции

Функция ДанныеОписанияТипов(ОписаниеТипов)
	
	Данные = Новый Структура;
	Данные.Вставить("_type", "ОписаниеТипов");
	Данные.Вставить("types", ИменаТипов(ОписаниеТипов));
	Возврат Данные;
	
КонецФункции

Функция ДанныеОбъектаКонфигурации(Значение, Сведения, Глубина)
	
	Если Сведения.Вид = "Ссылка" Тогда
		Возврат ДанныеСсылки(Значение, Сведения);
	ИначеЕсли Сведения.Вид = "Объект" Тогда
		Возврат ДанныеОбъекта(Значение, Сведения.ОбъектМетаданных, Глубина);
	КонецЕсли;
	
	Данные = ДанныеТаблицыЗначений(Значение.Выгрузить(), Глубина);
	Данные.Вставить("_type", Сведения.ПолноеИмя + ".НаборЗаписей");
	Возврат Данные;
	
КонецФункции

Функция ДанныеСсылки(Ссылка, Сведения)
	
	Данные = Новый Структура;
	Данные.Вставить("_type", Сведения.ПолноеИмя);
	Если Сведения.Класс = "Перечисление" Тогда
		Данные.Вставить("_name", ИмяЗначенияПеречисления(Ссылка, Сведения.ОбъектМетаданных));
	Иначе
		Данные.Вставить("_uuid", Строка(Ссылка.УникальныйИдентификатор()));
	КонецЕсли;
	Представление = ПредставленияСсылок.Получить(Ссылка);
	Если Представление = Неопределено Тогда
		Представление = Строка(Ссылка);
	КонецЕсли;
	Данные.Вставить("_presentation", Представление);
	Возврат Данные;
	
КонецФункции

Функция ИмяЗначенияПеречисления(Ссылка, ОбъектМетаданных)
	
	Если Ссылка.Пустая() Тогда
		Возврат "";
	КонецЕсли;
	Индекс = Перечисления[ОбъектМетаданных.Имя].Индекс(Ссылка);
	Возврат ОбъектМетаданных.ЗначенияПеречисления.Получить(Индекс).Имя;
	
КонецФункции

Функция ДанныеОбъекта(ОбъектДанных, ОбъектМетаданных, Глубина)
	
	Поля = Новый Соответствие;
	Для Каждого Реквизит Из ОбъектМетаданных.СтандартныеРеквизиты Цикл
		ДобавитьЗначениеРеквизита(Поля, ОбъектДанных, Реквизит.Имя, Глубина);
	КонецЦикла;
	Для Каждого Реквизит Из ОбъектМетаданных.Реквизиты Цикл
		ДобавитьЗначениеРеквизита(Поля, ОбъектДанных, Реквизит.Имя, Глубина);
	КонецЦикла;
	Для Каждого ТабличнаяЧасть Из ОбъектМетаданных.ТабличныеЧасти Цикл
		Поля.Вставить(ТабличнаяЧасть.Имя,
			ДанныеТаблицыЗначений(ОбъектДанных[ТабличнаяЧасть.Имя].Выгрузить(), Глубина + 1));
	КонецЦикла;
	
	Данные = Новый Структура;
	Данные.Вставить("_type", ОбъектМетаданных.ПолноеИмя() + ".Объект");
	Данные.Вставить("isNew", ОбъектДанных.ЭтоНовый());
	Данные.Вставить("fields", Поля);
	Возврат Данные;
	
КонецФункции

Процедура ДобавитьЗначениеРеквизита(Поля, ОбъектДанных, Имя, Глубина)
	
	Попытка
		Значение = ОбъектДанных[Имя];
	Исключение
		// Часть стандартных реквизитов по имени у объекта не читается
		Возврат;
	КонецПопытки;
	Поля.Вставить(Имя, ПреобразованноеЗначение(Значение, Глубина + 1));
	
КонецПроцедуры

Функция ОписаниеЗначения(Значение)
	
	Данные = Новый Структура;
	Данные.Вставить("_type", ИмяТипа(ТипЗнч(Значение)));
	Попытка
		Данные.Вставить("_presentation", Строка(Значение));
	Исключение
		// Строкового представления есть не у всех типов
		Данные.Вставить("_presentation", "");
	КонецПопытки;
	Возврат Данные;
	
КонецФункции

Функция СведенияТипа(ТипЗначения)
	
	Сведения = СведенияТипов.Получить(ТипЗначения);
	Если Сведения <> Неопределено Тогда
		Возврат Сведения;
	КонецЕсли;
	
	Вид = "";
	ПолноеИмя = "";
	Класс = "";
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
	Если ОбъектМетаданных <> Неопределено Тогда
		ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
		Класс = ЧастиСтроки(ПолноеИмя, ".")[0];
		Вид = ВидЗначенияКонфигурации(ТипЗначения, Класс, ОбъектМетаданных.Имя);
	КонецЕсли;
	
	Сведения = Новый Структура;
	Сведения.Вставить("Вид", Вид);
	Сведения.Вставить("ПолноеИмя", ПолноеИмя);
	Сведения.Вставить("Класс", Класс);
	Сведения.Вставить("ОбъектМетаданных", ОбъектМетаданных);
	СведенияТипов.Вставить(ТипЗначения, Сведения);
	Возврат Сведения;
	
КонецФункции

Функция ВидЗначенияКонфигурации(ТипЗначения, Класс, Имя)
	
	Если КлассыСсылочныхОбъектов().Найти(Класс) <> Неопределено Тогда
		Если ТипЗначения = Тип(Класс + "Ссылка." + Имя) Тогда
			Возврат "Ссылка";
		ИначеЕсли Класс <> "Перечисление" И ТипЗначения = Тип(Класс + "Объект." + Имя) Тогда
			Возврат "Объект";
		КонецЕсли;
	ИначеЕсли КлассыРегистров().Найти(Класс) <> Неопределено
		И ТипЗначения = Тип(Класс + "НаборЗаписей." + Имя) Тогда
		Возврат "НаборЗаписей";
	КонецЕсли;
	Возврат "";
	
КонецФункции

Процедура ЗагрузитьПредставления(Значения)
	
	СсылкиПоТаблицам = Новый Соответствие;
	Учтенные = Новый Соответствие;
	Для Каждого Значение Из Значения Цикл
		Сведения = СведенияТипа(ТипЗнч(Значение));
		Если Сведения.Вид <> "Ссылка"
			Или ПредставленияСсылок.Получить(Значение) <> Неопределено
			Или Учтенные.Получить(Значение) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Учтенные.Вставить(Значение, Истина);
		Ссылки = СсылкиПоТаблицам.Получить(Сведения.ПолноеИмя);
		Если Ссылки = Неопределено Тогда
			Ссылки = Новый Массив;
			СсылкиПоТаблицам.Вставить(Сведения.ПолноеИмя, Ссылки);
		КонецЕсли;
		Ссылки.Добавить(Значение);
	КонецЦикла;
	
	// Запрос на таблицу вместо обращения к базе на каждую ссылку: так работает Строка(Ссылка) без кэша
	Для Каждого КлючИЗначение Из СсылкиПоТаблицам Цикл
		ДобавитьПредставленияТаблицы(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьПредставленияТаблицы(ПолноеИмя, Ссылки)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Объекты.Ссылка КАК Ссылка,
	|	ПРЕДСТАВЛЕНИЕ(Объекты.Ссылка) КАК Представление
	|ИЗ
	|	%1 КАК Объекты
	|ГДЕ
	|	Объекты.Ссылка В (&Ссылки)";
	Запрос = Новый Запрос(СтрокаПоШаблону(ТекстЗапроса, ПолноеИмя));
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Попытка
		РезультатЗапроса = Запрос.Выполнить();
	Исключение
		// Таблица недоступна: представления этих ссылок получит Строка(Ссылка)
		Возврат;
	КонецПопытки;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ПредставленияСсылок.Вставить(Выборка.Ссылка, Выборка.Представление);
	КонецЦикла;
	
КонецПроцедуры

Функция ИменаТипов(ОписаниеТипов)
	
	Имена = Новый Массив;
	Для Каждого ТипЗначения Из ОписаниеТипов.Типы() Цикл
		Имена.Добавить(ИмяТипа(ТипЗначения, ОписаниеТипов));
	КонецЦикла;
	Возврат Имена;
	
КонецФункции

Функция ИмяТипа(ТипЗначения, ОписаниеТипов = Неопределено)
	
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
	Если ОбъектМетаданных <> Неопределено Тогда
		Возврат ОбъектМетаданных.ПолноеИмя();
	КонецЕсли;
	
	Имя = Строка(ТипЗначения);
	Если ОписаниеТипов = Неопределено Тогда
		Возврат Имя;
	ИначеЕсли ТипЗначения = Тип("Строка") И ОписаниеТипов.КвалификаторыСтроки.Длина > 0 Тогда
		Возврат СтрокаПоШаблону("%1(%2)", Имя, Формат(ОписаниеТипов.КвалификаторыСтроки.Длина, "ЧГ=0"));
	ИначеЕсли ТипЗначения = Тип("Число") И ОписаниеТипов.КвалификаторыЧисла.Разрядность > 0 Тогда
		Квалификаторы = ОписаниеТипов.КвалификаторыЧисла;
		Возврат СтрокаПоШаблону("%1(%2,%3)", Имя, Формат(Квалификаторы.Разрядность, "ЧГ=0"),
			Формат(Квалификаторы.РазрядностьДробнойЧасти, "ЧН=0; ЧГ=0"));
	КонецЕсли;
	Возврат Имя;
	
КонецФункции

Функция КлассыСсылочныхОбъектов()
	
	Возврат ЧастиСтроки("Справочник,Документ,Перечисление,ПланВидовХарактеристик,ПланСчетов,ПланВидовРасчета," +
		"ПланОбмена,БизнесПроцесс,Задача", ",");
	
КонецФункции

Функция КлассыРегистров()
	
	Возврат ЧастиСтроки("РегистрСведений,РегистрНакопления,РегистрБухгалтерии,РегистрРасчета", ",");
	
КонецФункции

Функция ПределВложенности()
	
	Возврат 12;
	
КонецФункции

#КонецОбласти

#Область Метаданные

Функция ДанныеМетаданных(Команда)
	
	Путь = СокрЛП(Строка(Команда.Получить("path")));
	Если ПустаяСтрока(Путь) Тогда
		Возврат СоставКонфигурации(НРег(СокрЛП(Строка(Команда.Получить("filter")))));
	КонецЕсли;
	
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Путь);
	Если ОбъектМетаданных = Неопределено Тогда
		ВызватьИсключение СтрокаПоШаблону("Объект метаданных %1 не найден.", Путь);
	КонецЕсли;
	Возврат ОписаниеОбъектаМетаданных(ОбъектМетаданных);
	
КонецФункции

Функция СоставКонфигурации(Отбор)
	
	Коллекции = Новый Массив;
	Для Каждого ИмяКоллекции Из ЧастиСтроки(ИменаКоллекцийМетаданных(), ",") Цикл
		Объекты = Новый Массив;
		Для Каждого ОбъектМетаданных Из КоллекцияМетаданных(ИмяКоллекции) Цикл
			Если ПустаяСтрока(Отбор)
				Или Найти(НРег(ОбъектМетаданных.Имя), Отбор) > 0
				Или Найти(НРег(ОбъектМетаданных.Синоним), Отбор) > 0 Тогда
				Объекты.Добавить(КраткоеОписаниеОбъекта(ОбъектМетаданных));
			КонецЕсли;
		КонецЦикла;
		Если Объекты.Количество() > 0 Тогда
			Коллекция = Новый Структура;
			Коллекция.Вставить("name", ИмяКоллекции);
			Коллекция.Вставить("objects", Объекты);
			Коллекции.Добавить(Коллекция);
		КонецЕсли;
	КонецЦикла;
	
	Конфигурация = Новый Структура;
	Конфигурация.Вставить("name", Метаданные.Имя);
	Конфигурация.Вставить("synonym", Метаданные.Синоним);
	Конфигурация.Вставить("version", Метаданные.Версия);
	
	Данные = Новый Структура;
	Данные.Вставить("configuration", Конфигурация);
	Данные.Вставить("collections", Коллекции);
	Возврат Данные;
	
КонецФункции

Функция ОписаниеОбъектаМетаданных(ОбъектМетаданных)
	
	Данные = КраткоеОписаниеОбъекта(ОбъектМетаданных);
	Данные.Вставить("fullName", ОбъектМетаданных.ПолноеИмя());
	Данные.Вставить("comment", ОбъектМетаданных.Комментарий);
	ТипОбъекта = СвойствоМетаданных(ОбъектМетаданных, "Тип");
	Если ТипЗнч(ТипОбъекта) = Тип("ОписаниеТипов") Тогда
		Данные.Вставить("types", ИменаТипов(ТипОбъекта));
	КонецЕсли;
	
	ДобавитьОписанияПолей(Данные, "standardAttributes", ОбъектМетаданных, "СтандартныеРеквизиты");
	ДобавитьОписанияПолей(Данные, "dimensions", ОбъектМетаданных, "Измерения");
	ДобавитьОписанияПолей(Данные, "resources", ОбъектМетаданных, "Ресурсы");
	ДобавитьОписанияПолей(Данные, "attributes", ОбъектМетаданных, "Реквизиты");
	ДобавитьОписанияПолей(Данные, "values", ОбъектМетаданных, "ЗначенияПеречисления");
	
	ТабличныеЧасти = СвойствоМетаданных(ОбъектМетаданных, "ТабличныеЧасти");
	Если ТабличныеЧасти <> Неопределено Тогда
		Описания = Новый Массив;
		Для Каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
			Описание = КраткоеОписаниеОбъекта(ТабличнаяЧасть);
			ДобавитьОписанияПолей(Описание, "attributes", ТабличнаяЧасть, "Реквизиты");
			Описания.Добавить(Описание);
		КонецЦикла;
		Данные.Вставить("tabularSections", Описания);
	КонецЕсли;
	
	ДобавитьИмена(Данные, "registerRecords", ОбъектМетаданных, "Движения", Истина);
	ДобавитьИмена(Данные, "forms", ОбъектМетаданных, "Формы");
	ДобавитьИмена(Данные, "commands", ОбъектМетаданных, "Команды");
	ДобавитьИмена(Данные, "templates", ОбъектМетаданных, "Макеты");
	Возврат Данные;
	
КонецФункции

Функция КраткоеОписаниеОбъекта(ОбъектМетаданных)
	
	Данные = Новый Структура;
	Данные.Вставить("name", ОбъектМетаданных.Имя);
	Данные.Вставить("synonym", ОбъектМетаданных.Синоним);
	Расширение = РасширениеОбъекта(ОбъектМетаданных);
	Если ЗначениеЗаполнено(Расширение) Тогда
		Данные.Вставить("extension", Расширение);
	КонецЕсли;
	Возврат Данные;
	
КонецФункции

Функция РасширениеОбъекта(ОбъектМетаданных)
	
	Попытка
		Расширение = ОбъектМетаданных.РасширениеКонфигурации();
	Исключение
		// Метод есть не у всех видов объектов метаданных
		Возврат "";
	КонецПопытки;
	Если Расширение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Расширение.Имя;
	
КонецФункции

Процедура ДобавитьОписанияПолей(Данные, Ключ, ОбъектМетаданных, ИмяКоллекции)
	
	Поля = СвойствоМетаданных(ОбъектМетаданных, ИмяКоллекции);
	Если Поля = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Описания = Новый Массив;
	Для Каждого Поле Из Поля Цикл
		Описание = Новый Структура;
		Описание.Вставить("name", Поле.Имя);
		Описание.Вставить("synonym", Поле.Синоним);
		ТипПоля = СвойствоМетаданных(Поле, "Тип");
		Если ТипЗнч(ТипПоля) = Тип("ОписаниеТипов") Тогда
			Описание.Вставить("types", ИменаТипов(ТипПоля));
		КонецЕсли;
		Описания.Добавить(Описание);
	КонецЦикла;
	Данные.Вставить(Ключ, Описания);
	
КонецПроцедуры

Процедура ДобавитьИмена(Данные, Ключ, ОбъектМетаданных, ИмяКоллекции, ПолныеИмена = Ложь)
	
	Коллекция = СвойствоМетаданных(ОбъектМетаданных, ИмяКоллекции);
	Если Коллекция = Неопределено Или Коллекция.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Имена = Новый Массив;
	Для Каждого Элемент Из Коллекция Цикл
		Имена.Добавить(?(ПолныеИмена, Элемент.ПолноеИмя(), Элемент.Имя));
	КонецЦикла;
	Данные.Вставить(Ключ, Имена);
	
КонецПроцедуры

Функция СвойствоМетаданных(ОбъектМетаданных, ИмяСвойства)
	
	Попытка
		Возврат Вычислить("ОбъектМетаданных." + ИмяСвойства);
	Исключение
		// У объекта этого вида нет такого свойства
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Функция КоллекцияМетаданных(ИмяКоллекции)
	
	Попытка
		Возврат Вычислить("Метаданные." + ИмяКоллекции);
	Исключение
		// Коллекции нет в этой версии платформы или в режиме совместимости конфигурации
		Возврат Новый Массив;
	КонецПопытки;
	
КонецФункции

Функция ИменаКоллекцийМетаданных()
	
	Возврат "Константы,Справочники,Документы,ЖурналыДокументов,Перечисления,Отчеты,Обработки," +
		"ПланыВидовХарактеристик,ПланыСчетов,ПланыВидовРасчета,РегистрыСведений,РегистрыНакопления," +
		"РегистрыБухгалтерии,РегистрыРасчета,БизнесПроцессы,Задачи,ПланыОбмена,Последовательности," +
		"КритерииОтбора,ОбщиеМодули,ОбщиеФормы,ОбщиеКоманды,ОбщиеМакеты,ОбщиеРеквизиты,ОпределяемыеТипы," +
		"Роли,РегламентныеЗадания,ПодпискиНаСобытия,ФункциональныеОпции,ПараметрыСеанса,ХранилищаНастроек," +
		"HTTPСервисы,WebСервисы,ВнешниеИсточникиДанных";
	
КонецФункции

#КонецОбласти

#Область ИндексМетаданных

Функция ФорматИндекса()
	
	// Меняется вместе с составом индекса: формат входит в отпечаток, индексы прежнего формата строятся заново
	Возврат 1;
	
КонецФункции

Функция КлючОбъектаНастроек()
	
	Возврат "MCPLocalBridge";
	
КонецФункции

Функция КлючНастроекИндекса()
	
	Возврат "ИндексМетаданных";
	
КонецФункции

Функция ИменаКоллекцийИндекса()
	
	Возврат ЧастиСтроки(ИменаКоллекцийМетаданных() + ",Подсистемы", ",");
	
КонецФункции

Функция КоллекцииИндекса()
	
	Коллекции = Новый Массив;
	Для Каждого ИмяКоллекции Из ИменаКоллекцийИндекса() Цикл
		Количество = КоллекцияМетаданных(ИмяКоллекции).Количество();
		Если Количество > 0 Тогда
			Коллекция = Новый Структура;
			Коллекция.Вставить("Имя", ИмяКоллекции);
			Коллекция.Вставить("Количество", Количество);
			Коллекции.Добавить(Коллекция);
		КонецЕсли;
	КонецЦикла;
	Возврат Коллекции;
	
КонецФункции

Функция СвойстваКоллекции(ИмяКоллекции)
	
	// Обращение к свойству, которого у объекта нет, - исключение, поэтому набор полей задан для каждой коллекции
	Ключ = "," + ИмяКоллекции + ",";
	ОбъектныеКоллекции = ",Справочники,Документы,Отчеты,Обработки,ПланыВидовХарактеристик,ПланыСчетов," +
		"ПланыВидовРасчета,БизнесПроцессы,Задачи,ПланыОбмена,";
	КоллекцииРегистров = ",РегистрыСведений,РегистрыНакопления,РегистрыБухгалтерии,РегистрыРасчета,";
	КоллекцииСТипом = ",Константы,ОпределяемыеТипы,ПараметрыСеанса,ПланыВидовХарактеристик,ОбщиеРеквизиты," +
		"КритерииОтбора,";
	КоллекцииСПредопределенными = ",Справочники,ПланыВидовХарактеристик,ПланыСчетов,ПланыВидовРасчета,";
	
	Свойства = Новый Структура;
	Свойства.Вставить("Реквизиты", Найти(ОбъектныеКоллекции + КоллекцииРегистров, Ключ) > 0);
	Свойства.Вставить("ТабличныеЧасти", Найти(ОбъектныеКоллекции, Ключ) > 0);
	Свойства.Вставить("Измерения", Найти(КоллекцииРегистров + "Последовательности,", Ключ) > 0);
	Свойства.Вставить("Ресурсы", Найти(КоллекцииРегистров, Ключ) > 0);
	Свойства.Вставить("ЗначенияПеречисления", ИмяКоллекции = "Перечисления");
	Свойства.Вставить("Тип", Найти(КоллекцииСТипом, Ключ) > 0);
	Свойства.Вставить("Формы", Найти(ОбъектныеКоллекции + КоллекцииРегистров + "ЖурналыДокументов,Перечисления,",
		Ключ) > 0);
	Свойства.Вставить("Предопределенные", Найти(КоллекцииСПредопределенными, Ключ) > 0);
	Свойства.Вставить("Подсистемы", ИмяКоллекции = "Подсистемы");
	Возврат Свойства;
	
КонецФункции

Функция АктивныеРасширения()
	
	Попытка
		Активные = Вычислить(ТекстАктивныхРасширений());
	Исключение
		// Список расширений доступен не всем пользователям, а в режиме совместимости 8.2 расширений нет:
		// их изменения отпечаток заметит по составу метаданных
		Возврат Новый Массив;
	КонецПопытки;
	
	Список = Новый СписокЗначений;
	Для Каждого Расширение Из Активные Цикл
		// Хеш-сумма расширения на деле - двоичные данные SHA-1, хотя справка называет её строкой
		ХешСумма = Расширение.ХешСумма;
		Описание = Новый Структура;
		Описание.Вставить("name", Расширение.Имя);
		Описание.Вставить("version", Строка(Расширение.Версия));
		Описание.Вставить("hash", ?(ТипЗнч(ХешСумма) = Тип("ДвоичныеДанные"),
			НРег(ПолучитьHexСтрокуИзДвоичныхДанных(ХешСумма)), Строка(ХешСумма)));
		Список.Добавить(Описание, Расширение.Имя);
	КонецЦикла;
	Список.СортироватьПоПредставлению();
	Возврат Список.ВыгрузитьЗначения();
	
КонецФункции

Функция ЕстьАктивныеРасширения()
	
	Попытка
		Возврат Вычислить(ТекстАктивныхРасширений()).Количество() > 0;
	Исключение
		// Список расширений недоступен: нет права на него или режим совместимости 8.2, где расширений нет.
		// Расширение каждого поля проверяется отдельно, если объекты метаданных вообще умеют его назвать
	КонецПопытки;
	Попытка
		Для Каждого Язык Из Метаданные.Языки Цикл
			Язык.РасширениеКонфигурации();
			Прервать;
		КонецЦикла;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;
	
КонецФункции

Функция ТекстАктивныхРасширений()
	
	// Менеджер расширений есть с 8.3.6: через Вычислить модуль компилируется и в режиме совместимости 8.2
	Возврат "РасширенияКонфигурации.Получить(, ИсточникРасширенийКонфигурации.СеансАктивные)";
	
КонецФункции

Функция ОтпечатокМетаданных(Расширения)
	
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA1);
	Хеширование.Добавить(СтрокаПоШаблону("%1|%2|%3|%4", ФорматИндекса(), Метаданные.Имя, Метаданные.Версия,
		Метаданные.РежимСовместимости));
	Для Каждого Расширение Из Расширения Цикл
		Хеширование.Добавить(СтрокаПоШаблону("|%1|%2|%3", Расширение.name, Расширение.version, Расширение.hash));
	КонецЦикла;
	
	// Хеш-суммы основной конфигурации в режиме Предприятия нет, а версию при правках часто не меняют:
	// добавленный или удалённый объект и реквизит меняют отпечаток через полные имена и число полей
	Для Каждого ИмяКоллекции Из ИменаКоллекцийИндекса() Цикл
		Свойства = СвойстваКоллекции(ИмяКоллекции);
		Для Каждого ОбъектМетаданных Из КоллекцияМетаданных(ИмяКоллекции) Цикл
			Хеширование.Добавить(СтрокаОтпечатка(ОбъектМетаданных, Свойства));
		КонецЦикла;
	КонецЦикла;
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));
	
КонецФункции

Функция СтрокаОтпечатка(ОбъектМетаданных, Свойства)
	
	Количества = Новый Массив;
	Если Свойства.Реквизиты Тогда
		Количества.Добавить(XMLСтрока(ОбъектМетаданных.Реквизиты.Количество()));
	КонецЕсли;
	Если Свойства.ТабличныеЧасти Тогда
		Для Каждого ТабличнаяЧасть Из ОбъектМетаданных.ТабличныеЧасти Цикл
			Количества.Добавить(XMLСтрока(ТабличнаяЧасть.Реквизиты.Количество()));
		КонецЦикла;
	КонецЕсли;
	Если Свойства.Измерения Тогда
		Количества.Добавить(XMLСтрока(ОбъектМетаданных.Измерения.Количество()));
	КонецЕсли;
	Если Свойства.Ресурсы Тогда
		Количества.Добавить(XMLСтрока(ОбъектМетаданных.Ресурсы.Количество()));
	КонецЕсли;
	Если Свойства.ЗначенияПеречисления Тогда
		Количества.Добавить(XMLСтрока(ОбъектМетаданных.ЗначенияПеречисления.Количество()));
	КонецЕсли;
	
	Текст = "|" + ОбъектМетаданных.ПолноеИмя() + ":" + СоединенныеСтроки(Количества, ",");
	Если Свойства.Подсистемы Тогда
		Текст = Текст + ":" + XMLСтрока(ОбъектМетаданных.Состав.Количество());
		Для Каждого Подсистема Из ОбъектМетаданных.Подсистемы Цикл
			Текст = Текст + СтрокаОтпечатка(Подсистема, Свойства);
		КонецЦикла;
	КонецЕсли;
	Возврат Текст;
	
КонецФункции

Процедура ЗаполнитьСохраненнымИндексом(Сведения)
	
	Сохраненный = ХранилищеОбщихНастроек.Загрузить(КлючОбъектаНастроек(), КлючНастроекИндекса());
	Если ТипЗнч(Сохраненный) <> Тип("Структура")
		Или Не Сохраненный.Свойство("Отпечаток")
		Или Сохраненный.Отпечаток <> Сведения.Отпечаток Тогда
		Возврат;
	КонецЕсли;
	
	Текст = Сохраненный.Данные.Получить();
	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
		Возврат;
	КонецЕсли;
	Сведения.Текст = Текст;
	Сведения.Построен = Сохраненный.Построен;
	Сведения.Объектов = Сохраненный.Объектов;
	Сведения.Полей = Сохраненный.Полей;
	
КонецПроцедуры

Функция НоваяПорцияИндекса(ИмяКоллекции)
	
	Порция = Новый Структура;
	Порция.Вставить("ИмяКоллекции", ИмяКоллекции);
	Порция.Вставить("Свойства", СвойстваКоллекции(ИмяКоллекции));
	Порция.Вставить("ЕстьРасширения", ЕстьАктивныеРасширения());
	Порция.Вставить("Объекты", Новый Массив);
	Порция.Вставить("Типы", Новый Массив);
	Порция.Вставить("НомераТипов", Новый Соответствие);
	Порция.Вставить("ИменаПоТипам", Новый Соответствие);
	Порция.Вставить("Полей", 0);
	Возврат Порция;
	
КонецФункции

Процедура ДобавитьОписаниеОбъекта(Порция, ОбъектМетаданных)
	
	Описание = Новый Структура;
	Описание.Вставить("full", ОбъектМетаданных.ПолноеИмя());
	Попытка
		ЗаполнитьОписаниеОбъекта(Описание, ОбъектМетаданных, Порция);
	Исключение
		// Объект, который не удалось описать, остаётся в индексе с текстом ошибки, остальные описываются дальше
		Описание.Вставить("error", ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Порция.Объекты.Добавить(Описание);
	
	Если Порция.Свойства.Подсистемы Тогда
		Для Каждого Подсистема Из ОбъектМетаданных.Подсистемы Цикл
			ДобавитьОписаниеОбъекта(Порция, Подсистема);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьОписаниеОбъекта(Описание, ОбъектМетаданных, Порция)
	
	Свойства = Порция.Свойства;
	Описание.Вставить("name", ОбъектМетаданных.Имя);
	Если ОбъектМетаданных.Синоним <> ОбъектМетаданных.Имя Тогда
		Описание.Вставить("synonym", ОбъектМетаданных.Синоним);
	КонецЕсли;
	Если Порция.ЕстьРасширения Тогда
		Расширение = РасширениеОбъекта(ОбъектМетаданных);
		Если ЗначениеЗаполнено(Расширение) Тогда
			Описание.Вставить("extension", Расширение);
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(ОбъектМетаданных.Комментарий) Тогда
		Описание.Вставить("comment", ОбъектМетаданных.Комментарий);
	КонецЕсли;
	
	Если Свойства.Тип Тогда
		Описание.Вставить("type", НомерТипа(ОбъектМетаданных.Тип, Порция));
	КонецЕсли;
	Если Свойства.Реквизиты Тогда
		ДобавитьПоляИндекса(Описание, "attributes", ОбъектМетаданных.Реквизиты, Порция);
	КонецЕсли;
	Если Свойства.Измерения Тогда
		ДобавитьПоляИндекса(Описание, "dimensions", ОбъектМетаданных.Измерения, Порция);
	КонецЕсли;
	Если Свойства.Ресурсы Тогда
		ДобавитьПоляИндекса(Описание, "resources", ОбъектМетаданных.Ресурсы, Порция);
	КонецЕсли;
	Если Свойства.ТабличныеЧасти Тогда
		ДобавитьТабличныеЧастиИндекса(Описание, ОбъектМетаданных, Порция);
	КонецЕсли;
	Если Свойства.ЗначенияПеречисления Тогда
		Описание.Вставить("values", ЗначенияПеречисленияИндекса(ОбъектМетаданных));
	КонецЕсли;
	Если Свойства.Предопределенные Тогда
		ДобавитьИменаПредопределенных(Описание, ОбъектМетаданных);
	КонецЕсли;
	Если Свойства.Формы Тогда
		ДобавитьИмена(Описание, "forms", ОбъектМетаданных, "Формы");
		ДобавитьИмена(Описание, "commands", ОбъектМетаданных, "Команды");
		ДобавитьИмена(Описание, "templates", ОбъектМетаданных, "Макеты");
	КонецЕсли;
	ДополнитьОписаниеОбъекта(Описание, ОбъектМетаданных, Порция);
	
КонецПроцедуры

Процедура ДополнитьОписаниеОбъекта(Описание, ОбъектМетаданных, Порция)
	
	ИмяКоллекции = Порция.ИмяКоллекции;
	Если ИмяКоллекции = "Справочники" Тогда
		ДобавитьИмена(Описание, "owners", ОбъектМетаданных, "Владельцы", Истина);
		ДобавитьИмена(Описание, "basedOn", ОбъектМетаданных, "ВводитсяНаОсновании", Истина);
	ИначеЕсли ИмяКоллекции = "Документы" Тогда
		ДобавитьИмена(Описание, "records", ОбъектМетаданных, "Движения", Истина);
		ДобавитьИмена(Описание, "basedOn", ОбъектМетаданных, "ВводитсяНаОсновании", Истина);
	ИначеЕсли ИмяКоллекции = "ЖурналыДокументов" Тогда
		ДобавитьИмена(Описание, "content", ОбъектМетаданных, "РегистрируемыеДокументы", Истина);
	ИначеЕсли ИмяКоллекции = "Последовательности" Тогда
		ДобавитьИмена(Описание, "content", ОбъектМетаданных, "Документы", Истина);
		ДобавитьИмена(Описание, "records", ОбъектМетаданных, "Движения", Истина);
	ИначеЕсли ИмяКоллекции = "КритерииОтбора" Или ИмяКоллекции = "Подсистемы" Тогда
		ДобавитьИмена(Описание, "content", ОбъектМетаданных, "Состав", Истина);
	ИначеЕсли ИмяКоллекции = "РегистрыСведений" Тогда
		Описание.Вставить("periodicity", Строка(ОбъектМетаданных.ПериодичностьРегистраСведений));
		Описание.Вставить("writeMode", Строка(ОбъектМетаданных.РежимЗаписи));
	ИначеЕсли ИмяКоллекции = "РегистрыНакопления" Тогда
		Описание.Вставить("registerKind", Строка(ОбъектМетаданных.ВидРегистра));
	ИначеЕсли ИмяКоллекции = "РегистрыБухгалтерии" Тогда
		Описание.Вставить("chart", ПолноеИмяОбъекта(ОбъектМетаданных.ПланСчетов));
	ИначеЕсли ИмяКоллекции = "РегистрыРасчета" Тогда
		Описание.Вставить("chart", ПолноеИмяОбъекта(ОбъектМетаданных.ПланВидовРасчета));
	ИначеЕсли ИмяКоллекции = "ПланыСчетов" Тогда
		Описание.Вставить("subconto", ПолноеИмяОбъекта(ОбъектМетаданных.ВидыСубконто));
	ИначеЕсли ИмяКоллекции = "БизнесПроцессы" Тогда
		Описание.Вставить("task", ПолноеИмяОбъекта(ОбъектМетаданных.Задача));
	ИначеЕсли ИмяКоллекции = "ПланыОбмена" Тогда
		Описание.Вставить("exchangeContent", СоставПланаОбмена(ОбъектМетаданных));
	ИначеЕсли ИмяКоллекции = "ОбщиеМодули" Тогда
		Описание.Вставить("flags", ПризнакиОбщегоМодуля(ОбъектМетаданных));
		Описание.Вставить("reuse", Строка(ОбъектМетаданных.ПовторноеИспользованиеВозвращаемыхЗначений));
	ИначеЕсли ИмяКоллекции = "ОбщиеРеквизиты" Тогда
		Описание.Вставить("content", СоставОбщегоРеквизита(ОбъектМетаданных));
		Описание.Вставить("separation", Строка(ОбъектМетаданных.РазделениеДанных));
	ИначеЕсли ИмяКоллекции = "РегламентныеЗадания" Тогда
		Описание.Вставить("method", Строка(ОбъектМетаданных.ИмяМетода));
		Описание.Вставить("isPredefined", ОбъектМетаданных.Предопределенное);
		Описание.Вставить("use", ОбъектМетаданных.Использование);
	ИначеЕсли ИмяКоллекции = "ПодпискиНаСобытия" Тогда
		// Событие подписки - значение особого типа: ТипЗнч даёт «Строка», а ЗаписатьJSON его не принимает.
		// Поэтому строковые свойства метаданных в индексе приводятся к строке явно
		Описание.Вставить("source", НомерТипа(ОбъектМетаданных.Источник, Порция));
		Описание.Вставить("event", Строка(ОбъектМетаданных.Событие));
		Описание.Вставить("handler", Строка(ОбъектМетаданных.Обработчик));
	ИначеЕсли ИмяКоллекции = "ФункциональныеОпции" Тогда
		Описание.Вставить("storage", ПолноеИмяОбъекта(ОбъектМетаданных.Хранение));
		Описание.Вставить("content", СоставФункциональнойОпции(ОбъектМетаданных));
	ИначеЕсли ИмяКоллекции = "HTTPСервисы" Тогда
		Описание.Вставить("root", Строка(ОбъектМетаданных.КорневойURL));
		Описание.Вставить("urlTemplates", ШаблоныHTTPСервиса(ОбъектМетаданных));
	ИначеЕсли ИмяКоллекции = "WebСервисы" Тогда
		Описание.Вставить("namespace", Строка(ОбъектМетаданных.ПространствоИмен));
		Описание.Вставить("operations", ОперацииWebСервиса(ОбъектМетаданных));
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьИменаПредопределенных(Описание, ОбъектМетаданных)
	
	Попытка
		Имена = ОбъектМетаданных.ПолучитьИменаПредопределенных();
	Исключение
		// Метод есть с 8.3.5: в режиме совместимости 8.2 объект описывается без имён предопределённых
		Возврат;
	КонецПопытки;
	Если Имена.Количество() > 0 Тогда
		Описание.Вставить("predefined", Новый Массив(Имена));
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьПоляИндекса(Описание, Ключ, Поля, Порция)
	
	Если Поля.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Описания = Новый Массив;
	Для Каждого Поле Из Поля Цикл
		Описания.Добавить(ОписаниеПоляИндекса(Поле, Порция));
	КонецЦикла;
	Описание.Вставить(Ключ, Описания);
	Порция.Полей = Порция.Полей + Описания.Количество();
	
КонецПроцедуры

Функция ОписаниеПоляИндекса(Поле, Порция)
	
	// Поле - массив: имя, синоним (пусто, если совпадает с именем), номер типа в таблице типов порции, расширение
	ОписаниеПоля = Новый Массив;
	ОписаниеПоля.Добавить(Поле.Имя);
	ОписаниеПоля.Добавить(?(Поле.Синоним = Поле.Имя, "", Поле.Синоним));
	ОписаниеПоля.Добавить(НомерТипа(Поле.Тип, Порция));
	Если Порция.ЕстьРасширения Тогда
		Расширение = РасширениеОбъекта(Поле);
		Если ЗначениеЗаполнено(Расширение) Тогда
			ОписаниеПоля.Добавить(Расширение);
		КонецЕсли;
	КонецЕсли;
	Возврат ОписаниеПоля;
	
КонецФункции

Процедура ДобавитьТабличныеЧастиИндекса(Описание, ОбъектМетаданных, Порция)
	
	Если ОбъектМетаданных.ТабличныеЧасти.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Описания = Новый Массив;
	Для Каждого ТабличнаяЧасть Из ОбъектМетаданных.ТабличныеЧасти Цикл
		ОписаниеЧасти = Новый Структура;
		ОписаниеЧасти.Вставить("name", ТабличнаяЧасть.Имя);
		Если ТабличнаяЧасть.Синоним <> ТабличнаяЧасть.Имя Тогда
			ОписаниеЧасти.Вставить("synonym", ТабличнаяЧасть.Синоним);
		КонецЕсли;
		Если Порция.ЕстьРасширения Тогда
			Расширение = РасширениеОбъекта(ТабличнаяЧасть);
			Если ЗначениеЗаполнено(Расширение) Тогда
				ОписаниеЧасти.Вставить("extension", Расширение);
			КонецЕсли;
		КонецЕсли;
		ДобавитьПоляИндекса(ОписаниеЧасти, "attributes", ТабличнаяЧасть.Реквизиты, Порция);
		Описания.Добавить(ОписаниеЧасти);
	КонецЦикла;
	Описание.Вставить("tables", Описания);
	
КонецПроцедуры

Функция ЗначенияПеречисленияИндекса(ОбъектМетаданных)
	
	Значения = Новый Массив;
	Для Каждого ЗначениеПеречисления Из ОбъектМетаданных.ЗначенияПеречисления Цикл
		ОписаниеЗначенияПеречисления = Новый Массив;
		ОписаниеЗначенияПеречисления.Добавить(ЗначениеПеречисления.Имя);
		ОписаниеЗначенияПеречисления.Добавить(?(ЗначениеПеречисления.Синоним = ЗначениеПеречисления.Имя, "",
			ЗначениеПеречисления.Синоним));
		Значения.Добавить(ОписаниеЗначенияПеречисления);
	КонецЦикла;
	Возврат Значения;
	
КонецФункции

Функция ПолноеИмяОбъекта(ОбъектМетаданных)
	
	Возврат ?(ОбъектМетаданных = Неопределено, "", ОбъектМетаданных.ПолноеИмя());
	
КонецФункции

Функция СоставПланаОбмена(ОбъектМетаданных)
	
	// Элемент состава - массив: полное имя объекта и признак авторегистрации изменений
	Состав = Новый Массив;
	Для Каждого ЭлементСостава Из ОбъектМетаданных.Состав Цикл
		Элемент = Новый Массив;
		Элемент.Добавить(ЭлементСостава.Метаданные.ПолноеИмя());
		Элемент.Добавить(ЭлементСостава.АвтоРегистрация = АвтоРегистрацияИзменений.Разрешить);
		Состав.Добавить(Элемент);
	КонецЦикла;
	Возврат Состав;
	
КонецФункции

Функция ПризнакиОбщегоМодуля(ОбъектМетаданных)
	
	Значения = Новый Структура;
	Значения.Вставить("Глобальный", ОбъектМетаданных.Глобальный);
	Значения.Вставить("Сервер", ОбъектМетаданных.Сервер);
	Значения.Вставить("ВызовСервера", ОбъектМетаданных.ВызовСервера);
	Значения.Вставить("КлиентУправляемоеПриложение", ОбъектМетаданных.КлиентУправляемоеПриложение);
	Значения.Вставить("КлиентОбычноеПриложение", ОбъектМетаданных.КлиентОбычноеПриложение);
	Значения.Вставить("ВнешнееСоединение", ОбъектМетаданных.ВнешнееСоединение);
	Значения.Вставить("Привилегированный", ОбъектМетаданных.Привилегированный);
	
	Признаки = Новый Массив;
	Для Каждого КлючИЗначение Из Значения Цикл
		Если КлючИЗначение.Значение Тогда
			Признаки.Добавить(КлючИЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат Признаки;
	
КонецФункции

Функция СоставОбщегоРеквизита(ОбъектМетаданных)
	
	// Элемент с использованием «Авто» входит в состав, только если у реквизита включено автоиспользование
	СвойстваОбъектов = Метаданные.СвойстваОбъектов;
	ВключеноАвто = СвойстваОбъектов.АвтоИспользованиеОбщегоРеквизита.Использовать;
	Автоиспользование = ОбъектМетаданных.АвтоИспользование = ВключеноАвто;
	Состав = Новый Массив;
	Для Каждого ЭлементСостава Из ОбъектМетаданных.Состав Цикл
		Использование = ЭлементСостава.Использование;
		Если Использование = СвойстваОбъектов.ИспользованиеОбщегоРеквизита.Использовать
			Или Автоиспользование И Использование = СвойстваОбъектов.ИспользованиеОбщегоРеквизита.Авто Тогда
			Состав.Добавить(ЭлементСостава.Метаданные.ПолноеИмя());
		КонецЕсли;
	КонецЦикла;
	Возврат Состав;
	
КонецФункции

Функция СоставФункциональнойОпции(ОбъектМетаданных)
	
	Состав = Новый Массив;
	Для Каждого ЭлементСостава Из ОбъектМетаданных.Состав Цикл
		Если ЭлементСостава.Объект <> Неопределено Тогда
			Состав.Добавить(ЭлементСостава.Объект.ПолноеИмя());
		КонецЕсли;
	КонецЦикла;
	Возврат Состав;
	
КонецФункции

Функция ШаблоныHTTPСервиса(ОбъектМетаданных)
	
	// Шаблон - массив: шаблон URL и методы, метод - массив: HTTP-метод и обработчик
	Шаблоны = Новый Массив;
	Для Каждого ШаблонURL Из ОбъектМетаданных.ШаблоныURL Цикл
		Методы = Новый Массив;
		Для Каждого Метод Из ШаблонURL.Методы Цикл
			ОписаниеМетода = Новый Массив;
			ОписаниеМетода.Добавить(Строка(Метод.HTTPМетод));
			ОписаниеМетода.Добавить(Строка(Метод.Обработчик));
			Методы.Добавить(ОписаниеМетода);
		КонецЦикла;
		ОписаниеШаблона = Новый Массив;
		ОписаниеШаблона.Добавить(Строка(ШаблонURL.Шаблон));
		ОписаниеШаблона.Добавить(Методы);
		Шаблоны.Добавить(ОписаниеШаблона);
	КонецЦикла;
	Возврат Шаблоны;
	
КонецФункции

Функция ОперацииWebСервиса(ОбъектМетаданных)
	
	Операции = Новый Массив;
	Для Каждого Операция Из ОбъектМетаданных.Операции Цикл
		ОписаниеОперации = Новый Массив;
		ОписаниеОперации.Добавить(Операция.Имя);
		ОписаниеОперации.Добавить(Строка(Операция.ИмяПроцедуры));
		Операции.Добавить(ОписаниеОперации);
	КонецЦикла;
	Возврат Операции;
	
КонецФункции

Функция НомерТипа(ОписаниеТипов, Порция)
	
	Имена = Новый Массив;
	Для Каждого ТипЗначения Из ОписаниеТипов.Типы() Цикл
		Имена.Добавить(ИмяТипаПорции(ТипЗначения, ОписаниеТипов, Порция));
	КонецЦикла;
	
	// Типы полей хранятся таблицей порции: составной тип (например, определяемый) записывается один раз
	Ключ = СоединенныеСтроки(Имена, ",");
	Номер = Порция.НомераТипов.Получить(Ключ);
	Если Номер = Неопределено Тогда
		Номер = Порция.Типы.Количество();
		Порция.Типы.Добавить(Имена);
		Порция.НомераТипов.Вставить(Ключ, Номер);
	КонецЕсли;
	Возврат Номер;
	
КонецФункции

Функция ИмяТипаПорции(ТипЗначения, ОписаниеТипов, Порция)
	
	// Квалификаторы бывают только у строк и чисел; имена прочих типов повторяются - их запоминаем
	Если ТипЗначения = Тип("Строка") Или ТипЗначения = Тип("Число") Тогда
		Возврат ИмяТипа(ТипЗначения, ОписаниеТипов);
	КонецЕсли;
	Имя = Порция.ИменаПоТипам.Получить(ТипЗначения);
	Если Имя = Неопределено Тогда
		Имя = ИмяТипа(ТипЗначения);
		Порция.ИменаПоТипам.Вставить(ТипЗначения, Имя);
	КонецЕсли;
	Возврат Имя;
	
КонецФункции

Функция ТекстJSON(Данные)
	
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
	
КонецФункции

#КонецОбласти

#Область СтроковыеФункции

Функция СтрокаПоШаблону(Шаблон, Параметр1 = Неопределено, Параметр2 = Неопределено,
	Параметр3 = Неопределено, Параметр4 = Неопределено, Параметр5 = Неопределено)
	
	Параметры = Новый Массив;
	Параметры.Добавить(Параметр1);
	Параметры.Добавить(Параметр2);
	Параметры.Добавить(Параметр3);
	Параметры.Добавить(Параметр4);
	Параметры.Добавить(Параметр5);
	
	Результат = "";
	Остаток = Шаблон;
	Позиция = Найти(Остаток, "%");
	Пока Позиция > 0 Цикл
		Результат = Результат + Лев(Остаток, Позиция - 1);
		Знак = Сред(Остаток, Позиция + 1, 1);
		Номер = ?(Знак = "", 0, Найти("12345", Знак));
		Если Знак = "%" Тогда
			Результат = Результат + "%";
			Остаток = Сред(Остаток, Позиция + 2);
		ИначеЕсли Номер > 0 Тогда
			Результат = Результат + Строка(Параметры[Номер - 1]);
			Остаток = Сред(Остаток, Позиция + 2);
		Иначе
			Результат = Результат + "%";
			Остаток = Сред(Остаток, Позиция + 1);
		КонецЕсли;
		Позиция = Найти(Остаток, "%");
	КонецЦикла;
	Возврат Результат + Остаток;
	
КонецФункции

Функция ЧастиСтроки(Знач Текст, Разделитель, ВключатьПустые = Истина)
	
	Части = Новый Массив;
	ДлинаРазделителя = СтрДлина(Разделитель);
	Позиция = Найти(Текст, Разделитель);
	Пока Позиция > 0 Цикл
		Часть = Лев(Текст, Позиция - 1);
		Если ВключатьПустые Или Часть <> "" Тогда
			Части.Добавить(Часть);
		КонецЕсли;
		Текст = Сред(Текст, Позиция + ДлинаРазделителя);
		Позиция = Найти(Текст, Разделитель);
	КонецЦикла;
	Если ВключатьПустые Или Текст <> "" Тогда
		Части.Добавить(Текст);
	КонецЕсли;
	Возврат Части;
	
КонецФункции

Функция СоединенныеСтроки(Строки, Разделитель = "")
	
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();
	Первая = Истина;
	Для Каждого Часть Из Строки Цикл
		Если Не Первая И Разделитель <> "" Тогда
			Запись.ЗаписатьБезОбработки(Разделитель);
		КонецЕсли;
		Запись.ЗаписатьБезОбработки(Строка(Часть));
		Первая = Ложь;
	КонецЦикла;
	Возврат Запись.Закрыть();
	
КонецФункции

