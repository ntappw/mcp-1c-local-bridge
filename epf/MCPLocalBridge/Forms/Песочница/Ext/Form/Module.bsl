
#Область ПрограммныйИнтерфейс

// Служебная форма моста: в её модуле выполняется клиентский код агента. Форма не открывается и не хранит
// ничего от моста: разрешения, журнал и серверные методы основной формы коду агента отсюда не видны.

// Вычисляет выражение агента на клиенте.
//
// Параметры:
//  Выражение - Строка - выражение 1С.
//  КлиентТестирования - ТестируемоеПриложение, Неопределено - подключённый клиент тестирования: выражение
//                       обращается к нему по этому имени.
//
// Возвращаемое значение:
//  Произвольный - значение выражения.
//
&НаКлиенте
Функция ЗначениеВыражения(Выражение, КлиентТестирования) Экспорт
	
	Возврат Вычислить(Выражение);
	
КонецФункции

// Выполняет код агента на клиенте.
//
// Параметры:
//  Код - Строка - операторы 1С; результат - переменная Результат.
//  КлиентТестирования - ТестируемоеПриложение, Неопределено - подключённый клиент тестирования: код
//                       обращается к нему по этому имени.
//
// Возвращаемое значение:
//  Произвольный - значение переменной Результат.
//
&НаКлиенте
Функция ЗначениеКода(Код, КлиентТестирования) Экспорт
	
	Результат = Неопределено;
	Выполнить(Код);
	Возврат Результат;
	
КонецФункции

#КонецОбласти
