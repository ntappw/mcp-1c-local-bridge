
#Область ОписаниеПеременных

&НаКлиенте
Перем ДанныеСеанса;

&НаКлиенте
Перем ИдентификаторСеанса;

&НаКлиенте
Перем КаталогСеанса;

&НаКлиенте
Перем СвойКаталогОбмена;

&НаКлиенте
Перем МоментСердцебиения;

&НаКлиенте
Перем ВыполненоКоманд;

&НаКлиенте
Перем ЗаписиЖурнала;

&НаКлиенте
Перем ОжидающийОтвет;

&НаКлиенте
Перем РазрешитьЗапись;

&НаКлиенте
Перем РазрешитьКодНаКлиенте;

&НаКлиенте
Перем РучнаяВыдача;

&НаКлиенте
Перем Приостановлен;

&НаКлиенте
Перем ОшибкаМоста;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЗаписиЖурнала = Новый Массив;
	ВыполненоКоманд = 0;
	МоментСердцебиения = 0;
	РазрешитьЗапись = Ложь;
	РазрешитьКодНаКлиенте = Истина;
	РучнаяВыдача = Ложь;
	Приостановлен = Ложь;
	ОшибкаМоста = "";
	
	ДанныеСеанса = СведенияСеанса();
	Система = Новый СистемнаяИнформация;
	ДанныеСеанса.Вставить("platform", Система.ВерсияПриложения);
	СвойКаталогОбмена = СохраненныйКаталогОбмена();
	
	Попытка
		ПодготовитьКаталогСеанса();
		ЗаписатьСведенияСеанса();
	Исключение
		ОшибкаМоста = "Каталог обмена недоступен: " + ИнформацияОбОшибке().Описание;
	КонецПопытки;
	
	Отрисовать();
	Если Не ЗначениеЗаполнено(ОшибкаМоста) Тогда
		ЗапланироватьОпрос();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Попытка
		ОтключитьОбработчикОжидания("ОбработатьОчередь");
	Исключение
		// Обработчик мог быть уже снят платформой
	КонецПопытки;
	
	УдалитьКаталогСеанса(КаталогСеанса);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПанельHTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	Действие = ДействиеСсылки(ДанныеСобытия);
	Если Не ЗначениеЗаполнено(Действие) Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	ВыполнитьДействие(Действие);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Действия

&НаКлиенте
Функция ДействиеСсылки(ДанныеСобытия)
	
	Ссылка = "";
	Если Не ДанныеСобытия.Свойство("Href", Ссылка) Или ТипЗнч(Ссылка) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	Позиция = СтрНайти(Ссылка, "#act:");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Сред(Ссылка, Позиция + СтрДлина("#act:"));
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьДействие(Действие)
	
	Если Действие = "pause" Тогда
		Приостановлен = Не Приостановлен;
	ИначеЕсли Действие = "mode-auto" Тогда
		РучнаяВыдача = Ложь;
	ИначеЕсли Действие = "mode-manual" Тогда
		РучнаяВыдача = Истина;
	ИначеЕсли Действие = "write" Тогда
		РазрешитьЗапись = Не РазрешитьЗапись;
	ИначеЕсли Действие = "client" Тогда
		РазрешитьКодНаКлиенте = Не РазрешитьКодНаКлиенте;
	ИначеЕсли Действие = "approve" Тогда
		ЗавершитьОжидание(Истина);
	ИначеЕсли Действие = "deny" Тогда
		ЗавершитьОжидание(Ложь);
	ИначеЕсли Действие = "clear" Тогда
		ЗаписиЖурнала.Очистить();
		ОчиститьЖурналНаСтранице();
	ИначеЕсли Действие = "folder" И ЗначениеЗаполнено(КаталогСеанса) Тогда
		ЗапуститьПриложение(КаталогСеанса);
	ИначеЕсли Действие = "dir-change" Тогда
		ВыбратьКаталогОбмена();
	ИначеЕсли Действие = "dir-default" Тогда
		СменитьКаталогОбмена("");
	КонецЕсли;
	ОбновитьСердцебиение();
	ОбновитьБлоки();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьОжидание(Разрешено)
	
	Если ОжидающийОтвет = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Ответ = ОжидающийОтвет.Ответ;
	ТекстОтвета = ОжидающийОтвет.ТекстОтвета;
	Если Не Разрешено Тогда
		ОтветБезДанных = Новый Структура;
		ОтветБезДанных.Вставить("protocol", 1);
		ОтветБезДанных.Вставить("id", Ответ.id);
		ОтветБезДанных.Вставить("status", "denied");
		ОтветБезДанных.Вставить("error", "Пользователь не разрешил выдачу результата агенту.");
		ОтветБезДанных.Вставить("durationMs", Ответ.durationMs);
		ТекстОтвета = ТекстJSON(ОтветБезДанных, Ложь);
	КонецЕсли;
	ОтдатьОтвет(Ответ.id, ТекстОтвета, ОжидающийОтвет.ФайлВРаботе);
	Запись = ОжидающийОтвет.Запись;
	Запись.Выдача = ?(Разрешено, "отдано", "не отдано");
	ОжидающийОтвет = Неопределено;
	ОбновитьЗаписьНаСтранице(Запись);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьКаталогОбмена()
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = "Каталог обмена с MCP-сервером";
	Диалог.Каталог = КаталогОбмена();
	// Показать, а не Выбрать: модальный диалог недоступен, если в конфигурации модальность не используется
	Диалог.Показать(Новый ОписаниеОповещения("ПослеВыбораКаталогаОбмена", ЭтотОбъект));
	
КонецПроцедуры

// Переносит сеанс моста в каталог обмена, выбранный в диалоге.
//
// Параметры:
//  ВыбранныеФайлы - Массив из Строка - выбранный каталог;
//                 - Неопределено - выбор отменён.
//  ДополнительныеПараметры - Неопределено - не используются.
//
&НаКлиенте
Процедура ПослеВыбораКаталогаОбмена(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	СменитьКаталогОбмена(ВыбранныеФайлы[0]);
	ОбновитьБлоки();
	
КонецПроцедуры

&НаКлиенте
Процедура СменитьКаталогОбмена(Каталог)
	
	// Ответ на команду, ждущую решения, пишется в каталог сеанса, где его ждёт MCP
	Если ОжидающийОтвет <> Неопределено Тогда
		ПоказатьПредупреждение(,"Каталог обмена не сменён: сначала решите, отдавать ли агенту результат.");
		Возврат;
	КонецЕсли;
	
	НовыйСвойКаталог = КаталогДляНастройки(Каталог);
	Если НРег(НовыйСвойКаталог) = НРег(СвойКаталогОбмена) И Не ЗначениеЗаполнено(ОшибкаМоста) Тогда
		Возврат;
	КонецЕсли;
	
	ПрежнийСвойКаталог = СвойКаталогОбмена;
	ПрежнийКаталогСеанса = КаталогСеанса;
	ПрежнийИдентификатор = ИдентификаторСеанса;
	СвойКаталогОбмена = НовыйСвойКаталог;
	Попытка
		ПодготовитьКаталогСеанса();
		ЗаписатьСведенияСеанса();
	Исключение
		Описание = ИнформацияОбОшибке().Описание;
		Если КаталогСеанса <> ПрежнийКаталогСеанса Тогда
			УдалитьКаталогСеанса(КаталогСеанса);
		КонецЕсли;
		СвойКаталогОбмена = ПрежнийСвойКаталог;
		КаталогСеанса = ПрежнийКаталогСеанса;
		ИдентификаторСеанса = ПрежнийИдентификатор;
		ДанныеСеанса.Вставить("session", ИдентификаторСеанса);
		ДанныеСеанса.Вставить("path", КаталогСеанса);
		ПоказатьПредупреждение(,"Каталог обмена не сменён: " + Описание);
		Возврат;
	КонецПопытки;
	
	// Сеанс переехал под новым идентификатором; команды, не начатые в прежнем каталоге, агент пошлёт заново
	УдалитьКаталогСеанса(ПрежнийКаталогСеанса);
	ОшибкаМоста = "";
	// После неудачного открытия формы опрос не запускался, а если он идёт - второй обработчик не нужен
	ОтключитьОбработчикОжидания("ОбработатьОчередь");
	ЗапланироватьОпрос();
	
	Попытка
		СохранитьКаталогОбмена(СвойКаталогОбмена);
	Исключение
		ПоказатьПредупреждение(,"Каталог обмена сменён, но запомнить его не удалось: "
			+ ИнформацияОбОшибке().Описание);
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область Опрос

&НаКлиенте
Процедура ОбработатьОчередь()
	
	Если Не Приостановлен И ОжидающийОтвет = Неопределено Тогда
		Попытка
			ВыполнитьВходящиеКоманды();
		Исключение
			ПоказатьОшибкуМоста("Ошибка опроса: " + ИнформацияОбОшибке().Описание);
		КонецПопытки;
	КонецЕсли;
	Если ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментСердцебиения >= 2000 Тогда
		ОбновитьСердцебиение();
	КонецЕсли;
	ЗапланироватьОпрос();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапланироватьОпрос()
	
	// Интервал меньше секунды допускается только для однократного обработчика: подключаем заново после опроса
	ПодключитьОбработчикОжидания("ОбработатьОчередь", 0.5, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОшибкуМоста(Текст)
	
	Если ОшибкаМоста <> Текст Тогда
		ОшибкаМоста = Текст;
		ОбновитьБлоки();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьВходящиеКоманды()
	
	Файлы = НайтиФайлы(КаталогСеанса + "in", "*.json");
	Если Файлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Идентификаторы команд начинаются с момента создания: порядок имён - порядок поступления
	Имена = Новый СписокЗначений;
	Для Каждого ФайлКоманды Из Файлы Цикл
		Имена.Добавить(ФайлКоманды.Имя);
	КонецЦикла;
	Имена.СортироватьПоЗначению();
	
	Для Каждого ЭлементСписка Из Имена Цикл
		Если ОжидающийОтвет <> Неопределено Или Приостановлен Тогда
			Прервать;
		КонецЕсли;
		ВыполнитьКомандуИзФайла(ЭлементСписка.Значение);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКомандуИзФайла(ИмяФайла)
	
	Разделитель = ПолучитьРазделительПути();
	ИдентификаторКоманды = Лев(ИмяФайла, СтрДлина(ИмяФайла) - СтрДлина(".json"));
	ФайлВРаботе = КаталогСеанса + "work" + Разделитель + ИмяФайла;
	Попытка
		ПереместитьФайл(КаталогСеанса + "in" + Разделитель + ИмяФайла, ФайлВРаботе);
	Исключение
		// Команду успел снять MCP: истёк срок, за который её нужно было начать
		Возврат;
	КонецПопытки;
	
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Команда = Неопределено;
	Попытка
		Команда = ДанныеФайлаJSON(ФайлВРаботе);
		Ответ = ОтветНаКоманду(Команда, ИдентификаторКоманды, ФайлВРаботе);
	Исключение
		Ответ = ОтветОбОшибке(ИнформацияОбОшибке());
	КонецПопытки;
	Ответ.Вставить("protocol", 1);
	Ответ.Вставить("id", ИдентификаторКоманды);
	Ответ.Вставить("durationMs", ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало);
	ТекстОтвета = ТекстОтветаДляФайла(Ответ);
	
	ВыполненоКоманд = ВыполненоКоманд + 1;
	ОшибкаМоста = "";
	Запись = НоваяЗаписьЖурнала(ИдентификаторКоманды, Команда, Ответ, ТекстОтвета);
	ЗаписиЖурнала.Вставить(0, Запись);
	Пока ЗаписиЖурнала.Количество() > 50 Цикл
		ЗаписиЖурнала.Удалить(ЗаписиЖурнала.ВГраница());
	КонецЦикла;
	
	// В ручном режиме ответ ждёт решения пользователя; не начатую вовремя команду решать нечего
	Если РучнаяВыдача И Ответ.status <> "expired" Тогда
		Запись.Выдача = "ждёт";
		ОжидающийОтвет = Новый Структура;
		ОжидающийОтвет.Вставить("Ответ", Ответ);
		ОжидающийОтвет.Вставить("ТекстОтвета", ТекстОтвета);
		ОжидающийОтвет.Вставить("Запись", Запись);
		ОжидающийОтвет.Вставить("ФайлВРаботе", ФайлВРаботе);
		ОбновитьСердцебиение();
		ПоказатьНовуюЗапись(Запись, Истина);
		ПоказатьОповещениеПользователя("Мост MCP: результат ждёт решения",, Запись.Текст);
		Активизировать();
		Возврат;
	КонецЕсли;
	
	ОтдатьОтвет(ИдентификаторКоманды, ТекстОтвета, ФайлВРаботе);
	Запись.Выдача = "авто";
	ОбновитьСердцебиение();
	ПоказатьНовуюЗапись(Запись, Ложь);
	
КонецПроцедуры

&НаКлиенте
Функция ТекстОтветаДляФайла(Ответ)
	
	Попытка
		Возврат ТекстJSON(Ответ, Ложь);
	Исключение
		// Результат не записался в JSON: агент получит ошибку вместо него
		ОтветСОшибкой = ОтветОбОшибке(ИнформацияОбОшибке());
		ОтветСОшибкой.Вставить("protocol", 1);
		ОтветСОшибкой.Вставить("id", Ответ.id);
		ОтветСОшибкой.Вставить("durationMs", Ответ.durationMs);
		Возврат ТекстJSON(ОтветСОшибкой, Ложь);
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Функция ОтветНаКоманду(Команда, ИдентификаторКоманды, ФайлВРаботе)
	
	Если КомандаПросрочена(Команда, ФайлВРаботе) Тогда
		Ответ = Новый Структура;
		Ответ.Вставить("status", "expired");
		Ответ.Вставить("error", "Команда не начата в отведённый срок.");
		Возврат Ответ;
	КонецЕсли;
	
	ОбновитьСердцебиение(ИдентификаторКоманды);
	Вид = Команда.Получить("type");
	Если Команда.Получить("side") = "client" И (Вид = "eval" Или Вид = "execute") Тогда
		Возврат ОтветКлиентскогоВыполнения(Команда);
	КонецЕсли;
	Возврат ОтветСервера(Команда, РазрешитьЗапись);
	
КонецФункции

&НаКлиенте
Функция КомандаПросрочена(Команда, ФайлВРаботе)
	
	Срок = Команда.Получить("ttlSec");
	Если ТипЗнч(Срок) <> Тип("Число") Или Срок <= 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	// Время изменения ставит Windows при записи файла MCP, перемещение его не меняет
	ФайлКоманды = Новый Файл(ФайлВРаботе);
	Создана = ФайлКоманды.ПолучитьУниверсальноеВремяИзменения();
	Возврат УниверсальнаяДатаКлиента() - Создана > Срок;
	
КонецФункции

&НаКлиенте
Функция УниверсальнаяДатаКлиента()
	
	// ТекущаяУниверсальнаяДата() в тонком клиенте недоступна; миллисекунды отсчитываются от 01.01.0001 UTC
	Возврат Дата(1, 1, 1) + Цел(ТекущаяУниверсальнаяДатаВМиллисекундах() / 1000);
	
КонецФункции

&НаСервере
Функция ОтветСервера(Команда, ЗаписьРазрешена)
	
	Возврат РеквизитФормыВЗначение("Объект").ОтветНаКоманду(Команда, ЗаписьРазрешена);
	
КонецФункции

&НаКлиенте
Функция ОтветКлиентскогоВыполнения(Команда)
	
	Ответ = Новый Структура;
	Если Не РазрешитьКодНаКлиенте Тогда
		Ответ.Вставить("status", "rejected");
		Ответ.Вставить("error", "Код на клиенте не разрешён: на форме обработки выключен «Код на клиенте».");
		Возврат Ответ;
	КонецЕсли;
	
	// Код на клиенте видит переменные этой формы: разрешения и режим восстанавливаются после него
	БылаЗапись = РазрешитьЗапись;
	БылРучнойРежим = РучнаяВыдача;
	Попытка
		Если Команда.Получить("type") = "eval" Тогда
			Значение = ЗначениеВыраженияНаКлиенте(Команда.Получить("expression"));
		Иначе
			Значение = ЗначениеКодаНаКлиенте(Команда.Получить("code"));
		КонецЕсли;
	Исключение
		РазрешитьЗапись = БылаЗапись;
		РучнаяВыдача = БылРучнойРежим;
		РазрешитьКодНаКлиенте = Истина;
		Возврат ОтветОбОшибке(ИнформацияОбОшибке());
	КонецПопытки;
	РазрешитьЗапись = БылаЗапись;
	РучнаяВыдача = БылРучнойРежим;
	РазрешитьКодНаКлиенте = Истина;
	
	Ответ.Вставить("status", "ok");
	Ответ.Вставить("result", КлиентскоеЗначениеДляJSON(Значение));
	Возврат Ответ;
	
КонецФункции

&НаКлиенте
Функция ЗначениеВыраженияНаКлиенте(Выражение)
	
	Возврат Вычислить(Выражение);
	
КонецФункции

&НаКлиенте
Функция ЗначениеКодаНаКлиенте(Код)
	
	Результат = Неопределено;
	Выполнить(Код);
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция КлиентскоеЗначениеДляJSON(Значение)
	
	Попытка
		Возврат ЗначениеДляJSONНаСервере(Значение);
	Исключение
		// Значения клиентских типов (формы, описания оповещений) на сервер не передаются
	КонецПопытки;
	
	Описание = Новый Структура;
	Описание.Вставить("_type", Строка(ТипЗнч(Значение)));
	Попытка
		Описание.Вставить("_presentation", Строка(Значение));
	Исключение
		Описание.Вставить("_presentation", "");
	КонецПопытки;
	Возврат Описание;
	
КонецФункции

&НаСервере
Функция ЗначениеДляJSONНаСервере(Значение)
	
	Возврат РеквизитФормыВЗначение("Объект").ЗначениеДляJSON(Значение);
	
КонецФункции

&НаКлиенте
Функция ОтветОбОшибке(Информация)
	
	Ответ = Новый Структура;
	Ответ.Вставить("status", "error");
	Ответ.Вставить("error", Информация.Описание);
	Ответ.Вставить("errorDetails", ПодробноеПредставлениеОшибки(Информация));
	Возврат Ответ;
	
КонецФункции

#КонецОбласти

#Область Файлы

&НаКлиенте
Процедура ПодготовитьКаталогСеанса()
	
	Разделитель = ПолучитьРазделительПути();
	Корень = КаталогОбмена();
	Если Прав(Корень, 1) <> Разделитель Тогда
		Корень = Корень + Разделитель;
	КонецЕсли;
	
	ИдентификаторСеанса = НРег(Лев(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""), 8));
	КаталогСеанса = Корень + ИдентификаторСеанса + Разделитель;
	СоздатьКаталог(КаталогСеанса + "in");
	СоздатьКаталог(КаталогСеанса + "work");
	СоздатьКаталог(КаталогСеанса + "out");
	
	ДанныеСеанса.Вставить("session", ИдентификаторСеанса);
	ДанныеСеанса.Вставить("path", КаталогСеанса);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьКаталогСеанса(Каталог)
	
	Если Не ЗначениеЗаполнено(Каталог) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		УдалитьФайлы(Лев(Каталог, СтрДлина(Каталог) - 1));
	Исключение
		// Каталог молчащего сеанса через сутки удалит MCP-сервер, который работает с этим каталогом обмена
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Функция КаталогОбмена()
	
	Возврат ?(ЗначениеЗаполнено(СвойКаталогОбмена), СвойКаталогОбмена, СтандартныйКаталогОбмена());
	
КонецФункции

&НаКлиенте
Функция СтандартныйКаталогОбмена()
	
	// Здесь же сеансы ищет MCP-сервер, если ему не задан MCP_1C_BRIDGE_DIR
	КаталогВременных = КаталогВременныхФайлов();
	Если Прав(КаталогВременных, 1) <> ПолучитьРазделительПути() Тогда
		КаталогВременных = КаталогВременных + ПолучитьРазделительПути();
	КонецЕсли;
	Возврат КаталогВременных + "mcp-1c-local-bridge";
	
КонецФункции

&НаКлиенте
Функция КаталогДляНастройки(Каталог)
	
	// Стандартный каталог в настройке не хранится: пустое значение и означает каталог по умолчанию
	Результат = СокрЛП(Каталог);
	Если СтрДлина(Результат) > 3 И Прав(Результат, 1) = ПолучитьРазделительПути() Тогда
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЕсли;
	Если НРег(Результат) = НРег(СтандартныйКаталогОбмена()) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьСердцебиение(КомандаВРаботе = "")
	
	Если Не ЗначениеЗаполнено(КаталогСеанса) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ЗаписатьСведенияСеанса(КомандаВРаботе);
	Исключение
		// session.json мог быть открыт MCP на чтение: запишем при следующем опросе
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьСведенияСеанса(КомандаВРаботе = "")
	
	Если ЗначениеЗаполнено(КомандаВРаботе) Тогда
		СостояниеСеанса = "busy";
		ТекущаяКоманда = КомандаВРаботе;
	ИначеЕсли ОжидающийОтвет <> Неопределено Тогда
		СостояниеСеанса = "awaiting";
		ТекущаяКоманда = ОжидающийОтвет.Ответ.id;
	ИначеЕсли Приостановлен Тогда
		СостояниеСеанса = "paused";
		ТекущаяКоманда = "";
	Иначе
		СостояниеСеанса = "ready";
		ТекущаяКоманда = "";
	КонецЕсли;
	
	ДанныеСеанса.Вставить("state", СостояниеСеанса);
	ДанныеСеанса.Вставить("busyCommand", ТекущаяКоманда);
	ДанныеСеанса.Вставить("heartbeat", XMLСтрока(УниверсальнаяДатаКлиента()));
	ДанныеСеанса.Вставить("mode", ?(РучнаяВыдача, "manual", "auto"));
	ДанныеСеанса.Вставить("allowWrite", РазрешитьЗапись);
	ДанныеСеанса.Вставить("allowClientCode", РазрешитьКодНаКлиенте);
	ДанныеСеанса.Вставить("commandsDone", ВыполненоКоманд);
	ЗаписатьТекстовыйФайл(КаталогСеанса + "session.json", ТекстJSON(ДанныеСеанса, Ложь));
	МоментСердцебиения = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтдатьОтвет(Идентификатор, ТекстОтвета, ФайлВРаботе)
	
	ИмяБезРасширения = КаталогСеанса + "out" + ПолучитьРазделительПути() + Идентификатор;
	// Ответ пишется во временный файл и переименовывается: MCP не увидит его недописанным
	ЗаписатьТекстовыйФайл(ИмяБезРасширения + ".tmp", ТекстОтвета);
	ПереместитьФайл(ИмяБезРасширения + ".tmp", ИмяБезРасширения + ".json");
	
	Попытка
		УдалитьФайлы(ФайлВРаботе);
	Исключение
		// MCP ориентируется на файл ответа, оставшийся файл команды работе не мешает
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьТекстовыйФайл(ИмяФайла, Текст)
	
	Запись = Новый ЗаписьТекста(ИмяФайла, КодировкаТекста.UTF8);
	Попытка
		Запись.Записать(Текст);
	Исключение
		Запись.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Запись.Закрыть();
	
КонецПроцедуры

&НаКлиенте
Функция ТекстJSON(Данные, СПереносами)
	
	Перенос = ?(СПереносами, ПереносСтрокJSON.Авто, ПереносСтрокJSON.Нет);
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(Перенос, " "));
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
	
КонецФункции

&НаКлиенте
Функция ДанныеФайлаJSON(ИмяФайла)
	
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(ИмяФайла, "UTF-8");
	Попытка
		Данные = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Чтение.Закрыть();
	Возврат Данные;
	
КонецФункции

&НаСервереБезКонтекста
Функция СведенияСеанса()
	
	Система = Новый СистемнаяИнформация;
	Сведения = Новый Структура;
	Сведения.Вставить("protocol", 1);
	Сведения.Вставить("bridgeVersion", "1.1.0");
	Сведения.Вставить("infobase", СтрокаСоединенияИнформационнойБазы());
	Сведения.Вставить("user", ИмяПользователя());
	Сведения.Вставить("userFullName", ПолноеИмяПользователя());
	Сведения.Вставить("sessionNumber", НомерСеансаИнформационнойБазы());
	Сведения.Вставить("configuration", Метаданные.Имя);
	Сведения.Вставить("configurationSynonym", Метаданные.Синоним);
	Сведения.Вставить("configurationVersion", Метаданные.Версия);
	Сведения.Вставить("compatibilityMode", Строка(Метаданные.РежимСовместимости));
	Сведения.Вставить("serverPlatform", Система.ВерсияПриложения);
	Сведения.Вставить("started", XMLСтрока(ТекущаяУниверсальнаяДата()));
	Возврат Сведения;
	
КонецФункции

&НаСервереБезКонтекста
Функция СохраненныйКаталогОбмена()
	
	Каталог = ХранилищеОбщихНастроек.Загрузить("MCPLocalBridge", "КаталогОбмена");
	Возврат ?(ТипЗнч(Каталог) = Тип("Строка"), Каталог, "");
	
КонецФункции

&НаСервереБезКонтекста
Процедура СохранитьКаталогОбмена(Каталог)
	
	// Пустая строка - каталог по умолчанию
	ХранилищеОбщихНастроек.Сохранить("MCPLocalBridge", "КаталогОбмена", Каталог);
	
КонецПроцедуры

#КонецОбласти

#Область Журнал

&НаКлиенте
Функция НоваяЗаписьЖурнала(ИдентификаторКоманды, Команда, Ответ, ТекстОтвета)
	
	Вид = "";
	Клиентская = Ложь;
	ТекстКоманды = "";
	ТекстПараметров = "";
	Если ТипЗнч(Команда) = Тип("Соответствие") Тогда
		Вид = Строка(Команда.Получить("type"));
		Клиентская = Команда.Получить("side") = "client";
		ТекстКоманды = ПолныйТекстКоманды(Команда);
		ПараметрыКоманды = Команда.Получить("params");
		Если ПараметрыКоманды <> Неопределено Тогда
			ТекстПараметров = ТекстJSON(ПараметрыКоманды, Истина);
		КонецЕсли;
	КонецЕсли;
	
	Ошибка = "";
	Если Не Ответ.Свойство("errorDetails", Ошибка) Тогда
		Ответ.Свойство("error", Ошибка);
	КонецЕсли;
	Сообщения = Новый Массив;
	Ответ.Свойство("messages", Сообщения);
	
	Запись = Новый Структура;
	Запись.Вставить("Идентификатор", ИдентификаторКоманды);
	Запись.Вставить("Время", ТекущаяДата());
	Запись.Вставить("Вид", Вид);
	Запись.Вставить("Клиентская", Клиентская);
	Запись.Вставить("Текст", ОднойСтрокой(ТекстКоманды, 300));
	Запись.Вставить("ПолныйТекст", НачалоТекста(ТекстКоманды));
	Запись.Вставить("Параметры", НачалоТекста(ТекстПараметров));
	Запись.Вставить("Статус", Ответ.status);
	Запись.Вставить("Итог", ОднойСтрокой(КраткийРезультат(Вид, Ответ), 300));
	Запись.Вставить("Длительность", Ответ.durationMs);
	Запись.Вставить("Результат", ПредставлениеРезультата(Ответ, ТекстОтвета));
	Запись.Вставить("Ошибка", НачалоТекста(Строка(Ошибка)));
	Запись.Вставить("Сообщения", ?(ТипЗнч(Сообщения) = Тип("Массив"), Сообщения, Новый Массив));
	Запись.Вставить("Выдача", "");
	Возврат Запись;
	
КонецФункции

&НаКлиенте
Функция ПолныйТекстКоманды(Команда)
	
	Для Каждого Ключ Из СтрРазделить("text,expression,code,path", ",") Цикл
		Текст = Команда.Получить(Ключ);
		Если ЗначениеЗаполнено(Текст) Тогда
			Возврат Строка(Текст);
		КонецЕсли;
	КонецЦикла;
	Отбор = Команда.Получить("filter");
	Если ЗначениеЗаполнено(Отбор) Тогда
		Возврат "Отбор: " + Отбор;
	КонецЕсли;
	Возврат "";
	
КонецФункции

&НаКлиенте
Функция КраткийРезультат(Вид, Ответ)
	
	Если Ответ.status <> "ok" Тогда
		Ошибка = "";
		Ответ.Свойство("error", Ошибка);
		Возврат ПерваяСтрока(Строка(Ошибка));
	КонецЕсли;
	
	Результат = Неопределено;
	Ответ.Свойство("result", Результат);
	Если Вид = "query" Тогда
		Возврат ИтогЗапроса(Результат);
	ИначеЕсли Вид = "ping" Тогда
		Возврат "связь есть";
	ИначеЕсли Вид = "metadata" И ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("collections") Тогда
		Количество = 0;
		Для Каждого Коллекция Из Результат.collections Цикл
			Количество = Количество + Коллекция.objects.Количество();
		КонецЦикла;
		Возврат "объектов: " + Формат(Количество, "ЧН=0; ЧГ=0");
	КонецЕсли;
	Возврат ПредставлениеЗначения(Результат);
	
КонецФункции

&НаКлиенте
Функция ИтогЗапроса(Результат)
	
	Если ТипЗнч(Результат) <> Тип("Структура") Или Не Результат.Свойство("results") Тогда
		Возврат "";
	КонецЕсли;
	Последний = Неопределено;
	Для Каждого Таблица Из Результат.results Цикл
		Если Таблица <> Неопределено Тогда
			Последний = Таблица;
		КонецЕсли;
	КонецЦикла;
	Если Последний = Неопределено Тогда
		Возврат "без результата";
	КонецЕсли;
	
	Строк = Формат(Последний.total, "ЧН=0; ЧГ=0");
	Если Результат.results.Количество() > 1 Тогда
		Возврат СтрШаблон("запросов: %1, в последнем строк: %2",
			Формат(Результат.results.Количество(), "ЧГ=0"), Строк);
	КонецЕсли;
	Возврат "строк: " + Строк;
	
КонецФункции

&НаКлиенте
Функция ПредставлениеЗначения(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	Если Значение = Неопределено Тогда
		Возврат "Неопределено";
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧН=0; ЧГ=0");
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат ?(Значение, "Истина", "Ложь");
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		Возврат "массив, элементов: " + Формат(Значение.Количество(), "ЧН=0; ЧГ=0");
	ИначеЕсли ТипЗначения = Тип("Структура") И Значение.Свойство("_presentation") Тогда
		Возврат Строка(Значение._presentation);
	ИначеЕсли ТипЗначения = Тип("Структура") И Значение.Свойство("rows") И Значение.Свойство("total") Тогда
		Возврат "таблица, строк: " + Формат(Значение.total, "ЧН=0; ЧГ=0");
	ИначеЕсли ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("Соответствие") Тогда
		Поля = Новый Массив;
		Для Каждого КлючИЗначение Из Значение Цикл
			Если Поля.Количество() = 6 Тогда
				Поля.Добавить("...");
				Прервать;
			КонецЕсли;
			Поля.Добавить(Строка(КлючИЗначение.Ключ) + ": " + КраткоеЗначение(КлючИЗначение.Значение));
		КонецЦикла;
		Возврат СтрСоединить(Поля, ", ");
	КонецЕсли;
	Возврат Строка(Значение);
	
КонецФункции

&НаКлиенте
Функция КраткоеЗначение(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Структура") И Значение.Свойство("_presentation") Тогда
		Возврат Лев(Строка(Значение._presentation), 40);
	ИначеЕсли ТипЗначения = Тип("Структура") И Значение.Свойство("rows") И Значение.Свойство("total") Тогда
		Возврат "таблица(" + Формат(Значение.total, "ЧН=0; ЧГ=0") + ")";
	ИначеЕсли ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("Соответствие") Тогда
		Возврат "{...}";
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		Возврат "[" + Формат(Значение.Количество(), "ЧН=0; ЧГ=0") + "]";
	КонецЕсли;
	Возврат Лев(ПредставлениеЗначения(Значение), 40);
	
КонецФункции

&НаКлиенте
Функция ПредставлениеРезультата(Ответ, ТекстОтвета)
	
	Результат = Неопределено;
	Если Не Ответ.Свойство("result", Результат) Тогда
		Возврат "";
	КонецЕсли;
	// Большой результат второй раз не форматируем: показываем начало ответа в том виде, как он ушёл агенту
	Если СтрДлина(ТекстОтвета) > ПределТекста() Тогда
		Возврат НачалоТекста(ТекстОтвета);
	КонецЕсли;
	Возврат ТекстJSON(Результат, Истина);
	
КонецФункции

&НаКлиенте
Функция НачалоТекста(Текст)
	
	Если СтрДлина(Текст) <= ПределТекста() Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Лев(Текст, ПределТекста()) + Символы.ПС + СтрШаблон("... показаны первые %1 символов из %2",
		Формат(ПределТекста(), "ЧГ=0"), Формат(СтрДлина(Текст), "ЧГ=0"));
	
КонецФункции

&НаКлиенте
Функция ОднойСтрокой(Текст, Длина)
	
	Результат = СтрЗаменить(СтрЗаменить(СтрЗаменить(Текст, Символы.ВК, ""), Символы.ПС, " "), Символы.Таб, " ");
	Возврат Лев(СокрЛП(Результат), Длина);
	
КонецФункции

&НаКлиенте
Функция ПерваяСтрока(Текст)
	
	Позиция = СтрНайти(Текст, Символы.ПС);
	Возврат ?(Позиция > 0, Лев(Текст, Позиция - 1), Текст);
	
КонецФункции

&НаКлиенте
Функция ПределТекста()
	
	Возврат 30000;
	
КонецФункции

#КонецОбласти

#Область Отрисовка

&НаКлиенте
Процедура Отрисовать()
	
	// Целиком страница рисуется при открытии формы; дальше блоки и строки журнала меняют функции JavaScript
	// страницы, поэтому развёрнутые строки и прокрутка при новых командах не сбрасываются
	ПанельHTML = ТекстСтраницы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьНовуюЗапись(Запись, ПрокрутитьВНачало)
	
	Попытка
		Окно = Элементы.ПанельHTML.Документ.defaultView;
		Окно.addEntry(ТекстЗаписи(Запись), ЗаписиЖурнала.Количество());
		ОбновитьБлокиОкна(Окно);
		Если ПрокрутитьВНачало Тогда
			Окно.scrollTo(0, 0);
		КонецЕсли;
	Исключение
		// Страница ещё не загрузилась: рисуем её заново целиком
		Отрисовать();
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьБлоки()
	
	Попытка
		ОбновитьБлокиОкна(Элементы.ПанельHTML.Документ.defaultView);
	Исключение
		// Страница ещё не загрузилась: рисуем её заново целиком
		Отрисовать();
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьБлокиОкна(Окно)
	
	Окно.setBlock("head", БлокШапки());
	Окно.setBlock("settings", БлокНастроек());
	Если ОжидающийОтвет = Неопределено Тогда
		Окно.setBlock("approval", "");
	Иначе
		Окно.setBlock("approval", БлокПодтверждения());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЗаписьНаСтранице(Запись)
	
	Попытка
		Окно = Элементы.ПанельHTML.Документ.defaultView;
		Окно.updateEntry("r-" + Запись.Идентификатор, ТекстЗаписи(Запись));
	Исключение
		// Страница ещё не загрузилась: рисуем её заново целиком
		Отрисовать();
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьЖурналНаСтранице()
	
	Попытка
		Элементы.ПанельHTML.Документ.defaultView.clearEntries();
	Исключение
		// Страница ещё не загрузилась: рисуем её заново целиком
		Отрисовать();
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Функция ТекстСтраницы()
	
	Части = Новый Массив;
	Части.Добавить("<!DOCTYPE html><html><head><meta charset=""utf-8"">");
	Части.Добавить("<style>" + СтилиСтраницы() + "</style>");
	Части.Добавить("<script>" + СкриптСтраницы() + "</script></head><body>");
	Части.Добавить("<div id=""head"">" + БлокШапки() + "</div>");
	Части.Добавить("<div id=""settings"">" + БлокНастроек() + "</div>");
	Части.Добавить("<div id=""approval"">");
	Если ОжидающийОтвет <> Неопределено Тогда
		Части.Добавить(БлокПодтверждения());
	КонецЕсли;
	Части.Добавить("</div>");
	Части.Добавить(БлокЖурнала());
	Части.Добавить("</body></html>");
	Возврат СтрСоединить(Части);
	
КонецФункции

&НаКлиенте
Функция БлокШапки()
	
	Если ЗначениеЗаполнено(ОшибкаМоста) Тогда
		Метка = ТекстМетки("Ошибка", "err");
		Пояснение = ОшибкаМоста;
	ИначеЕсли ОжидающийОтвет <> Неопределено Тогда
		Метка = ТекстМетки("Ждёт решения", "wait");
		Пояснение = "Результат команды ждёт вашего решения: отдать его агенту или нет.";
	ИначеЕсли Приостановлен Тогда
		Метка = ТекстМетки("Приостановлен", "off");
		Пояснение = "Команды агента ждут в очереди, пока вы не продолжите.";
	Иначе
		Метка = ТекстМетки("Готов", "ok");
		Пояснение = "Ждёт команд агента.";
	КонецЕсли;
	
	Части = Новый Массив;
	Части.Добавить("<div class=""card"">");
	Части.Добавить("<span class=""right"">");
	Части.Добавить(ТекстКнопки(?(Приостановлен, "Продолжить", "Приостановить"), "pause"));
	Части.Добавить(ТекстКнопки("Каталог обмена", "folder"));
	Части.Добавить("</span>");
	Части.Добавить(Метка + "<span class=""title"">Локальный мост MCP</span>");
	Части.Добавить("<div class=""line"">" + Экранированный(Пояснение) + "</div>");
	Части.Добавить("<div class=""line muted small"">");
	Части.Добавить(Экранированный(ПредставлениеБазы(ДанныеСеанса.infobase)) + " &middot; ");
	Части.Добавить(Экранированный(ДанныеСеанса.userFullName) + " &middot; сеанс моста ");
	Части.Добавить("<span class=""code"">" + Экранированный(ИдентификаторСеанса) + "</span> &middot; ");
	Части.Добавить("выполнено команд: " + Формат(ВыполненоКоманд, "ЧН=0; ЧГ=0") + "</div>");
	Части.Добавить("<div class=""clear""></div></div>");
	Возврат СтрСоединить(Части);
	
КонецФункции

&НаКлиенте
Функция БлокНастроек()
	
	Части = Новый Массив;
	Части.Добавить("<div class=""card"">");
	Части.Добавить("<div class=""line""><span class=""label"">Выдача результатов агенту</span><span class=""seg"">");
	Части.Добавить(ТекстСсылки("Автоматически", "mode-auto", ?(РучнаяВыдача, "", "on")));
	Части.Добавить(ТекстСсылки("С подтверждением", "mode-manual", ?(РучнаяВыдача, "on", "")));
	Части.Добавить("</span></div>");
	Части.Добавить("<div class=""hint"">С подтверждением каждый результат сначала показывается здесь ");
	Части.Добавить("и уходит агенту только после вашего решения.</div>");
	Части.Добавить("<div class=""line""><span class=""label"">Разрешения агенту</span>");
	Части.Добавить(ТекстСсылки("Запись в базу", "write", ?(РазрешитьЗапись, "sw on danger", "sw")));
	Части.Добавить(ТекстСсылки("Код на клиенте", "client", ?(РазрешитьКодНаКлиенте, "sw on", "sw")));
	Части.Добавить("</div>");
	Части.Добавить("<div class=""hint"">Пока запись в базу выключена, серверный код агента выполняется ");
	Части.Добавить("в транзакции с откатом, даже если агент просит запись. ");
	Части.Добавить("Код на клиенте выполняется в этой форме, без транзакции.</div>");
	Части.Добавить(БлокКаталогаОбмена());
	Части.Добавить("</div>");
	Возврат СтрСоединить(Части);
	
КонецФункции

&НаКлиенте
Функция БлокКаталогаОбмена()
	
	Каталог = КаталогОбмена();
	Части = Новый Массив;
	Части.Добавить("<div class=""line""><span class=""label"">Каталог обмена</span>");
	Части.Добавить("<span class=""code"">" + Экранированный(Каталог) + "</span>");
	Части.Добавить(ТекстКнопки("Изменить", "dir-change"));
	Если ЗначениеЗаполнено(СвойКаталогОбмена) Тогда
		Части.Добавить(ТекстКнопки("По умолчанию", "dir-default"));
	КонецЕсли;
	Части.Добавить("</div>");
	
	Если Не ЗначениеЗаполнено(СвойКаталогОбмена) Тогда
		Части.Добавить("<div class=""hint"">Стандартный каталог: здесь сеансы ищет MCP-сервер без настройки. ");
		Части.Добавить("Свой каталог запоминается для вашего пользователя в этой базе.</div>");
		Возврат СтрСоединить(Части);
	КонецЕсли;
	
	Части.Добавить("<div class=""hint attn""><b>Каталог не стандартный.</b> Агент увидит этот сеанс, ");
	Части.Добавить("только если MCP-серверу задан тот же каталог в переменной окружения ");
	Части.Добавить("<span class=""code"">MCP_1C_BRIDGE_DIR</span> - путём, под которым каталог виден ");
	Части.Добавить("MCP-серверу. Как её задать - в README моста.</div>");
	Возврат СтрСоединить(Части);
	
КонецФункции

&НаКлиенте
Функция БлокПодтверждения()
	
	Запись = ОжидающийОтвет.Запись;
	Части = Новый Массив;
	Части.Добавить("<div class=""card alert""><h3>Результат ждёт вашего решения</h3>");
	Части.Добавить(ТелоЗаписи(Запись));
	Части.Добавить("<div class=""line"">");
	Части.Добавить(ТекстСсылки("Отдать агенту", "approve", "btn primary"));
	Части.Добавить(ТекстСсылки("Не отдавать", "deny", "btn danger"));
	Части.Добавить("</div></div>");
	Возврат СтрСоединить(Части);
	
КонецФункции

&НаКлиенте
Функция БлокЖурнала()
	
	Части = Новый Массив;
	Части.Добавить("<div class=""card""><span class=""right"">" + ТекстКнопки("Очистить", "clear") + "</span>");
	Части.Добавить("<h3>Журнал команд <span class=""muted"">(<span id=""count"">");
	Части.Добавить(Формат(ЗаписиЖурнала.Количество(), "ЧН=0; ЧГ=0") + "</span>)</span></h3>");
	Части.Добавить("<div class=""row th""><span class=""c-pad""></span><span class=""c-time"">Время</span>");
	Части.Добавить("<span class=""c-kind"">Команда</span><span class=""c-text"">Текст</span>");
	Части.Добавить("<span class=""c-status"">Итог</span><span class=""c-res"">Результат</span>");
	Части.Добавить("<span class=""c-ms"">мс</span></div>");
	Части.Добавить(СтрШаблон("<div id=""empty"" class=""muted empty"" style=""display:%1"">",
		?(ЗаписиЖурнала.Количество() = 0, "block", "none")));
	Части.Добавить("Команд пока не было.</div><div id=""entries"">");
	Для Каждого Запись Из ЗаписиЖурнала Цикл
		Части.Добавить(ТекстЗаписи(Запись));
	КонецЦикла;
	Части.Добавить("</div></div>");
	Возврат СтрСоединить(Части);
	
КонецФункции

&НаКлиенте
Функция ТекстЗаписи(Запись)
	
	Части = Новый Массив;
	Части.Добавить("<details class=""entry"" id=""r-" + Экранированный(Запись.Идентификатор) + """>");
	Части.Добавить("<summary><div class=""row""><span class=""c-arrow""></span>");
	Части.Добавить("<span class=""c-time"">" + Формат(Запись.Время, "ДФ=ЧЧ:мм:сс") + "</span>");
	Части.Добавить("<span class=""c-kind"">" + Экранированный(ПредставлениеВида(Запись)) + "</span>");
	Части.Добавить(ПолеСПодсказкой(Запись.Текст, "c-text code"));
	Части.Добавить("<span class=""c-status"">" + МеткаСтатуса(Запись.Статус) + МеткаВыдачи(Запись.Выдача) + "</span>");
	Части.Добавить(ПолеСПодсказкой(Запись.Итог, "c-res"));
	Части.Добавить("<span class=""c-ms"">" + Формат(Запись.Длительность, "ЧН=0; ЧГ=0") + "</span>");
	Части.Добавить("</div></summary><div class=""body"">" + ТелоЗаписи(Запись) + "</div></details>");
	Возврат СтрСоединить(Части);
	
КонецФункции

&НаКлиенте
Функция ТелоЗаписи(Запись)
	
	Части = Новый Массив;
	Части.Добавить(СводкаЗаписи(Запись));
	Части.Добавить(РазделЗаписи("Текст команды", Запись.ПолныйТекст));
	Части.Добавить(РазделЗаписи("Параметры", Запись.Параметры));
	Части.Добавить(РазделЗаписи("Результат", Запись.Результат));
	Части.Добавить(РазделЗаписи("Сообщения", СтрСоединить(Запись.Сообщения, Символы.ПС)));
	Части.Добавить(РазделЗаписи("Ошибка", Запись.Ошибка));
	Возврат СтрСоединить(Части);
	
КонецФункции

&НаКлиенте
Функция СводкаЗаписи(Запись)
	
	Части = Новый Массив;
	Части.Добавить("<div class=""line muted small"">Команда <span class=""code"">");
	Части.Добавить(Экранированный(Запись.Идентификатор) + "</span> &middot; ");
	Части.Добавить(Экранированный(ПредставлениеВида(Запись)) + " &middot; ");
	Части.Добавить(Формат(Запись.Время, "ДФ=ЧЧ:мм:сс") + " &middot; ");
	Части.Добавить(Формат(Запись.Длительность, "ЧН=0; ЧГ=0") + " мс &middot; ");
	Части.Добавить(МеткаСтатуса(Запись.Статус) + МеткаВыдачи(Запись.Выдача) + "</div>");
	Возврат СтрСоединить(Части);
	
КонецФункции

&НаКлиенте
Функция РазделЗаписи(Заголовок, Текст)
	
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;
	Возврат "<div class=""sect"">" + Экранированный(Заголовок) + "</div><pre>" + Экранированный(Текст) + "</pre>";
	
КонецФункции

&НаКлиенте
Функция ПолеСПодсказкой(Текст, Класс)
	
	Возврат СтрШаблон("<span class=""%1"" title=""%2"">%2</span>", Класс, Экранированный(Текст));
	
КонецФункции

&НаКлиенте
Функция ПредставлениеВида(Запись)
	
	Возврат Запись.Вид + ?(Запись.Клиентская, ", клиент", "");
	
КонецФункции

&НаКлиенте
Функция МеткаСтатуса(Статус)
	
	Если Статус = "ok" Тогда
		Возврат ТекстМетки("выполнена", "ok");
	ИначеЕсли Статус = "error" Тогда
		Возврат ТекстМетки("ошибка", "err");
	ИначеЕсли Статус = "rejected" Тогда
		Возврат ТекстМетки("отказ", "warn");
	ИначеЕсли Статус = "expired" Тогда
		Возврат ТекстМетки("просрочена", "off");
	КонецЕсли;
	Возврат ТекстМетки(Статус, "off");
	
КонецФункции

&НаКлиенте
Функция МеткаВыдачи(Выдача)
	
	Если Выдача = "ждёт" Тогда
		Возврат " " + ТекстМетки("ждёт решения", "wait");
	ИначеЕсли Выдача = "отдано" Тогда
		Возврат "<span class=""tag"">отдано</span>";
	ИначеЕсли Выдача = "не отдано" Тогда
		Возврат " " + ТекстМетки("не отдано", "warn");
	КонецЕсли;
	Возврат "";
	
КонецФункции

&НаКлиенте
Функция ТекстМетки(Текст, Класс)
	
	Возврат СтрШаблон("<span class=""pill %1"">%2</span>", Класс, Экранированный(Текст));
	
КонецФункции

&НаКлиенте
Функция ТекстКнопки(Текст, Действие)
	
	Возврат ТекстСсылки(Текст, Действие, "btn");
	
КонецФункции

&НаКлиенте
Функция ТекстСсылки(Текст, Действие, Класс)
	
	Возврат СтрШаблон("<a class=""%1"" href=""#act:%2"">%3</a>", Класс, Действие, Экранированный(Текст));
	
КонецФункции

&НаКлиенте
Функция ПредставлениеБазы(СтрокаСоединения)
	
	Свойства = Новый Соответствие;
	Для Каждого Часть Из СтрРазделить(СтрокаСоединения, ";", Ложь) Цикл
		Позиция = СтрНайти(Часть, "=");
		Если Позиция > 0 Тогда
			Свойства.Вставить(НРег(Лев(Часть, Позиция - 1)), СтрЗаменить(Сред(Часть, Позиция + 1), """", ""));
		КонецЕсли;
	КонецЦикла;
	Если Свойства.Получить("ref") <> Неопределено Тогда
		Возврат СтрШаблон("%1 на %2", Свойства.Получить("ref"), Свойства.Получить("srvr"));
	ИначеЕсли Свойства.Получить("file") <> Неопределено Тогда
		Возврат Свойства.Получить("file");
	КонецЕсли;
	Возврат СтрокаСоединения;
	
КонецФункции

&НаКлиенте
Функция Экранированный(Текст)
	
	Результат = СтрЗаменить(Строка(Текст), "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Возврат СтрЗаменить(Результат, """", "&quot;");
	
КонецФункции

&НаКлиенте
Функция СкриптСтраницы()
	
	Возврат
	"function setBlock(id, html) {
	|	var block = document.getElementById(id);
	|	if (block) { block.innerHTML = html; }
	|}
	|function setCount(count) {
	|	document.getElementById('count').innerHTML = count;
	|	document.getElementById('empty').style.display = count > 0 ? 'none' : 'block';
	|}
	|function addEntry(html, count) {
	|	var box = document.getElementById('entries');
	|	box.insertAdjacentHTML('afterbegin', html);
	|	while (box.children.length > 50) { box.removeChild(box.lastElementChild); }
	|	setCount(count);
	|}
	|function updateEntry(id, html) {
	|	var old = document.getElementById(id);
	|	if (!old) { return; }
	|	var open = old.open;
	|	old.insertAdjacentHTML('afterend', html);
	|	old.parentNode.removeChild(old);
	|	if (open) { document.getElementById(id).open = true; }
	|}
	|function clearEntries() {
	|	document.getElementById('entries').innerHTML = '';
	|	setCount(0);
	|}";
	
КонецФункции

&НаКлиенте
Функция СтилиСтраницы()
	
	Возврат
	"body{font-family:'Segoe UI',Tahoma,Arial,sans-serif;font-size:13px;color:#1f2328;background:#f6f8fa;
	|margin:0;padding:10px 12px}
	|.card{background:#fff;border:1px solid #d0d7de;border-radius:8px;padding:10px 14px;margin-bottom:10px}
